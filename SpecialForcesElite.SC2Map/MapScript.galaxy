//--------------------------------------------------------------------------------------------------
// Inicializar Catálogo de Buffs
//--------------------------------------------------------------------------------------------------
void SFE_InitBuffCatalog () {
    int i;
    int p;
    int t;

    i = 0;
    while (i < c_TOTAL_BUFFS_COUNT) {
        g_sfeBuffCatalog[i].id = i;
        g_sfeBuffCatalog[i].tier = 0;
        g_sfeBuffCatalog[i].cost = 0;
        g_sfeBuffCatalog[i].name = "";
        g_sfeBuffCatalog[i].description = "";
        i = i + 1;
    }

    // Tier 1
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].tier = 1;
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].cost = 5000;
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].name = "Exoskeleton";
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].description = "+1.5 Vel. Movimiento, -50% Radio de Colision.";

    g_sfeBuffCatalog[c_BUFF_T1_HYPERACTIVITY].tier = 1;
