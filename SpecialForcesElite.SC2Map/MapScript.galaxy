//--------------------------------------------------------------------------------------------------
// Invocación Secreta 4: Hell Gate (NE - Gran Nydus)
//--------------------------------------------------------------------------------------------------
void SFE_TriggerHellGateIncursion () {
    point pSpawn;
    int k;
    unit u;
    order ord;
    int p;

    if (g_sfeBossHellGateTriggered) {
        return;
    }
    g_sfeBossHellGateTriggered = true;

    pSpawn = Point(160.0, 160.0);
    ord = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FF0000\">¡¡PORTAL DEL INFIERNO DESATADO!! ¡INCURSIÓN MASIVA DE ÉLITE EN EL SECTOR NE!</c></s>"));

    k = 0;
    while (k < 12) {
        UnitCreate(1, "Aberration", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
        UnitIssueOrder(u, ord, c_orderQueueReplace);
        k = k + 1;
    }

    k = 0;
    while (k < 6) {
        UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
        UnitIssueOrder(u, ord, c_orderQueueReplace);
        k = k + 1;
    }

    // Registrar logro Hell Gate en banco para todos los jugadores
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_BankAddExp(p, 500);
        }
        p = p + 1;
    }
}

