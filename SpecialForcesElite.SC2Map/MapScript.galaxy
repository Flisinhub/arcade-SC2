//--------------------------------------------------------------------------------------------------
// Invocación del Jefe 1: Híbrido Maar (Sector Central-Norte)
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossMaarSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossMaarSpawned) {
        return;
    }
    g_sfeBossMaarSpawned = true;
    g_sfeBossMaarPhase = 1;

    pSpawn = Point(115.0, 135.0);
    UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Archon", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
    }
    g_sfeBossMaarUnit = u;

    hp = 12000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 15.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF00FF\">¡ALERTA MAYOR! ¡EL HÍBRIDO MAAR HA DESPERTADO EN EL SECTOR CENTRAL-NORTE!</c></b>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest), c_orderQueueReplace);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueAddToEnd);
}

