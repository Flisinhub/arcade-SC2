    g_sfeBuffCatalog[c_BUFF_T1_OPTICAL_LENS].name = "Optical Lens";
    g_sfeBuffCatalog[c_BUFF_T1_OPTICAL_LENS].description = "+10 Vision, +12 Deteccion, Sigilo tras 2s sin danio.";

    // Tier 2
