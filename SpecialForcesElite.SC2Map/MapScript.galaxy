struct SFE_HeroDefinition {
    int id;
    string unitType;
    string fallbackUnitType;
    string name;
    string archetype;
    string description;
    int primaryAttribute;
    fixed baseHp;
    fixed baseShields;
    fixed baseEnergy;
    fixed baseArmor;
    fixed baseDamage;
    fixed baseAttackInterval;
    string portraitIcon;
};

SFE_HeroDefinition[c_HERO_TOTAL_COUNT] g_sfeHeroes;

struct SFE_HeroState {
    unit heroUnit;
    int heroId;
    bool isActive;
    int level;
    int currentXp;
    int requiredXp;
    int unspentAttributePoints;
    int strength;
    int dexterity;
    int intelligence;
    fixed currentMaxHp;
    fixed currentMaxShields;
    fixed currentMaxEnergy;
    fixed currentDamage;
    fixed currentAttackInterval;
    fixed currentLifeRegen;
    fixed currentEnergyRegen;
    fixed currentSightRadius;
};

SFE_HeroState[c_SFE_MAX_PLAYERS + 1] g_sfeHeroStates;

// Persistencia
const string c_BANK_NAME = "SpecialForcesElite5_Profile";
const string c_SEC_PROFILE = "Profile";
const string c_SEC_WINS = "DifficultyWins";
const string c_SEC_STATS = "Stats";
const string c_SEC_SECURITY = "Security";
const int c_SECURITY_SALT = 948271;

struct SFE_PlayerProfile {
    bank playerBank;
    bool bankLoaded;
    int accountLevel;
    int accountXP;
    int totalWins;
    int[c_DIFF_COUNT] difficultyWins;
    int bossesKilled;
    bool tormentMaster;
    bool secretUnlocked;
};

SFE_PlayerProfile[c_SFE_MAX_PLAYERS + 1] g_sfeProfiles;

// Variables Globales de Juego
int g_sfeCurrentDifficulty;
int g_sfeCurrentWaveNumber;
int g_sfeWaveTimeRemaining;
fixed g_sfeBaseCoreHpPercent;
point g_sfeBaseCenterPoint;
point g_sfeSpawnPoint;
unit g_sfeBaseCoreUnit;
bool g_sfeGameOverTriggered;

// Declaraciones Adelantadas (Prototypes)
void SFE_RecalculateStats (int player);
void SFE_HeroLevelUp (int player);
void SFE_BankSave (int player);
void SFE_BankAddExp (int player, int amount);
void SFE_UpdatePlayerHUD (int player);
void SFE_UpdateTopBarHUD ();
void SFE_TriggerBossMaarSpawn ();
void SFE_TriggerBossDestroyerSpawn ();
void SFE_TriggerBossDiabloSpawn ();
void SFE_TriggerDefeat ();
void SFE_TriggerVictory ();
void SFE_OrderHostilesToCore (unitgroup ug);

//--------------------------------------------------------------------------------------------------
// SECCIÓN 2: INICIALIZACIÓN DE TABLAS DE DATOS
//--------------------------------------------------------------------------------------------------
void SFE_InitDifficultyTables () {
    g_sfeDiffIncomeMultiplier[c_DIFF_CASUAL] = 1.5;
    g_sfeDiffIncomeMultiplier[c_DIFF_NORMAL] = 1.0;
    g_sfeDiffIncomeMultiplier[c_DIFF_HARD] = 0.75;
    g_sfeDiffIncomeMultiplier[c_DIFF_BRUTAL] = 0.50;
    g_sfeDiffIncomeMultiplier[c_DIFF_PRO] = 0.25;
    g_sfeDiffIncomeMultiplier[c_DIFF_IMPOSSIBLE] = 0.10;
    g_sfeDiffIncomeMultiplier[c_DIFF_TORMENT] = 0.05;

    g_sfeDiffHostileStatMultiplier[c_DIFF_CASUAL] = 0.5;
    g_sfeDiffHostileStatMultiplier[c_DIFF_NORMAL] = 1.0;
    g_sfeDiffHostileStatMultiplier[c_DIFF_HARD] = 2.0;
    g_sfeDiffHostileStatMultiplier[c_DIFF_BRUTAL] = 3.0;
    g_sfeDiffHostileStatMultiplier[c_DIFF_PRO] = 4.0;
    g_sfeDiffHostileStatMultiplier[c_DIFF_IMPOSSIBLE] = 5.0;
    g_sfeDiffHostileStatMultiplier[c_DIFF_TORMENT] = 7.0;

    g_sfeDiffWaveIntervalSeconds[c_DIFF_CASUAL] = 120.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_NORMAL] = 60.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_HARD] = 40.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_BRUTAL] = 30.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_PRO] = 20.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_IMPOSSIBLE] = 15.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_TORMENT] = 10.0;

    g_sfeDiffNames[c_DIFF_CASUAL] = "Casual";
    g_sfeDiffNames[c_DIFF_NORMAL] = "Normal";
    g_sfeDiffNames[c_DIFF_HARD] = "Hard";
    g_sfeDiffNames[c_DIFF_BRUTAL] = "Brutal";
    g_sfeDiffNames[c_DIFF_PRO] = "Pro";
    g_sfeDiffNames[c_DIFF_IMPOSSIBLE] = "Impossible";
    g_sfeDiffNames[c_DIFF_TORMENT] = "TORMENT";
}

