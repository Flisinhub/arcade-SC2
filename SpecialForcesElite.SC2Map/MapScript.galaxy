//--------------------------------------------------------------------------------------------------
// Habilidad de Jefe: Onda de Choque Zonal
//--------------------------------------------------------------------------------------------------
void SFE_BossCastShockwave (unit bossUnit, fixed radius, fixed damage) {
    point p;
    unitgroup ug;
    int count;
    int i;
    unit target;
    int owner;

    p = UnitGetPosition(bossUnit);
    ug = UnitGroup(null, c_playerAny, RegionCircle(p, radius), null, 0);
    count = UnitGroupCount(ug, c_unitCountAlive);
    i = 1;

    while (i <= count) {
        target = UnitGroupUnit(ug, i);
        owner = UnitGetOwner(target);
        if (owner >= 1 && owner <= c_SFE_MAX_PLAYERS || owner == c_SFE_PLAYER_ALLIED_BASE) {
            UnitDamage(bossUnit, "WeaponNull", target, damage);
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Habilidad de Jefe: Invocación de Esbirros de Soporte
//--------------------------------------------------------------------------------------------------
void SFE_BossSummonMinions (point p, string minionType, int count) {
    int i;
    unit u;
    unitgroup ug;

    i = 0;
    ug = UnitGroupEmpty();

    while (i < count) {
        UnitCreate(1, minionType, 0, c_SFE_PLAYER_HOSTILE, p, RandomFixed(0.0, 360.0));
        u = UnitLastCreated();
        UnitGroupAdd(ug, u);
        i = i + 1;
    }

    SFE_OrderHostilesToCore(ug);
}

//--------------------------------------------------------------------------------------------------
// Bucle de Chequeo Territorial de Invocaciones Secretas (cada 2s)
//--------------------------------------------------------------------------------------------------
void SFE_CheckTerritorialInvocations () {
    int p;
    int nwCount;
    int seCount;
    int centerCount;
    int neHeroesInZone;
    int swCount;
    int livingHeroesTotal;
    unit u;
    fixed d;

    nwCount = 0;
    seCount = 0;
    centerCount = 0;
    neHeroesInZone = 0;
    swCount = 0;
    livingHeroesTotal = 0;

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[p].isActive) {
            u = g_sfeHeroStates[p].heroUnit;
            if (u != null && UnitIsAlive(u)) {
                livingHeroesTotal = livingHeroesTotal + 1;

                // 1. NW (Destroyer of Worlds) - Point(40.0, 160.0)
                d = DistanceBetweenPoints(UnitGetPosition(u), Point(40.0, 160.0));
                if (d <= 12.0) {
                    nwCount = nwCount + 1;
                }

                // 2. SE (Híbridos Ancestrales) - Point(160.0, 40.0)
                d = DistanceBetweenPoints(UnitGetPosition(u), Point(160.0, 40.0));
                if (d <= 12.0) {
                    seCount = seCount + 1;
                }

                // 3. Centro (ChainDog) - Point(100.0, 125.0)
                d = DistanceBetweenPoints(UnitGetPosition(u), Point(100.0, 125.0));
                if (d <= 10.0) {
                    centerCount = centerCount + 1;
                }

                // 4. NE (Hell Gate) - Point(160.0, 160.0)
                d = DistanceBetweenPoints(UnitGetPosition(u), Point(160.0, 160.0));
                if (d <= 15.0) {
                    neHeroesInZone = neHeroesInZone + 1;
                }

                // 5. SW (Diablo en Torment) - Point(40.0, 40.0)
                d = DistanceBetweenPoints(UnitGetPosition(u), Point(40.0, 40.0));
                if (d <= 15.0) {
                    swCount = swCount + 1;
                }
            }
        }
        p = p + 1;
    }

    // Protocolo 1: NW Destroyer (exactamente 1 unidad aislada durante 120s)
    if (!g_sfeBossDestroyerSpawned) {
        if (nwCount == 1) {
            g_sfeTimerDestroyer = g_sfeTimerDestroyer + 2;
            if (g_sfeTimerDestroyer % 30 == 0) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
                    StringToText("<c val=\"FF8800\">[Nave Nodriza NW] Resonancia del Destructor: " + IntToString(g_sfeTimerDestroyer) + "s / 120s</c>"));
            }
            if (g_sfeTimerDestroyer >= 120) {
                SFE_TriggerBossDestroyerSpawn();
            }
        } else {
            g_sfeTimerDestroyer = 0;
        }
    }

    // Protocolo 2: SE Híbridos (exactamente 1 unidad durante 120s)
    if (!g_sfeBossHybridsSpawned) {
        if (seCount == 1) {
            g_sfeTimerHybrids = g_sfeTimerHybrids + 2;
            if (g_sfeTimerHybrids % 30 == 0) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
                    StringToText("<c val=\"CC00FF\">[Artefacto SE] Sincronización Xel'Naga: " + IntToString(g_sfeTimerHybrids) + "s / 120s</c>"));
            }
            if (g_sfeTimerHybrids >= 120) {
                SFE_TriggerBossHybridsSpawn();
            }
        } else {
            g_sfeTimerHybrids = 0;
        }
    }

    // Protocolo 3: Centro ChainDog (exactamente 1 unidad durante 120s)
    if (!g_sfeBossChainDogSpawned) {
        if (centerCount == 1) {
            g_sfeTimerChainDog = g_sfeTimerChainDog + 2;
            if (g_sfeTimerChainDog % 30 == 0) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
                    StringToText("<c val=\"FF4444\">[Estatua Central] Despertar de ChainDog: " + IntToString(g_sfeTimerChainDog) + "s / 120s</c>"));
            }
            if (g_sfeTimerChainDog >= 120) {
                SFE_TriggerBossChainDogSpawn();
            }
        } else {
            g_sfeTimerChainDog = 0;
        }
    }

    // Protocolo 4: NE Hell Gate (todos los héroes vivos juntos durante 10s)
    if (!g_sfeBossHellGateTriggered && livingHeroesTotal > 0) {
        if (neHeroesInZone == livingHeroesTotal) {
            g_sfeTimerHellGate = g_sfeTimerHellGate + 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
                StringToText("<c val=\"FF0000\">[Hell Gate NE] ¡Apertura inminente! " + IntToString(g_sfeTimerHellGate) + "s / 10s</c>"));
            if (g_sfeTimerHellGate >= 10) {
                SFE_TriggerHellGateIncursion();
            }
        } else {
            g_sfeTimerHellGate = 0;
        }
    }

    // Protocolo 5: SW Diablo (en dificultad Torment, presencia en la gasolinera por 20s)
    if (!g_sfeBossDiabloSpawned && g_sfeCurrentDifficulty == c_DIFF_TORMENT) {
        if (swCount >= 1) {
            g_sfeTimerDiablo = g_sfeTimerDiablo + 2;
            if (g_sfeTimerDiablo % 10 == 0) {
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
                    StringToText("<c val=\"FF0000\">[Torment SW] Presencia de Diablo incrementando: " + IntToString(g_sfeTimerDiablo) + "s / 20s</c>"));
            }
            if (g_sfeTimerDiablo >= 20) {
                SFE_TriggerBossDiabloSpawn();
            }
        } else {
            g_sfeTimerDiablo = 0;
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Bucle de Inteligencia Artificial y Fases de Jefes (Tick cada 2 segundos)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_BossAI_Loop_Func (bool testConds, bool runActions) {
    fixed hpPct;
    point bPos;

    if (!runActions) {
        return true;
    }

    // Chequear invocaciones territoriales secretas
    SFE_CheckTerritorialInvocations();

    // 1. Lógica Híbrido Maar
    if (g_sfeBossMaarSpawned && UnitIsAlive(g_sfeBossMaarUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossMaarUnit);

        if (hpPct <= 75.0 && g_sfeBossMaarPhase == 1) {
            g_sfeBossMaarPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar Fase 2: ¡Invocando Enjambre del Vacío!</c>"));
            SFE_BossSummonMinions(bPos, "Mutalisk", 8);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 8.0, 150.0);
        } else if (hpPct <= 50.0 && g_sfeBossMaarPhase == 2) {
            g_sfeBossMaarPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar Fase 3: ¡Onda Psiónica Devastadora!</c>"));
            SFE_BossSummonMinions(bPos, "Roach", 12);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 10.0, 250.0);
        } else if (hpPct <= 25.0 && g_sfeBossMaarPhase == 3) {
            g_sfeBossMaarPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar ¡ENFURECIDO!: Regeneración y Nova Crítica!</c>"));
            UnitSetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifeRegen, 60.0);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 12.0, 400.0);
        }
    }

    // 2. Lógica Destroyer of Worlds
    if (g_sfeBossDestroyerSpawned && UnitIsAlive(g_sfeBossDestroyerUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDestroyerUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDestroyerUnit);

        if (hpPct <= 75.0 && g_sfeBossDestroyerPhase == 1) {
            g_sfeBossDestroyerPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 2: ¡Impacto Sísmico!</c>"));
            SFE_BossSummonMinions(bPos, "Immortal", 4);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 9.0, 200.0);
        } else if (hpPct <= 50.0 && g_sfeBossDestroyerPhase == 2) {
            g_sfeBossDestroyerPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 3: ¡Bombardeo Masivo!</c>"));
            SFE_BossSummonMinions(bPos, "Colossus", 3);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 11.0, 350.0);
        } else if (hpPct <= 25.0 && g_sfeBossDestroyerPhase == 3) {
            g_sfeBossDestroyerPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds ¡SOBRECARGA NUCLEAR TOTAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 14.0, 500.0);
        }
    }

    // 3. Lógica ChainDog
    if (g_sfeBossChainDogSpawned && UnitIsAlive(g_sfeBossChainDogUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossChainDogUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossChainDogUnit);

        if (hpPct <= 50.0 && g_sfeBossChainDogPhase == 1) {
            g_sfeBossChainDogPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF2222\">ChainDog ¡Furia Salvaje! Velocidad y Hendidura Aumentadas!</c>"));
            SFE_BossCastShockwave(g_sfeBossChainDogUnit, 8.0, 180.0);
        }
    }

    // 4. Lógica Híbridos Ancestrales
    if (g_sfeBossHybridsSpawned && UnitIsAlive(g_sfeBossHybridsUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossHybridsUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossHybridsUnit);

        if (hpPct <= 50.0 && g_sfeBossHybridsPhase == 1) {
            g_sfeBossHybridsPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"CC00FF\">Híbridos Ancestrales ¡Drenaje Psiónico Masivo!</c>"));
            SFE_BossSummonMinions(bPos, "HighTemplar", 3);
            SFE_BossCastShockwave(g_sfeBossHybridsUnit, 9.0, 220.0);
        }
    }

    // 5. Lógica Diablo Final
    if (g_sfeBossDiabloSpawned && UnitIsAlive(g_sfeBossDiabloUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDiabloUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDiabloUnit);

        if (hpPct <= 75.0 && g_sfeBossDiabloPhase == 1) {
            g_sfeBossDiabloPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 2: ¡Llamas del Infierno!</c>"));
            SFE_BossSummonMinions(bPos, "Ultralisk", 4);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 10.0, 300.0);
        } else if (hpPct <= 50.0 && g_sfeBossDiabloPhase == 2) {
            g_sfeBossDiabloPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 3: ¡Tormenta de Almas!</c>"));
            SFE_BossSummonMinions(bPos, "HybridDestroyer", 3);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 12.0, 450.0);
        } else if (hpPct <= 25.0 && g_sfeBossDiabloPhase == 3) {
            g_sfeBossDiabloPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo ¡CATACLISMO FINAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 15.0, 700.0);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Muerte de Jefe y Registro de Victoria
//--------------------------------------------------------------------------------------------------
bool gt_SFE_BossDied_Func (bool testConds, bool runActions) {
    unit dyingU;
    int p;

    if (!runActions) {
        return true;
    }

    dyingU = EventUnit();
    p = 1;

    if (dyingU == g_sfeBossMaarUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡HÍBRIDO MAAR ELIMINADO! +2500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDestroyerUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡DESTROYER OF WORLDS ERRADICADO! +3500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 3500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossChainDogUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡CHAINDOG DERROTADO! +2000 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2000);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossHybridsUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡HÍBRIDOS ANCESTRALES PURGADOS! +2500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDiabloUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FFE400\">¡¡DIABLO HA SIDO DERROTADO EN TORMENT!! ¡HÉROE DIABLO DESBLOQUEADO!</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            SFE_BankRecordBossKill(p);
            // Si fue derrotado en Torment, desbloquearlo permanentemente
            if (g_sfeCurrentDifficulty == c_DIFF_TORMENT) {
                g_sfeProfiles[p].secretUnlocked = true;
                SFE_BankSave(p);
            }
            p = p + 1;
        }
        // Desencadenar la Victoria Absoluta
        SFE_TriggerVictory();
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Inicializar el Sistema de Jefes
//--------------------------------------------------------------------------------------------------
void SFE_InitBossSystem () {
    trigger tBossAI;
    trigger tBossDied;

    g_sfeBossMaarSpawned = false;
    g_sfeBossDestroyerSpawned = false;
    g_sfeBossDiabloSpawned = false;
    g_sfeBossChainDogSpawned = false;
    g_sfeBossHybridsSpawned = false;
    g_sfeBossHellGateTriggered = false;

    g_sfeTimerDestroyer = 0;
    g_sfeTimerHybrids = 0;
    g_sfeTimerChainDog = 0;
    g_sfeTimerHellGate = 0;
    g_sfeTimerDiablo = 0;

    // Timer recurrente de IA de jefes cada 2 segundos
    g_sfeBossAITimer = TimerCreate();
    TimerStart(g_sfeBossAITimer, 2.0, true, c_timeGame);
    tBossAI = TriggerCreate("gt_SFE_BossAI_Loop_Func");
    TriggerAddEventTimer(tBossAI, g_sfeBossAITimer);

    // Evento de muerte de unidad para jefes
    tBossDied = TriggerCreate("gt_SFE_BossDied_Func");
    TriggerAddEventUnitDied(tBossDied, null);
}

//==================================================================================================
// Special Forces Elite 5 - Game Loop & Orchestration Master
// Orquestador principal del ciclo de vida, selector de dificultad, inicialización y eventos
//==================================================================================================



// Diálogo de Selección de Dificultad (para el anfitrión - Jugador 1)
int g_sfeDiffDialog;
int[c_DIFF_COUNT] g_sfeDiffButtons;
bool g_sfeDifficultyChosen;

// Declaraciones
void SFE_StartGameAfterDifficulty (int chosenDiff);

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Daño de Héroes con Escalado de Fuerza
//--------------------------------------------------------------------------------------------------
bool gt_SFE_DamageHook_Func (bool testConds, bool runActions) {
    unit attacker;
    unit victim;
    int attackerPlayer;
    fixed strBonus;

    if (!runActions) {
        return true;
    }

    attacker = EventUnitDamageSourceUnit();
    victim = EventUnit();
    attackerPlayer = UnitGetOwner(attacker);

    if (attackerPlayer >= 1 && attackerPlayer <= c_SFE_MAX_PLAYERS && g_sfeHeroStates[attackerPlayer].isActive) {
        if (attacker == g_sfeHeroStates[attackerPlayer].heroUnit && UnitGetOwner(victim) == c_SFE_PLAYER_HOSTILE) {
            strBonus = g_sfeHeroStates[attackerPlayer].strength * c_FACTOR_ALPHA_STRENGTH_DAMAGE;
            if (strBonus > 0.0) {
                UnitDamage(attacker, "WeaponNull", victim, strBonus);
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Selección de Dificultad por el Anfitrión
//--------------------------------------------------------------------------------------------------
bool gt_SFE_DiffSelect_Click_Func (bool testConds, bool runActions) {
    int clicked;
    int d;

    if (!runActions || g_sfeDifficultyChosen) {
        return true;
    }

    clicked = EventDialogControl();
    d = 0;

    while (d < c_DIFF_COUNT) {
        if (clicked == g_sfeDiffButtons[d]) {
            g_sfeDifficultyChosen = true;
            DialogSetVisible(g_sfeDiffDialog, PlayerGroupAll(), false);
            SFE_StartGameAfterDifficulty(d);
            return true;
        }
        d = d + 1;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Iniciar Todo el Ecosistema Tras Fijar Dificultad
//--------------------------------------------------------------------------------------------------
void SFE_StartGameAfterDifficulty (int chosenDiff) {
    int p;
    int startingMinerals;
    trigger tWaveTick;
    trigger tReward;
    trigger tDamage;
    text diffNotice;

    g_sfeCurrentDifficulty = chosenDiff;

    diffNotice = StringToText("<s val=\"ModCenterSize22Bold\"><c val=\"FFE400\">DIFICULTAD ESTABLECIDA EN: </c><c val=\"00FFEA\">" + g_sfeDiffNames[chosenDiff] + "</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, diffNotice);

    // Calcular minerales iniciales según dificultad
    if (chosenDiff == c_DIFF_CASUAL) {
        startingMinerals = 800;
    } else if (chosenDiff == c_DIFF_NORMAL) {
        startingMinerals = 500;
    } else if (chosenDiff == c_DIFF_HARD) {
        startingMinerals = 350;
    } else if (chosenDiff == c_DIFF_BRUTAL) {
        startingMinerals = 200;
    } else if (chosenDiff == c_DIFF_PRO) {
        startingMinerals = 100;
    } else {
        startingMinerals = 0; // Torment
    }

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperSetTo, startingMinerals);
        }
        p = p + 1;
    }

    // Inicializar Base Aliada
    SFE_InitAlliedBase();

    // Inicializar HUD de Jugadores y Barra Superior
    SFE_InitHUD();

    // Inicializar Sistema de Oleadas
    SFE_InitWaveSpawner();

    // Inicializar Sistema de Jefes
    SFE_InitBossSystem();

    // Abrir Selector de Héroes
    SFE_InitHeroSelectionUI();

    // Disparador del bucle de oleadas cada 1 segundo
    g_sfeWaveTickTimer = TimerCreate();
    TimerStart(g_sfeWaveTickTimer, 1.0, true, c_timeGame);
    tWaveTick = TriggerCreate("gt_SFE_WaveLoop_Timer_Func");
    TriggerAddEventTimer(tWaveTick, g_sfeWaveTickTimer);

    // Disparador de recompensas de eliminación
    tReward = TriggerCreate("gt_SFE_UnitDied_Reward_Func");
    TriggerAddEventUnitDied(tReward, null);

    // Disparador de escalado de daño de Fuerza
    tDamage = TriggerCreate("gt_SFE_DamageHook_Func");
    TriggerAddEventUnitDamaged(tDamage, null);
}

//--------------------------------------------------------------------------------------------------
// Crear Selector de Dificultad Inicial
//--------------------------------------------------------------------------------------------------
void SFE_InitDifficultySelection () {
    trigger tClick;
    int d;
    int btnY;

    g_sfeDifficultyChosen = false;

    // Crear Diálogo de dificultad
    g_sfeDiffDialog = DialogCreate(540, 520, c_anchorCenter, 0, 0, true);
    DialogSetImage(g_sfeDiffDialog, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    // Título
    DialogControlCreate(g_sfeDiffDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), 500, 35);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTop, 0, 20);
    DialogControlSetPropertyAsText(DialogControlLastCreated(), c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"FFE400\">SELECCIONA LA DIFICULTAD</c></s>"));

    tClick = TriggerCreate("gt_SFE_DiffSelect_Click_Func");

    d = 0;
    while (d < c_DIFF_COUNT) {
        btnY = 70 + (d * 58);
        g_sfeDiffButtons[d] = DialogControlCreate(g_sfeDiffDialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeDiffButtons[d], PlayerGroupAll(), 460, 48);
        DialogControlSetPosition(g_sfeDiffButtons[d], PlayerGroupAll(), c_anchorTop, 0, btnY);
        
        DialogControlSetPropertyAsText(g_sfeDiffButtons[d], c_triggerControlPropertyText, PlayerGroupAll(), 
            StringToText("<s val=\"ModCenterSize16Bold\">" + g_sfeDiffNames[d] + "</s>"));

        TriggerAddEventDialogControl(tClick, 1, g_sfeDiffButtons[d], c_triggerControlEventTypeClick);
        d = d + 1;
    }

    // Visible para todos los jugadores
    DialogSetVisible(g_sfeDiffDialog, PlayerGroupAll(), true);
}

void SFE_SetupDiplomacyAndAlliances () {
    int p1;
    int p2;

    p1 = 1;
    while (p1 <= c_SFE_MAX_PLAYERS) {
        PlayerSetAlliance(p1, c_allianceIdPassive, c_SFE_PLAYER_ALLIED_BASE, true);
        PlayerSetAlliance(p1, c_allianceIdVision, c_SFE_PLAYER_ALLIED_BASE, true);
        PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, p1, true);
        PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, p1, true);

        PlayerSetAlliance(p1, c_allianceIdPassive, c_SFE_PLAYER_HOSTILE, false);
        PlayerSetAlliance(p1, c_allianceIdVision, c_SFE_PLAYER_HOSTILE, false);
        PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, p1, false);
        PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_allianceIdVision, p1, false);

        p2 = 1;
        while (p2 <= c_SFE_MAX_PLAYERS) {
            if (p1 != p2) {
                PlayerSetAlliance(p1, c_allianceIdPassive, p2, true);
                PlayerSetAlliance(p1, c_allianceIdVision, p2, true);
                PlayerSetAlliance(p1, c_allianceIdSeekHelp, p2, true);
            }
            p2 = p2 + 1;
        }
        p1 = p1 + 1;
    }

    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, c_SFE_PLAYER_HOSTILE, false);
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, c_SFE_PLAYER_HOSTILE, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, c_SFE_PLAYER_ALLIED_BASE, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_allianceIdVision, c_SFE_PLAYER_ALLIED_BASE, false);
}

//--------------------------------------------------------------------------------------------------
// Punto de Entrada Principal del Juego
//--------------------------------------------------------------------------------------------------
void SFE_MainInit () {
    int p;

    // Configurar Diplomacia y Visión Compartida
    SFE_SetupDiplomacyAndAlliances();

    // Inicializar Tablas y Catálogo
    SFE_InitDifficultyTables();
    SFE_InitHeroCatalog();

    // Inicializar Bancos Persistentes para cada jugador
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_BankInit(p);
        }
        p = p + 1;
    }

    // Desplegar Selector de Dificultad
    SFE_InitDifficultySelection();
}


//--------------------------------------------------------------------------------------------------
// Puntos de Entrada del Motor StarCraft II
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

void InitMap () {
    InitLibs();
    SFE_MainInit();
}
