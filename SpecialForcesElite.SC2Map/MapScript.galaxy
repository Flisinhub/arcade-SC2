//==================================================================================================
// Special Forces Elite 5 (SFE5) — StarCraft II Arcade
// FASE 1: NÚCLEO JUGABLE MÍNIMO (VERTICAL SLICE 1)
//==================================================================================================

// Constantes de Jugadores
const int c_SFE_PLAYER_USER        = 1;
const int c_SFE_PLAYER_ALLIED_BASE = 14;
const int c_SFE_PLAYER_HOSTILE     = 15;

// Variables Globales de Estado
unit  g_sfeHeroUnit;
unit  g_sfeCoreUnit;
point g_sfeBasePoint;
point g_sfeHeroSpawnPoint;
point g_sfeSpawnNorth;
point g_sfeSpawnSouth;
point g_sfeSpawnEast;
point g_sfeSpawnWest;

timer g_sfeWaveTimer;
int   g_sfeCurrentWave;
bool  g_sfeCoreAlive;

//--------------------------------------------------------------------------------------------------
// Inicialización de Diplomacia y Alianzas
//--------------------------------------------------------------------------------------------------
void SFE_SetupDiplomacy () {
    // Jugador 1 <-> Base Aliada (Amistosos y Visión mutua)
    PlayerSetAlliance(c_SFE_PLAYER_USER, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, true);
    PlayerSetAlliance(c_SFE_PLAYER_USER, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, true);
    PlayerSetAlliance(c_SFE_PLAYER_USER, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdSeekHelp, true);

    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_USER, c_allianceIdPassive, true);
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_USER, c_allianceIdVision, true);
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_USER, c_allianceIdSeekHelp, true);

    // Jugador 1 <-> Hostiles (Enemigos)
    PlayerSetAlliance(c_SFE_PLAYER_USER, c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_USER, c_SFE_PLAYER_HOSTILE, c_allianceIdVision, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_USER, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_USER, c_allianceIdVision, false);

    // Base Aliada <-> Hostiles (Enemigos)
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_HOSTILE, c_allianceIdVision, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, false);
}

//--------------------------------------------------------------------------------------------------
// Creación de la Base Aliada y Defensas Centrales
//--------------------------------------------------------------------------------------------------
void SFE_SpawnBaseAndDefenses () {
    unit uTurret;

    // Núcleo: Fortaleza Planetaria
    UnitCreate(1, "PlanetaryFortress", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBasePoint, 270.0);
    g_sfeCoreUnit = UnitLastCreated();
    if (g_sfeCoreUnit == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBasePoint, 270.0);
        g_sfeCoreUnit = UnitLastCreated();
    }
    UnitSetPropertyFixed(g_sfeCoreUnit, c_unitPropLifeMax, 5000.0);
    UnitSetPropertyFixed(g_sfeCoreUnit, c_unitPropLifePercent, 100.0);
    g_sfeCoreAlive = true;

    // Torretas de Misiles Perimetrales (Norte, Sur, Este, Oeste)
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(100.0, 112.0), 270.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(100.0, 88.0), 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(112.0, 100.0), 180.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(88.0, 100.0), 0.0);
}

//--------------------------------------------------------------------------------------------------
// Despliegue del Héroe: Marine de Élite
//--------------------------------------------------------------------------------------------------
void SFE_SpawnHeroMarine () {
    UnitCreate(1, "Marine", 0, c_SFE_PLAYER_USER, g_sfeHeroSpawnPoint, 90.0);
    g_sfeHeroUnit = UnitLastCreated();

    // Estadísticas de Héroe Élite para resistir el asedio inicial
    UnitSetPropertyFixed(g_sfeHeroUnit, c_unitPropLifeMax, 600.0);
    UnitSetPropertyFixed(g_sfeHeroUnit, c_unitPropLifePercent, 100.0);

    // Centrar cámara en el héroe y seleccionarlo inmediatamente
    CameraPan(c_SFE_PLAYER_USER, g_sfeHeroSpawnPoint, 0.4, -1, 10.0, false);
    UnitSelect(g_sfeHeroUnit, c_SFE_PLAYER_USER, true);

    // Recursos iniciales para pruebas
    PlayerModifyPropertyInt(c_SFE_PLAYER_USER, c_playerPropMinerals, c_playerPropOperSetTo, 500);
}

//--------------------------------------------------------------------------------------------------
// Generador de Oleadas Hostiles
//--------------------------------------------------------------------------------------------------
void SFE_SpawnWaveGroup (string unitType, int count, point spawnPt) {
    int i;
    unit u;
    order ordAttack;

    i = 0;
    ordAttack = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBasePoint);

    while (i < count) {
        UnitCreate(1, unitType, 0, c_SFE_PLAYER_HOSTILE, spawnPt, 270.0);
        u = UnitLastCreated();
        if (u != null) {
            UnitIssueOrder(u, ordAttack, c_orderQueueReplace);
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Callback del Temporizador: Ejecución Periódica de Oleadas
//--------------------------------------------------------------------------------------------------
bool gt_SFE_WaveTimer_Func (bool testConds, bool runActions) {
    text waveMsg;

    if (!runActions || !g_sfeCoreAlive) {
        return true;
    }

    g_sfeCurrentWave = g_sfeCurrentWave + 1;

    if (g_sfeCurrentWave == 1) {
        waveMsg = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF4444\">¡ALERTA OLEADA 1! Enjambre Zerg atacando desde el Norte.</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, waveMsg);
        SFE_SpawnWaveGroup("Zergling", 8, g_sfeSpawnNorth);
        TimerStart(g_sfeWaveTimer, 30.0, true, c_timeGame);
    } else if (g_sfeCurrentWave == 2) {
        waveMsg = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF4444\">¡ALERTA OLEADA 2! Cucarachas acorazadas desde el Este.</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, waveMsg);
        SFE_SpawnWaveGroup("Roach", 6, g_sfeSpawnEast);
    } else if (g_sfeCurrentWave == 3) {
        waveMsg = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF4444\">¡ALERTA OLEADA 3! Espinas de Hidralisco desde el Oeste.</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, waveMsg);
        SFE_SpawnWaveGroup("Hydralisk", 8, g_sfeSpawnWest);
    } else if (g_sfeCurrentWave == 4) {
        waveMsg = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF4444\">¡ALERTA OLEADA 4! Ataque combinado desde el Sur.</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, waveMsg);
        SFE_SpawnWaveGroup("Zergling", 10, g_sfeSpawnSouth);
        SFE_SpawnWaveGroup("Roach", 4, g_sfeSpawnSouth);
    } else {
        waveMsg = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF2222\">¡ASALTO PESADO OLEADA " + IntToString(g_sfeCurrentWave) + "! Ultraliscos y escolta desde el Norte.</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, waveMsg);
        SFE_SpawnWaveGroup("Ultralisk", 2, g_sfeSpawnNorth);
        SFE_SpawnWaveGroup("Zergling", 10, g_sfeSpawnNorth);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: Muerte de Unidades (Recompensa de Minerales y Chequeo de Núcleo)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_UnitDied_Func (bool testConds, bool runActions) {
    unit deadUnit;
    unit killerUnit;
    int deadOwner;
    int killerOwner;
    text bountyText;

    if (!runActions) {
        return true;
    }

    deadUnit = EventUnit();
    killerUnit = EventUnitDamageSourceUnit();
    deadOwner = UnitGetOwner(deadUnit);
    killerOwner = UnitGetOwner(killerUnit);

    // ¿Cayó el Núcleo Aliado? -> Derrota
    if (deadUnit == g_sfeCoreUnit) {
        g_sfeCoreAlive = false;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"FF0000\">¡EL NÚCLEO ALIADO HA SIDO DESTRUIDO! MISIÓN FALLIDA.</c></s>"));
        GameOver(c_SFE_PLAYER_USER, c_gameOverDefeat, true, true);
        return true;
    }

    // ¿Murió un enemigo a manos del Jugador 1? -> Recompensa de Minerales
    if (deadOwner == c_SFE_PLAYER_HOSTILE && killerOwner == c_SFE_PLAYER_USER) {
        PlayerModifyPropertyInt(c_SFE_PLAYER_USER, c_playerPropMinerals, c_playerPropOperAdd, 25);
        bountyText = StringToText("<c val=\"55FF55\">+25 Minerales</c>");
        UIDisplayMessage(PlayerGroupSingle(c_SFE_PLAYER_USER), c_messageAreaSubtitle, bountyText);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Inicialización Principal de Fase 1
//--------------------------------------------------------------------------------------------------
void SFE_Phase1_Init () {
    trigger tWave;
    trigger tDeath;

    // Coordenadas del Mapa (200x200)
    g_sfeBasePoint      = Point(100.0, 100.0);
    g_sfeHeroSpawnPoint = Point(100.0, 95.0);
    g_sfeSpawnNorth     = Point(100.0, 165.0);
    g_sfeSpawnSouth     = Point(100.0, 35.0);
    g_sfeSpawnEast      = Point(165.0, 100.0);
    g_sfeSpawnWest      = Point(35.0, 100.0);

    g_sfeCurrentWave    = 0;
    g_sfeCoreAlive      = false;

    // Configuración diplomática
    SFE_SetupDiplomacy();

    // Despliegue de entidades principales
    SFE_SpawnBaseAndDefenses();
    SFE_SpawnHeroMarine();

    // Mensajes de bienvenida y estado
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize22Bold\"><c val=\"FFE400\">SPECIAL FORCES ELITE 5 (SFE5)</c></s>"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<c val=\"00FFEA\">[FASE 1 ACTIVA] Núcleo Jugable Inicial</c>"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<c val=\"FFFFFF\">Héroe: Marine de Élite. Defiende la Fortaleza Planetaria de las oleadas Zerg.</c>"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<c val=\"AAAAAA\">La primera oleada atacará en 5 segundos. ¡Prepárate!</c>"));

    // Temporizador de oleadas: Oleada 1 a los 5 segundos, luego cada 30 segundos
    g_sfeWaveTimer = TimerCreate();
    TimerStart(g_sfeWaveTimer, 5.0, false, c_timeGame);

    tWave = TriggerCreate("gt_SFE_WaveTimer_Func");
    TriggerAddEventTimer(tWave, g_sfeWaveTimer);

    // Disparador de muertes y recompensas
    tDeath = TriggerCreate("gt_SFE_UnitDied_Func");
    TriggerAddEventUnitDied(tDeath, null);
}

//--------------------------------------------------------------------------------------------------
// Puntos de Entrada del Motor SC2
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

void InitMap () {
    InitLibs();
    SFE_Phase1_Init();
}
