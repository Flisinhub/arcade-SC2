        StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FF5555\">Tiempo restante para elegir:</c> 45s</s>"));

    i = 0;
    while (i < 16) {
        col = i % 4;
        row = i / 4;
        btnX = 40 + (col * 140);
        btnY = 120 + (row * 125);

        g_sfeHeroButtons[i] = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHeroButtons[i], PlayerGroupAll(), 130, 115);
        DialogControlSetPosition(g_sfeHeroButtons[i], PlayerGroupAll(), c_anchorTopLeft, btnX, btnY);
        DialogControlSetPropertyAsText(g_sfeHeroButtons[i], c_triggerControlPropertyText, PlayerGroupAll(), 
            StringToText("<s val=\"ModCenterSize14Bold\">" + g_sfeHeroes[i].name + "</s>"));

        i = i + 1;
    }

    g_sfePreviewName = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewName, PlayerGroupAll(), 480, 40);
    DialogControlSetPosition(g_sfePreviewName, PlayerGroupAll(), c_anchorTopLeft, 630, 120);

    g_sfePreviewArchetype = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewArchetype, PlayerGroupAll(), 480, 35);
    DialogControlSetPosition(g_sfePreviewArchetype, PlayerGroupAll(), c_anchorTopLeft, 630, 165);

    g_sfePreviewDesc = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewDesc, PlayerGroupAll(), 480, 80);
    DialogControlSetPosition(g_sfePreviewDesc, PlayerGroupAll(), c_anchorTopLeft, 630, 205);

    g_sfePreviewStats = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewStats, PlayerGroupAll(), 480, 120);
    DialogControlSetPosition(g_sfePreviewStats, PlayerGroupAll(), c_anchorTopLeft, 630, 300);

    g_sfeBtnConfirm = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeBtnConfirm, PlayerGroupAll(), 230, 55);
    DialogControlSetPosition(g_sfeBtnConfirm, PlayerGroupAll(), c_anchorTopLeft, 630, 460);
    DialogControlSetPropertyAsText(g_sfeBtnConfirm, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"55FF55\">CONFIRMAR</c></s>"));

    g_sfeBtnRandom = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeBtnRandom, PlayerGroupAll(), 230, 55);
    DialogControlSetPosition(g_sfeBtnRandom, PlayerGroupAll(), c_anchorTopLeft, 880, 460);
    DialogControlSetPropertyAsText(g_sfeBtnRandom, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<s val=\"ModCenterSize18Bold\"><c val=\"FFAA00\">ALEATORIO (1%)</c></s>"));

    tClick = TriggerCreate("gt_SFE_HeroSelection_Click_Func");
    i = 0;
    while (i < 16) {
        TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeHeroButtons[i], c_triggerControlEventTypeClick);
        i = i + 1;
    }
    TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeBtnConfirm, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeBtnRandom, c_triggerControlEventTypeClick);

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        g_sfePlayerSelectedHeroId[p] = c_HERO_RAYNOR;
        g_sfePlayerHasConfirmed[p] = false;
        SFE_UpdateHeroPreview(p, c_HERO_RAYNOR);
        p = p + 1;
    }

    DialogSetVisible(g_sfeSelectDialog, PlayerGroupAll(), true);

    g_sfeSelectCountdownTimer = TimerCreate();
    TimerStart(g_sfeSelectCountdownTimer, 1.0, true, c_timeGame);
    tTimer = TriggerCreate("gt_SFE_HeroSelection_Timer_Func");
    TriggerAddEventTimer(tTimer, g_sfeSelectCountdownTimer);
}

//--------------------------------------------------------------------------------------------------
// SECCIÓN 7: BASE ALIADA Y CONDICIONES DE VICTORIA/DERROTA
//--------------------------------------------------------------------------------------------------
void SFE_InitAlliedBase () {
    point pCore;
    point pDefense;
    unit u;

    g_sfeBaseCenterPoint = Point(100.0, 100.0);
    g_sfeGameOverTriggered = false;
    g_sfeBaseCoreHpPercent = 100.0;

    UnitCreate(1, "PlanetaryFortress", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 270.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 270.0);
        u = UnitLastCreated();
    }
    g_sfeBaseCoreUnit = u;
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeMax, 8000.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeRegen, 5.0);

    // Norte
    pDefense = Point(100.0, 115.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 270.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(94.0, 115.0), 270.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(106.0, 115.0), 270.0);

    // Sur
    pDefense = Point(100.0, 85.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(94.0, 85.0), 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(106.0, 85.0), 90.0);

    // Este
    pDefense = Point(115.0, 100.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 180.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(115.0, 94.0), 180.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(115.0, 106.0), 180.0);

    // Oeste
    pDefense = Point(85.0, 100.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(85.0, 94.0), 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(85.0, 106.0), 0.0);
}

void SFE_UpdateBaseHealthStatus () {
    fixed currentHp;

    if (g_sfeGameOverTriggered) {
        return;
    }

    if (!UnitIsAlive(g_sfeBaseCoreUnit)) {
        SFE_TriggerDefeat();
        return;
    }

    currentHp = UnitGetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, true);
    g_sfeBaseCoreHpPercent = currentHp;

    if (currentHp <= 0.0) {
        SFE_TriggerDefeat();
    }
}

void SFE_TriggerDefeat () {
    int p = 1;
    text defText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    defText = StringToText("<s val=\"ModCenterSize36Bold\"><c val=\"FF0000\">¡EL CUARTEL GENERAL HA SIDO DESTRUIDO!\nMISIÓN FALLIDA — DERROTA</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, defText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            GameOver(p, c_gameOverDefeat, true, true);
        }
        p = p + 1;
    }
}

void SFE_TriggerVictory () {
    int p = 1;
    text vicText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    vicText = StringToText("<s val=\"ModCenterSize36Bold\"><c val=\"00FF7F\">¡¡VICTORIA SUPREMA EN SPECIAL FORCES ELITE 5!!\nTODAS LAS HORDAS Y JEFES HAN SIDO ERRADICADOS</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, vicText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_BankRecordVictory(p, g_sfeCurrentDifficulty);
            GameOver(p, c_gameOverVictory, true, true);
        }
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// SECCIÓN 8: SISTEMA DE 25 OLEADAS Y ASENTAMIENTOS ENEMIGOS
//--------------------------------------------------------------------------------------------------
const int c_TOTAL_WAVES = 25;
unit g_sfeOutpostNorth;
unit g_sfeOutpostEast;
unit g_sfeOutpostWest;
bool g_sfeOutpostNorthAlive;
bool g_sfeOutpostEastAlive;
bool g_sfeOutpostWestAlive;
point g_sfeSpawnNorth;
point g_sfeSpawnSouth;
point g_sfeSpawnEast;
point g_sfeSpawnWest;
timer g_sfeWaveTickTimer;

void SFE_InitWaveSpawner () {
    g_sfeSpawnNorth = Point(100.0, 185.0);
    g_sfeSpawnSouth = Point(100.0, 15.0);
    g_sfeSpawnEast  = Point(185.0, 100.0);
    g_sfeSpawnWest  = Point(15.0, 100.0);

    g_sfeCurrentWaveNumber = 1;
    g_sfeWaveTimeRemaining = FixedToInt(g_sfeDiffWaveIntervalSeconds[g_sfeCurrentDifficulty]);

    UnitCreate(1, "Hive", 0, c_SFE_PLAYER_HOSTILE, Point(100.0, 160.0), 270.0);
    g_sfeOutpostNorth = UnitLastCreated();
    UnitSetPropertyFixed(g_sfeOutpostNorth, c_unitPropLifeMax, 4000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostNorth, c_unitPropLifePercent, 100.0);
    g_sfeOutpostNorthAlive = true;

    UnitCreate(1, "Nexus", 0, c_SFE_PLAYER_HOSTILE, Point(160.0, 100.0), 180.0);
    g_sfeOutpostEast = UnitLastCreated();
    UnitSetPropertyFixed(g_sfeOutpostEast, c_unitPropLifeMax, 4000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostEast, c_unitPropLifePercent, 100.0);
    g_sfeOutpostEastAlive = true;

    UnitCreate(1, "InfestedCommandCenter", 0, c_SFE_PLAYER_HOSTILE, Point(40.0, 100.0), 0.0);
    g_sfeOutpostWest = UnitLastCreated();
    if (g_sfeOutpostWest == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_HOSTILE, Point(40.0, 100.0), 0.0);
        g_sfeOutpostWest = UnitLastCreated();
    }
    UnitSetPropertyFixed(g_sfeOutpostWest, c_unitPropLifeMax, 4000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostWest, c_unitPropLifePercent, 100.0);
    g_sfeOutpostWestAlive = true;
}

void SFE_OrderHostilesToCore (unitgroup ug) {
    int i;
    int count;
    unit u;
    order ord;

    i = 1;
    count = UnitGroupCount(ug, c_unitCountAlive);
    ord = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint);

    while (i <= count) {
        u = UnitGroupUnit(ug, i);
        UnitIssueOrder(u, ord, c_orderQueueReplace);
        i = i + 1;
    }
}

void SFE_SpawnWave (int waveNum) {
    unitgroup ug;
    fixed statMult;
    int countNorth;
    int countSouth;
    int countEast;
    int countWest;
    string uType1;
    string uType2;
    int k;
    unit u;

    ug = UnitGroupEmpty();
    statMult = g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    countNorth = 4 + (waveNum * 2);
    countSouth = 4 + (waveNum * 2);
    countEast  = 4 + (waveNum * 2);
    countWest  = 4 + (waveNum * 2);

    if (waveNum <= 5) {
        uType1 = "Zergling";
        uType2 = "Roach";
    } else if (waveNum <= 10) {
        uType1 = "Hydralisk";
        uType2 = "Marauder";
    } else if (waveNum <= 15) {
        uType1 = "Ultralisk";
        uType2 = "Immortal";
    } else if (waveNum <= 20) {
        uType1 = "Thor";
        uType2 = "Colossus";
    } else {
        uType1 = "HybridDestroyer";
        uType2 = "Aberration";
    }

    k = 0;
    while (k < countNorth) {
        UnitCreate(1, uType1, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnNorth, 270.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ug, u);
        k = k + 1;
    }

    k = 0;
    while (k < countSouth) {
        UnitCreate(1, uType2, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnSouth, 90.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ug, u);
        k = k + 1;
    }

    k = 0;
    while (k < countEast) {
        UnitCreate(1, uType1, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnEast, 180.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ug, u);
        k = k + 1;
    }

    k = 0;
    while (k < countWest) {
        UnitCreate(1, uType2, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnWest, 0.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ug, u);
        k = k + 1;
    }

    SFE_OrderHostilesToCore(ug);

    if (waveNum == 10) {
        SFE_TriggerBossMaarSpawn();
    } else if (waveNum == 20) {
        SFE_TriggerBossDestroyerSpawn();
    } else if (waveNum == 25) {
        SFE_TriggerBossDiabloSpawn();
    }
}

void SFE_CheckOutpostStatus () {
    int p;
    text bountyText;

    if (g_sfeOutpostNorthAlive && !UnitIsAlive(g_sfeOutpostNorth)) {
        g_sfeOutpostNorthAlive = false;
        bountyText = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FFE400\">¡COLMENA ZERG NORTE DESTRUIDA! +1000 MINERALES PARA EL EQUIPO</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossMaarSpawn();
    }

    if (g_sfeOutpostEastAlive && !UnitIsAlive(g_sfeOutpostEast)) {
        g_sfeOutpostEastAlive = false;
        bountyText = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FFE400\">¡FORTALEZA PROTOSS ESTE DESTRUIDA! +1000 MINERALES PARA EL EQUIPO</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossDestroyerSpawn();
    }

    if (g_sfeOutpostWestAlive && !UnitIsAlive(g_sfeOutpostWest)) {
        g_sfeOutpostWestAlive = false;
        bountyText = StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FFE400\">¡COMPLEJO INFESTADO OESTE DESTRUIDO! +1000 MINERALES PARA EL EQUIPO</c></s>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossDiabloSpawn();
    }
}

bool gt_SFE_WaveLoop_Timer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    g_sfeWaveTimeRemaining = g_sfeWaveTimeRemaining - 1;

    SFE_UpdateBaseHealthStatus();
    SFE_CheckOutpostStatus();
    SFE_UpdateTopBarHUD();

    if (g_sfeWaveTimeRemaining <= 0) {
        SFE_SpawnWave(g_sfeCurrentWaveNumber);

        g_sfeCurrentWaveNumber = g_sfeCurrentWaveNumber + 1;
        if (g_sfeCurrentWaveNumber > c_TOTAL_WAVES) {
            g_sfeCurrentWaveNumber = c_TOTAL_WAVES;
        }

        g_sfeWaveTimeRemaining = FixedToInt(g_sfeDiffWaveIntervalSeconds[g_sfeCurrentDifficulty]);
    }

    return true;
}

bool gt_SFE_UnitDied_Reward_Func (bool testConds, bool runActions) {
    unit dyingU = EventUnit();
    unit killerU = EventUnitDamageSourceUnit();
    int killerPlayer;
    int bounty;

    if (!runActions) {
        return true;
    }

    if (UnitGetOwner(dyingU) != c_SFE_PLAYER_HOSTILE) {
        return true;
    }

    killerPlayer = UnitGetOwner(killerU);
    if (killerPlayer >= 1 && killerPlayer <= c_SFE_MAX_PLAYERS) {
        bounty = FixedToInt(15.0 * g_sfeDiffIncomeMultiplier[g_sfeCurrentDifficulty]);
        if (bounty < 5) {
            bounty = 5;
        }

        PlayerModifyPropertyInt(killerPlayer, c_playerPropMinerals, c_playerPropOperAdd, bounty);
        SFE_HeroAddExperience(killerPlayer, 25);
        SFE_UpdatePlayerHUD(killerPlayer);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// SECCIÓN 9: SISTEMA DE JEFES MONUMENTALES (MAAR, DESTROYER, DIABLO)
//--------------------------------------------------------------------------------------------------
unit g_sfeBossMaarUnit;
unit g_sfeBossDestroyerUnit;
unit g_sfeBossDiabloUnit;

bool g_sfeBossMaarSpawned;
bool g_sfeBossDestroyerSpawned;
bool g_sfeBossDiabloSpawned;

int g_sfeBossMaarPhase;
int g_sfeBossDestroyerPhase;
int g_sfeBossDiabloPhase;

timer g_sfeBossAITimer;

void SFE_BossCastShockwave (unit bossUnit, fixed radius, fixed damage) {
    point p;
    unitgroup ug;
    int count;
    int i;
    unit target;
    int owner;

    p = UnitGetPosition(bossUnit);
    ug = UnitGroup(null, c_playerAny, RegionCircle(p, radius), null, 0);
    count = UnitGroupCount(ug, c_unitCountAlive);
    i = 1;

    while (i <= count) {
        target = UnitGroupUnit(ug, i);
        owner = UnitGetOwner(target);
        if (owner >= 1 && owner <= c_SFE_MAX_PLAYERS || owner == c_SFE_PLAYER_ALLIED_BASE) {
            UnitDamage(bossUnit, "WeaponNull", target, damage);
        }
        i = i + 1;
    }
}

void SFE_BossSummonMinions (point p, string minionType, int count) {
    int i;
    unit u;
    unitgroup ug;

    i = 0;
    ug = UnitGroupEmpty();

    while (i < count) {
        UnitCreate(1, minionType, 0, c_SFE_PLAYER_HOSTILE, p, RandomFixed(0.0, 360.0));
        u = UnitLastCreated();
        UnitGroupAdd(ug, u);
        i = i + 1;
    }

    SFE_OrderHostilesToCore(ug);
}

void SFE_TriggerBossMaarSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossMaarSpawned) {
        return;
    }
    g_sfeBossMaarSpawned = true;
    g_sfeBossMaarPhase = 1;

    pSpawn = Point(100.0, 150.0);
    UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 270.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Archon", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 270.0);
        u = UnitLastCreated();
    }
    g_sfeBossMaarUnit = u;

    hp = 12000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 15.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize26Bold\"><c val=\"FF00FF\">¡ALERTA MAYOR! ¡EL HÍBRIDO MAAR HA DESPERTADO EN EL SECTOR NORTE!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

void SFE_TriggerBossDestroyerSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossDestroyerSpawned) {
        return;
    }
    g_sfeBossDestroyerSpawned = true;
    g_sfeBossDestroyerPhase = 1;

    pSpawn = Point(150.0, 100.0);
    UnitCreate(1, "HybridReaver", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 180.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Colossus", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 180.0);
        u = UnitLastCreated();
    }
    g_sfeBossDestroyerUnit = u;

    hp = 22000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 25.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize26Bold\"><c val=\"FF4400\">¡ALERTA APOCALÍPTICA! ¡EL DESTROYER OF WORLDS HA DESCENDIDO EN EL SECTOR ESTE!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

void SFE_TriggerBossDiabloSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossDiabloSpawned) {
        return;
    }
    g_sfeBossDiabloSpawned = true;
    g_sfeBossDiabloPhase = 1;

    pSpawn = Point(50.0, 100.0);
    UnitCreate(1, "HybridDominator", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 0.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Ultralisk", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 0.0);
        u = UnitLastCreated();
    }
    g_sfeBossDiabloUnit = u;

    hp = 35000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 40.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FF0000\">¡¡AMENAZA DESTRUCTORA FINAL!! ¡DIABLO HA ENTRADO AL CAMPO DE BATALLA!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

bool gt_SFE_BossAI_Loop_Func (bool testConds, bool runActions) {
    fixed hpPct;
    point bPos;

    if (!runActions) {
        return true;
    }

    if (g_sfeBossMaarSpawned && UnitIsAlive(g_sfeBossMaarUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossMaarUnit);

        if (hpPct <= 75.0 && g_sfeBossMaarPhase == 1) {
            g_sfeBossMaarPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar entra en Fase 2: ¡Invocando Enjambre del Vacío!</c>"));
            SFE_BossSummonMinions(bPos, "Mutalisk", 8);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 8.0, 150.0);
        } else if (hpPct <= 50.0 && g_sfeBossMaarPhase == 2) {
            g_sfeBossMaarPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar entra en Fase 3: ¡Onda de Choque Psiónica Devastadora!</c>"));
            SFE_BossSummonMinions(bPos, "Roach", 12);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 10.0, 250.0);
        } else if (hpPct <= 25.0 && g_sfeBossMaarPhase == 3) {
            g_sfeBossMaarPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar ¡ENFURECIDO!: Regeneración triplicada y Nova Crítica!</c>"));
            UnitSetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifeRegen, 60.0);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 12.0, 400.0);
        }
    }

    if (g_sfeBossDestroyerSpawned && UnitIsAlive(g_sfeBossDestroyerUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDestroyerUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDestroyerUnit);

        if (hpPct <= 75.0 && g_sfeBossDestroyerPhase == 1) {
            g_sfeBossDestroyerPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 2: ¡Impacto Sísmico!</c>"));
            SFE_BossSummonMinions(bPos, "Immortal", 4);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 9.0, 200.0);
        } else if (hpPct <= 50.0 && g_sfeBossDestroyerPhase == 2) {
            g_sfeBossDestroyerPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 3: ¡Bombardeo Orbital Masivo!</c>"));
            SFE_BossSummonMinions(bPos, "Colossus", 3);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 11.0, 350.0);
        } else if (hpPct <= 25.0 && g_sfeBossDestroyerPhase == 3) {
            g_sfeBossDestroyerPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds ¡SOBRECARGA NUCLEAR TOTAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 14.0, 500.0);
        }
    }

    if (g_sfeBossDiabloSpawned && UnitIsAlive(g_sfeBossDiabloUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDiabloUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDiabloUnit);

        if (hpPct <= 75.0 && g_sfeBossDiabloPhase == 1) {
            g_sfeBossDiabloPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 2: ¡Llamas del Infierno!</c>"));
            SFE_BossSummonMinions(bPos, "Ultralisk", 4);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 10.0, 300.0);
        } else if (hpPct <= 50.0 && g_sfeBossDiabloPhase == 2) {
            g_sfeBossDiabloPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 3: ¡Tormenta de Almas!</c>"));
            SFE_BossSummonMinions(bPos, "HybridDestroyer", 3);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 12.0, 450.0);
        } else if (hpPct <= 25.0 && g_sfeBossDiabloPhase == 3) {
            g_sfeBossDiabloPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo ¡CATACLISMO FINAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 15.0, 700.0);
        }
    }

    return true;
}

bool gt_SFE_BossDied_Func (bool testConds, bool runActions) {
    unit dyingU = EventUnit();
    int p = 1;

    if (!runActions) {
        return true;
    }

    if (dyingU == g_sfeBossMaarUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡HÍBRIDO MAAR ELIMINADO! +2500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDestroyerUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡DESTROYER OF WORLDS ERRADICADO! +3500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 3500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDiabloUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FFE400\">¡¡DIABLO HA SIDO DERROTADO!! ¡EL ARCADE HA SIDO COMPLETADO!</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
        SFE_TriggerVictory();
    }

    return true;
}

void SFE_InitBossSystem () {
    trigger tBossAI;
    trigger tBossDied;

    g_sfeBossMaarSpawned = false;
    g_sfeBossDestroyerSpawned = false;
    g_sfeBossDiabloSpawned = false;

    g_sfeBossAITimer = TimerCreate();
    TimerStart(g_sfeBossAITimer, 2.0, true, c_timeGame);
    tBossAI = TriggerCreate("gt_SFE_BossAI_Loop_Func");
    TriggerAddEventTimer(tBossAI, g_sfeBossAITimer);

    tBossDied = TriggerCreate("gt_SFE_BossDied_Func");
    TriggerAddEventUnitDied(tBossDied, null);
}

//--------------------------------------------------------------------------------------------------
// SECCIÓN 10: SELECTOR DE DIFICULTAD Y BUCLE MAESTRO
//--------------------------------------------------------------------------------------------------
int g_sfeDiffDialog;
int[c_DIFF_COUNT] g_sfeDiffButtons;
bool g_sfeDifficultyChosen;

bool gt_SFE_DamageHook_Func (bool testConds, bool runActions) {
    unit attacker = EventUnitDamageSourceUnit();
    unit victim = EventUnit();
    int attackerPlayer = UnitGetOwner(attacker);
    fixed strBonus;

    if (!runActions) {
        return true;
    }

    if (attackerPlayer >= 1 && attackerPlayer <= c_SFE_MAX_PLAYERS && g_sfeHeroStates[attackerPlayer].isActive) {
        if (attacker == g_sfeHeroStates[attackerPlayer].heroUnit && UnitGetOwner(victim) == c_SFE_PLAYER_HOSTILE) {
            strBonus = g_sfeHeroStates[attackerPlayer].strength * c_FACTOR_ALPHA_STRENGTH_DAMAGE;
            if (strBonus > 0.0) {
                UnitDamage(attacker, "WeaponNull", victim, strBonus);
            }
        }
    }

    return true;
}

void SFE_StartGameAfterDifficulty (int chosenDiff) {
    int p;
    int startingMinerals;
    trigger tWaveTick;
    trigger tReward;
    trigger tDamage;
    text diffNotice;

    g_sfeCurrentDifficulty = chosenDiff;

    diffNotice = StringToText("<s val=\"ModCenterSize22Bold\"><c val=\"FFE400\">DIFICULTAD ESTABLECIDA EN: </c><c val=\"00FFEA\">" + g_sfeDiffNames[chosenDiff] + "</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, diffNotice);

    if (chosenDiff == c_DIFF_CASUAL) {
        startingMinerals = 800;
    } else if (chosenDiff == c_DIFF_NORMAL) {
        startingMinerals = 500;
    } else if (chosenDiff == c_DIFF_HARD) {
        startingMinerals = 350;
    } else if (chosenDiff == c_DIFF_BRUTAL) {
        startingMinerals = 200;
    } else if (chosenDiff == c_DIFF_PRO) {
        startingMinerals = 100;
    } else if (chosenDiff == c_DIFF_IMPOSSIBLE) {
        startingMinerals = 50;
    } else {
        startingMinerals = 0;
    }

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperSetTo, startingMinerals);
        }
        p = p + 1;
    }

    SFE_InitAlliedBase();
    SFE_InitHUD();
    SFE_InitWaveSpawner();
    SFE_InitBossSystem();
    SFE_InitHeroSelectionUI();

    g_sfeWaveTickTimer = TimerCreate();
    TimerStart(g_sfeWaveTickTimer, 1.0, true, c_timeGame);
    tWaveTick = TriggerCreate("gt_SFE_WaveLoop_Timer_Func");
    TriggerAddEventTimer(tWaveTick, g_sfeWaveTickTimer);

    tReward = TriggerCreate("gt_SFE_UnitDied_Reward_Func");
    TriggerAddEventUnitDied(tReward, null);

    tDamage = TriggerCreate("gt_SFE_DamageHook_Func");
    TriggerAddEventUnitDamaged(tDamage, null);
}

bool gt_SFE_DiffSelect_Click_Func (bool testConds, bool runActions) {
    int clicked = EventDialogControl();
    int d = 0;

    if (!runActions || g_sfeDifficultyChosen) {
        return true;
    }

    while (d < c_DIFF_COUNT) {
        if (clicked == g_sfeDiffButtons[d]) {
            g_sfeDifficultyChosen = true;
            DialogSetVisible(g_sfeDiffDialog, PlayerGroupAll(), false);
            SFE_StartGameAfterDifficulty(d);
            return true;
        }
        d = d + 1;
    }

    return true;
}

void SFE_InitDifficultySelection () {
    trigger tClick;
    int d;
    int btnY;

    g_sfeDifficultyChosen = false;

    g_sfeDiffDialog = DialogCreate(540, 520, c_anchorCenter, 0, 0, true);
    DialogSetImage(g_sfeDiffDialog, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    DialogControlCreate(g_sfeDiffDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), 500, 35);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTop, 0, 20);
    DialogControlSetPropertyAsText(DialogControlLastCreated(), c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"FFE400\">SELECCIONA LA DIFICULTAD</c></s>"));

    tClick = TriggerCreate("gt_SFE_DiffSelect_Click_Func");

    d = 0;
    while (d < c_DIFF_COUNT) {
        btnY = 70 + (d * 58);
        g_sfeDiffButtons[d] = DialogControlCreate(g_sfeDiffDialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeDiffButtons[d], PlayerGroupAll(), 460, 48);
        DialogControlSetPosition(g_sfeDiffButtons[d], PlayerGroupAll(), c_anchorTop, 0, btnY);
        
        DialogControlSetPropertyAsText(g_sfeDiffButtons[d], c_triggerControlPropertyText, PlayerGroupAll(), 
            StringToText("<s val=\"ModCenterSize16Bold\">" + g_sfeDiffNames[d] + "</s>"));

        TriggerAddEventDialogControl(tClick, 1, g_sfeDiffButtons[d], c_triggerControlEventTypeClick);
        d = d + 1;
    }

    DialogSetVisible(g_sfeDiffDialog, PlayerGroupAll(), true);
}

void SFE_SetupDiplomacyAndAlliances () {
    int p1 = 1;
    int p2;

    while (p1 <= c_SFE_MAX_PLAYERS) {
        PlayerSetAlliance(p1, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, true);
        PlayerSetAlliance(p1, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, true);
        PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, p1, c_allianceIdPassive, true);
        PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, p1, c_allianceIdVision, true);

        PlayerSetAlliance(p1, c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, false);
        PlayerSetAlliance(p1, c_SFE_PLAYER_HOSTILE, c_allianceIdVision, false);
        PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, p1, c_allianceIdPassive, false);
        PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, p1, c_allianceIdVision, false);

        p2 = 1;
        while (p2 <= c_SFE_MAX_PLAYERS) {
            if (p1 != p2) {
                PlayerSetAlliance(p1, p2, c_allianceIdPassive, true);
                PlayerSetAlliance(p1, p2, c_allianceIdVision, true);
                PlayerSetAlliance(p1, p2, c_allianceIdSeekHelp, true);
            }
            p2 = p2 + 1;
        }
        p1 = p1 + 1;
    }

    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_HOSTILE, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_ALLIED_BASE, c_SFE_PLAYER_HOSTILE, c_allianceIdVision, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdPassive, false);
    PlayerSetAlliance(c_SFE_PLAYER_HOSTILE, c_SFE_PLAYER_ALLIED_BASE, c_allianceIdVision, false);
}

void SFE_MainInit () {
    int p;

    SFE_SetupDiplomacyAndAlliances();
    SFE_InitDifficultyTables();
    SFE_InitHeroCatalog();

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_BankInit(p);
        }
        p = p + 1;
    }

    SFE_InitDifficultySelection();
}

//--------------------------------------------------------------------------------------------------
// SECCIÓN 11: PUNTOS DE ENTRADA DEL MOTOR SC2
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
}

void InitMap () {
    InitLibs();
    SFE_MainInit();
}
