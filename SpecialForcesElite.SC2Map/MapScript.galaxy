    g_sfeBuffCatalog[c_BUFF_T2_ADV_ARMOR].description = "+5% Reduccion Danio, +75 Blindaje Base, +50% Blindaje.";

    g_sfeBuffCatalog[c_BUFF_T2_ANCIENT_VALOR].tier = 2;
