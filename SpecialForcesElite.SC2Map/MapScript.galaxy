//--------------------------------------------------------------------------------------------------
// Configuración de Jugadores
//--------------------------------------------------------------------------------------------------
const int c_SFE_MAX_PLAYERS        = 1;  // Jugador activo
const int c_SFE_PLAYER_ALLIED_BASE = 1;  // Base Aliada / Fortaleza Planetaria (propiedad del jugador)
const int c_SFE_PLAYER_HOSTILE     = 2;  // Invasores Zerg / Hostiles (Computadora enemiga)
const int c_SFE_PLAYER_NEUTRAL     = 0;

//--------------------------------------------------------------------------------------------------
// Niveles de Dificultad (6 Dificultades Canónicas según Documento de Diseño)
//--------------------------------------------------------------------------------------------------
const int c_DIFF_CASUAL     = 0;
const int c_DIFF_NORMAL     = 1;
const int c_DIFF_HARD       = 2;
const int c_DIFF_BRUTAL     = 3;
const int c_DIFF_PRO        = 4;
const int c_DIFF_TORMENT    = 5;
const int c_DIFF_COUNT      = 6;

// Multiplicadores de Dificultad
fixed[c_DIFF_COUNT] g_sfeDiffIncomeMultiplier;       // M_inc
fixed[c_DIFF_COUNT] g_sfeDiffHostileStatMultiplier;   // M_stat
fixed[c_DIFF_COUNT] g_sfeDiffUpgradeIntervalSeconds; // T_up (intervalo de upgrades de la IA)
fixed[c_DIFF_COUNT] g_sfeDiffWaveIntervalSeconds;    // Intervalo de oleadas
string[c_DIFF_COUNT] g_sfeDiffNames;

// Variables Globales de Estado del Juego
int g_sfeCurrentDifficulty;
int g_sfeCurrentWaveNumber;
int g_sfeWaveTimeRemaining;
fixed g_sfeBaseCoreHpPercent;

// Factores de conversión matemáticos según especificación oficial
const fixed c_FACTOR_ALPHA_STRENGTH_DAMAGE = 1.5;
const fixed c_FACTOR_ALPHA_STRENGTH_HP     = 25.0;
const fixed c_FACTOR_BETA_DEXTERITY_SPEED  = 0.02;
const fixed c_FACTOR_GAMMA_DEXTERITY_REGEN = 0.25;
const fixed c_FACTOR_LAMBDA_INTEL_ENERGY   = 10.0;
const fixed c_FACTOR_LAMBDA_INTEL_REGEN    = 0.20;
const fixed c_FACTOR_LAMBDA_INTEL_SIGHT    = 0.05;

// Estructura de Estado de Heroe
struct SFE_HeroState {
    unit heroUnit;
    int heroId;
    bool isActive;

    int level;
    int currentXp;
    int requiredXp;
    int unspentAttributePoints;

    int strength;
    int dexterity;
    int intelligence;
    int stamina;
    int neutronArmor;

    fixed currentMaxHp;
    fixed currentMaxShields;
    fixed currentMaxEnergy;
    fixed currentDamage;
    fixed currentAttackInterval;
    fixed currentLifeRegen;
    fixed currentEnergyRegen;
    fixed currentSightRadius;
    fixed currentMovementSpeed;
    fixed currentArmor;
};

SFE_HeroState[c_SFE_MAX_PLAYERS + 1] g_sfeHeroStates;

