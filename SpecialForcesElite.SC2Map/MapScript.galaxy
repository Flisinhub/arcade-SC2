point g_sfePlateauNorthWest;
point g_sfePlateauSouthEast;
point g_sfePlateauCenter;

void SFE_InitDifficultyTables () {
    // M_inc: Multiplicador de ingreso por baja
    g_sfeDiffIncomeMultiplier[c_DIFF_CASUAL]  = 1.50;
    g_sfeDiffIncomeMultiplier[c_DIFF_NORMAL]  = 1.00;
    g_sfeDiffIncomeMultiplier[c_DIFF_HARD]    = 0.75;
    g_sfeDiffIncomeMultiplier[c_DIFF_BRUTAL]  = 0.50;
    g_sfeDiffIncomeMultiplier[c_DIFF_PRO]     = 0.25;
    g_sfeDiffIncomeMultiplier[c_DIFF_TORMENT] = 0.10;

    // M_stat: Escalado de estadísticas hostiles
    g_sfeDiffHostileStatMultiplier[c_DIFF_CASUAL]  = 0.50;
    g_sfeDiffHostileStatMultiplier[c_DIFF_NORMAL]  = 1.00;
    g_sfeDiffHostileStatMultiplier[c_DIFF_HARD]    = 2.00;
    g_sfeDiffHostileStatMultiplier[c_DIFF_BRUTAL]  = 3.00;
    g_sfeDiffHostileStatMultiplier[c_DIFF_PRO]     = 4.00;
    g_sfeDiffHostileStatMultiplier[c_DIFF_TORMENT] = 5.00;

    // T_up: Intervalo de mejoras periódicas enemigas (curva de entropía)
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_CASUAL]  = 120.0;
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_NORMAL]  = 60.0;
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_HARD]    = 40.0;
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_BRUTAL]  = 30.0;
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_PRO]     = 20.0;
    g_sfeDiffUpgradeIntervalSeconds[c_DIFF_TORMENT] = 15.0;

    // Intervalo entre oleadas hostiles
    g_sfeDiffWaveIntervalSeconds[c_DIFF_CASUAL]  = 35.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_NORMAL]  = 30.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_HARD]    = 25.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_BRUTAL]  = 22.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_PRO]     = 18.0;
    g_sfeDiffWaveIntervalSeconds[c_DIFF_TORMENT] = 15.0;

    g_sfeDiffNames[c_DIFF_CASUAL]  = "Casual (x1.5 Inc / x0.5 Stat / 120s Up)";
    g_sfeDiffNames[c_DIFF_NORMAL]  = "Normal (x1.0 Inc / x1.0 Stat / 60s Up)";
    g_sfeDiffNames[c_DIFF_HARD]    = "Hard (x0.75 Inc / x2.0 Stat / 40s Up)";
    g_sfeDiffNames[c_DIFF_BRUTAL]  = "Brutal (x0.50 Inc / x3.0 Stat / 30s Up)";
    g_sfeDiffNames[c_DIFF_PRO]     = "Pro (x0.25 Inc / x4.0 Stat / 20s Up)";
    g_sfeDiffNames[c_DIFF_TORMENT] = "TORMENT (x0.10 Inc / x5.0 Stat / 15s Up)";
}

