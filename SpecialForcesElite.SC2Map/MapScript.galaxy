const int c_ATTR_INTELLIGENCE = 2; // Inteligencia: Energía (+10), Visión y Regen Maná

struct SFE_HeroDefinition {
    int id;
    string unitType;
    string fallbackUnitType;
    string name;
    string faction;
    string archetype;
    string description;
    int primaryAttribute;
    fixed baseHp;
    fixed baseShields;
    fixed baseEnergy;
    fixed baseArmor;
    fixed baseDamage;
    fixed baseAttackInterval;
    string portraitIcon;
};

SFE_HeroDefinition[c_HERO_TOTAL_COUNT] g_sfeHeroes;

