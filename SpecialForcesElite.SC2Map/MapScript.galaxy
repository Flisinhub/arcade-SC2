    g_sfeBuffCatalog[c_BUFF_T5_WARRIOR].name = "Warrior";
    g_sfeBuffCatalog[c_BUFF_T5_WARRIOR].description = "+20% Vida/Escudos, +15% Regen, +10% Reduccion Danio, +5% Danio.";

    g_sfeBuffCatalog[c_BUFF_T5_WIZARD].tier = 5;
    g_sfeBuffCatalog[c_BUFF_T5_WIZARD].cost = 15000;
    g_sfeBuffCatalog[c_BUFF_T5_WIZARD].name = "Wizard";
    g_sfeBuffCatalog[c_BUFF_T5_WIZARD].description = "+25% Danio Magico, +20% Energia Max, +10 Regen Energia.";

    // Tier 6
    g_sfeBuffCatalog[c_BUFF_T6_BULWARK].tier = 6;
    g_sfeBuffCatalog[c_BUFF_T6_BULWARK].cost = 17500;
    g_sfeBuffCatalog[c_BUFF_T6_BULWARK].name = "Bulwark";
    g_sfeBuffCatalog[c_BUFF_T6_BULWARK].description = "+10% Reduccion Danio, +60 Regen, +1% Danio por pila inmovil (hasta +5%).";

    g_sfeBuffCatalog[c_BUFF_T6_DEFIANCE].tier = 6;
    g_sfeBuffCatalog[c_BUFF_T6_DEFIANCE].cost = 17500;
    g_sfeBuffCatalog[c_BUFF_T6_DEFIANCE].name = "Defiance";
    g_sfeBuffCatalog[c_BUFF_T6_DEFIANCE].description = "+20% Vida/Escudos. +10 Regen Vida y +2 Regen Energia por cada 10% salud perdida.";

    g_sfeBuffCatalog[c_BUFF_T6_HOLY_SHELL].tier = 6;
    g_sfeBuffCatalog[c_BUFF_T6_HOLY_SHELL].cost = 17500;
    g_sfeBuffCatalog[c_BUFF_T6_HOLY_SHELL].name = "Holy Shell";
    g_sfeBuffCatalog[c_BUFF_T6_HOLY_SHELL].description = "+25% Blindaje. Escudo de Inmunidad que bloquea danio mayor a 100 por 5s.";

    g_sfeBuffCatalog[c_BUFF_T6_MIGHT].tier = 6;
    g_sfeBuffCatalog[c_BUFF_T6_MIGHT].cost = 17500;
    g_sfeBuffCatalog[c_BUFF_T6_MIGHT].name = "Might";
    g_sfeBuffCatalog[c_BUFF_T6_MIGHT].description = "+3000 Vida Max, +200 Blindaje, Aura que ralentiza enemigos 25%.";

    // Tier 7
    g_sfeBuffCatalog[c_BUFF_T7_MARKSMAN].tier = 7;
    g_sfeBuffCatalog[c_BUFF_T7_MARKSMAN].cost = 20000;
    g_sfeBuffCatalog[c_BUFF_T7_MARKSMAN].name = "Marksman";
    g_sfeBuffCatalog[c_BUFF_T7_MARKSMAN].description = "+20% Danio Rango, +75 Danio Base Arma, +25% Melee.";

    g_sfeBuffCatalog[c_BUFF_T7_SPELLBOUND].tier = 7;
    g_sfeBuffCatalog[c_BUFF_T7_SPELLBOUND].cost = 20000;
    g_sfeBuffCatalog[c_BUFF_T7_SPELLBOUND].name = "Spellbound";
    g_sfeBuffCatalog[c_BUFF_T7_SPELLBOUND].description = "+20% Danio Magico, +0.2% Danio Magico por punto de energia actual.";

    g_sfeBuffCatalog[c_BUFF_T7_SPIRITED].tier = 7;
    g_sfeBuffCatalog[c_BUFF_T7_SPIRITED].cost = 20000;
    g_sfeBuffCatalog[c_BUFF_T7_SPIRITED].name = "Spirited";
    g_sfeBuffCatalog[c_BUFF_T7_SPIRITED].description = "+15% Reduccion Enfriamiento, +15 Regen Energia, +15% Danio Magico.";

    g_sfeBuffCatalog[c_BUFF_T7_VIGOR].tier = 7;
    g_sfeBuffCatalog[c_BUFF_T7_VIGOR].cost = 20000;
    g_sfeBuffCatalog[c_BUFF_T7_VIGOR].name = "Vigor";
    g_sfeBuffCatalog[c_BUFF_T7_VIGOR].description = "Aura Devastadora: 300 Danio/s en radio 5. +10% Vida y Escudos.";

    // Ultimates
    g_sfeBuffCatalog[c_BUFF_ULT_ACE].tier = 8;
    g_sfeBuffCatalog[c_BUFF_ULT_ACE].cost = 15000;
    g_sfeBuffCatalog[c_BUFF_ULT_ACE].name = "Ace";
    g_sfeBuffCatalog[c_BUFF_ULT_ACE].description = "+20% Vitalidad/Regen, +25% Danio, +15% Cadencia, +25 Blindaje, +1000 Vida.";

    g_sfeBuffCatalog[c_BUFF_ULT_DEMIURGE].tier = 8;
    g_sfeBuffCatalog[c_BUFF_ULT_DEMIURGE].cost = 30000;
    g_sfeBuffCatalog[c_BUFF_ULT_DEMIURGE].name = "Power of Demiurge";
    g_sfeBuffCatalog[c_BUFF_ULT_DEMIURGE].description = "Salvacion ante la Muerte: Entra en Estasis e Invulnerabilidad 10s (CD: 180s).";

    g_sfeBuffCatalog[c_BUFF_ULT_VETERANCY].tier = 8;
    g_sfeBuffCatalog[c_BUFF_ULT_VETERANCY].cost = 10000;
    g_sfeBuffCatalog[c_BUFF_ULT_VETERANCY].name = "Veterancy";
    g_sfeBuffCatalog[c_BUFF_ULT_VETERANCY].description = "Transforma la unidad en Unidad de Elite: escala atributos por nivel y bajas.";

    g_sfeBuffCatalog[c_BUFF_ULT_MAX_EXP].tier = 8;
    g_sfeBuffCatalog[c_BUFF_ULT_MAX_EXP].cost = 75000;
    g_sfeBuffCatalog[c_BUFF_ULT_MAX_EXP].name = "Maximum Experience";
    g_sfeBuffCatalog[c_BUFF_ULT_MAX_EXP].description = "Sube la unidad inmediatamente al nivel maximo 100 (reembolsa 750 por nivel ya tenido).";

    // Inicializar estado por jugador
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        t = 1;
        while (t <= 7) {
            g_sfePlayerBuffTiers[p][t] = c_BUFF_NONE;
            t = t + 1;
        }
        g_sfePlayerAce[p] = false;
        g_sfePlayerDemiurge[p] = false;
        g_sfePlayerVeterancy[p] = false;
        g_sfePlayerVeterancyKills[p] = 0;
        g_sfePlayerDemiurgeCooldown[p] = 0.0;
        g_sfeMomentumStacks[p] = 0;
        g_sfeBulwarkStacks[p] = 0;
        g_sfeLastDamageTime[p] = 0.0;
        g_sfeLastHeroPos[p] = Point(0.0, 0.0);
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Obtener Coste de un Buff
//--------------------------------------------------------------------------------------------------
int SFE_GetBuffCost (int buffId) {
    if (buffId >= 1 && buffId < c_TOTAL_BUFFS_COUNT) {
        return g_sfeBuffCatalog[buffId].cost;
    }
    return 0;
}

//--------------------------------------------------------------------------------------------------
// Obtener Nombre de un Buff
//--------------------------------------------------------------------------------------------------
string SFE_GetBuffName (int buffId) {
    if (buffId >= 1 && buffId < c_TOTAL_BUFFS_COUNT) {
        return g_sfeBuffCatalog[buffId].name;
    }
    return "";
}

//--------------------------------------------------------------------------------------------------
// Comprar un Buff para un Jugador
//--------------------------------------------------------------------------------------------------
bool SFE_BuyBuff (int player, int buffId) {
    int tier;
    int cost;
    int oldBuff;
    int playerMinerals;
    int currentLvl;
    text msg;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || buffId < 1 || buffId >= c_TOTAL_BUFFS_COUNT) {
        return false;
    }

    tier = g_sfeBuffCatalog[buffId].tier;
    cost = g_sfeBuffCatalog[buffId].cost;
    playerMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);

    // Manejo de Ultimates
    if (tier == 8) {
        if (buffId == c_BUFF_ULT_MAX_EXP) {
            currentLvl = g_sfeHeroStates[player].level;
            cost = cost - (currentLvl * 750);
            if (cost < 0) {
                cost = 0;
            }
            if (playerMinerals < cost) {
                msg = StringToText("<c val=\"FF4444\">Minerales insuficientes para Maximum Experience (" + IntToString(cost) + ").</c>");
                UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, msg);
                return false;
            }
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfeHeroStates[player].level = 100;
            g_sfeHeroStates[player].unspentAttributePoints = g_sfeHeroStates[player].unspentAttributePoints + (100 - currentLvl) * 3;
            SFE_RecalculateStats(player);
            msg = StringToText("<c val=\"FFE400\">¡Maximum Experience activado! Nivel 100 alcanzado.</c>");
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, msg);
            return true;
        }

        if (buffId == c_BUFF_ULT_ACE) {
            if (g_sfePlayerAce[player]) {
                return false;
            }
            if (playerMinerals < cost) {
                UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes para Ace.</c>"));
                return false;
            }
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfePlayerAce[player] = true;
            SFE_RecalculateStats(player);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("<c val=\"FFE400\">¡Buff Ultimate ACE adquirido!</c>"));
            return true;
        }

        if (buffId == c_BUFF_ULT_DEMIURGE) {
            if (g_sfePlayerDemiurge[player]) {
                return false;
            }
            if (playerMinerals < cost) {
                UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes para Demiurge.</c>"));
                return false;
            }
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfePlayerDemiurge[player] = true;
            g_sfePlayerDemiurgeCooldown[player] = 0.0;
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("<c val=\"00FFEA\">¡Power of Demiurge adquirido (Proteccion contra muerte lista)!</c>"));
            return true;
        }

        if (buffId == c_BUFF_ULT_VETERANCY) {
            if (g_sfePlayerVeterancy[player]) {
                return false;
            }
            if (playerMinerals < cost) {
                UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes para Veterancy.</c>"));
                return false;
            }
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfePlayerVeterancy[player] = true;
            SFE_RecalculateStats(player);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, StringToText("<c val=\"FFE400\">¡Rango de Veterania adquirido!</c>"));
            return true;
        }

        return false;
    }

    // Tiers regulares (1 a 7): Comprobar regla de 1 buff por Tier
    oldBuff = g_sfePlayerBuffTiers[player][tier];

    // Si ya tiene este mismo buff, no hacer nada
    if (oldBuff == buffId) {
        return false;
    }

    // Si ya tenía otro buff en este tier, reembolsar el viejo
    if (oldBuff != c_BUFF_NONE) {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperAdd, g_sfeBuffCatalog[oldBuff].cost);
        playerMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    }

    // Verificar si puede pagar el nuevo buff
    if (playerMinerals < cost) {
        // Revertir reembolso si no puede pagar el nuevo
        if (oldBuff != c_BUFF_NONE) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, g_sfeBuffCatalog[oldBuff].cost);
        }
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes para " + g_sfeBuffCatalog[buffId].name + ".</c>"));
        return false;
    }

    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
    g_sfePlayerBuffTiers[player][tier] = buffId;
    SFE_RecalculateStats(player);

    msg = StringToText("<c val=\"55FF55\">[Tier " + IntToString(tier) + "] " + g_sfeBuffCatalog[buffId].name + " adquirido (" + IntToString(cost) + " min).</c>");
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, msg);

    return true;
}

//--------------------------------------------------------------------------------------------------
// Vender un Buff de un Tier y Obtener Reembolso Completo
//--------------------------------------------------------------------------------------------------
void SFE_SellBuff (int player, int tier) {
    int oldBuff;
    int refund;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || tier < 1 || tier > 7) {
        return;
    }

    oldBuff = g_sfePlayerBuffTiers[player][tier];
    if (oldBuff == c_BUFF_NONE) {
        return;
    }

    refund = g_sfeBuffCatalog[oldBuff].cost;
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperAdd, refund);
    g_sfePlayerBuffTiers[player][tier] = c_BUFF_NONE;
    SFE_RecalculateStats(player);

    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, 
        StringToText("<c val=\"FFFF55\">Buff " + g_sfeBuffCatalog[oldBuff].name + " vendido. +" + IntToString(refund) + " minerales reembolsados.</c>"));
}

//--------------------------------------------------------------------------------------------------
// Muerte del Heroe: Deducción de Buffs y Reembolso según Dificultad
// Casual: 100% | Normal: 75% | Hard: 50% | Brutal: 25% | Torment: 0%
//--------------------------------------------------------------------------------------------------
void SFE_OnHeroDeathRefundBuffs (int player) {
    int t;
    int bId;
    int totalCost;
    int refundAmount;
    fixed refundFactor;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return;
    }

    if (g_sfeCurrentDifficulty == c_DIFF_CASUAL) {
        refundFactor = 1.00;
    } else if (g_sfeCurrentDifficulty == c_DIFF_NORMAL) {
        refundFactor = 0.75;
    } else if (g_sfeCurrentDifficulty == c_DIFF_HARD) {
        refundFactor = 0.50;
    } else if (g_sfeCurrentDifficulty == c_DIFF_BRUTAL) {
        refundFactor = 0.25;
    } else {
        refundFactor = 0.00; // Torment
    }

    totalCost = 0;
    t = 1;
    while (t <= 7) {
        bId = g_sfePlayerBuffTiers[player][t];
        if (bId != c_BUFF_NONE) {
            totalCost = totalCost + g_sfeBuffCatalog[bId].cost;
            g_sfePlayerBuffTiers[player][t] = c_BUFF_NONE;
        }
        t = t + 1;
    }

    if (totalCost > 0 && refundFactor > 0.0) {
        refundAmount = FixedToInt(IntToFixed(totalCost) * refundFactor);
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperAdd, refundAmount);
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, 
            StringToText("<c val=\"FF8800\">Muerte del Heroe: Buffs perdidos. Reembolso recibido: " + IntToString(refundAmount) + " minerales (" + FixedToString(refundFactor * 100.0, 0) + "%).</c>"));
    } else if (totalCost > 0) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaChat, 
            StringToText("<c val=\"FF4444\">Muerte del Heroe en Torment: Todos los buffs perdidos sin reembolso.</c>"));
    }

    g_sfeMomentumStacks[player] = 0;
    g_sfeBulwarkStacks[player] = 0;
    SFE_RecalculateStats(player);
}

//--------------------------------------------------------------------------------------------------
// Bucle Periodico de Buffs Condicionales (Cada 0.5 segundos)
//--------------------------------------------------------------------------------------------------
void SFE_PeriodicBuffTick () {
    int p;
    unit u;
    point curPos;
    fixed dist;
    int bT3;
    int bT6;

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[p].isActive) {
            u = g_sfeHeroStates[p].heroUnit;
            if (u != null && UnitIsAlive(u)) {
                curPos = UnitGetPosition(u);
                dist = DistanceBetweenPoints(curPos, g_sfeLastHeroPos[p]);
                g_sfeLastHeroPos[p] = curPos;

                bT3 = g_sfePlayerBuffTiers[p][3];
                bT6 = g_sfePlayerBuffTiers[p][6];

                // Momentum: movimiento genera pilas hasta 5
                if (bT3 == c_BUFF_T3_MOMENTUM) {
                    if (dist > 0.1) {
                        if (g_sfeMomentumStacks[p] < 5) {
                            g_sfeMomentumStacks[p] = g_sfeMomentumStacks[p] + 1;
                        }
                    } else {
                        if (g_sfeMomentumStacks[p] > 0) {
                            g_sfeMomentumStacks[p] = g_sfeMomentumStacks[p] - 1;
                        }
                    }
                }

                // Bulwark: estacionario genera pilas hasta 5
                if (bT6 == c_BUFF_T6_BULWARK) {
                    if (dist <= 0.05) {
                        if (g_sfeBulwarkStacks[p] < 5) {
                            g_sfeBulwarkStacks[p] = g_sfeBulwarkStacks[p] + 1;
                        }
                    } else {
                        g_sfeBulwarkStacks[p] = 0;
                    }
                }

                // Reducción de cooldown de Demiurge
                if (g_sfePlayerDemiurgeCooldown[p] > 0.0) {
                    g_sfePlayerDemiurgeCooldown[p] = g_sfePlayerDemiurgeCooldown[p] - 0.5;
                }
            }
        }
        p = p + 1;
    }
}

//==================================================================================================
// Special Forces Elite 5 - 500 Primary Race Upgrades & Autocast Engine
// Daño, Blindaje, Vida, Energía y Cadencia de Disparo (hasta nivel 500 con Autocast)
//==================================================================================================



// Declaraciones adelantadas
void SFE_InitUpgradesEngine ();
int SFE_GetUpgradeCost (int currentLvl);
bool SFE_BuyPrimaryUpgrade (int player, int upgradeType);
void SFE_ToggleAutocast (int player);
void SFE_RunUpgradeAutocast (int player);

//--------------------------------------------------------------------------------------------------
// Inicializar Variables del Motor de Mejoras
//--------------------------------------------------------------------------------------------------
void SFE_InitUpgradesEngine () {
    int p;
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        g_sfeUpgradeWeaponDamage[p] = 0;
        g_sfeUpgradeArmor[p] = 0;
        g_sfeUpgradeLife[p] = 0;
        g_sfeUpgradeEnergy[p] = 0;
        g_sfeUpgradeAttackSpeed[p] = 0;
        g_sfeUpgradeAutocastActive[p] = false;
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Calcular Coste Progresivo de una Mejora según su Nivel Actual
//--------------------------------------------------------------------------------------------------
int SFE_GetUpgradeCost (int currentLvl) {
    if (currentLvl >= c_UPGRADE_MAX_LEVEL) {
        return 999999;
    }
    // Progresión suave: nivel 0 cuesta 50 min, nivel 10 cuesta 150 min, nivel 100 cuesta 1050 min
    return 50 + (currentLvl * 10);
}

//--------------------------------------------------------------------------------------------------
// Comprar un Nivel de Mejora Principal
//--------------------------------------------------------------------------------------------------
bool SFE_BuyPrimaryUpgrade (int player, int upgradeType) {
    int curLvl;
    int cost;
    int playerMinerals;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return false;
    }

    if (upgradeType == c_UPG_WEAPON_DAMAGE) {
        curLvl = g_sfeUpgradeWeaponDamage[player];
    } else if (upgradeType == c_UPG_ARMOR) {
        curLvl = g_sfeUpgradeArmor[player];
    } else if (upgradeType == c_UPG_LIFE) {
        curLvl = g_sfeUpgradeLife[player];
    } else if (upgradeType == c_UPG_ENERGY) {
        curLvl = g_sfeUpgradeEnergy[player];
    } else if (upgradeType == c_UPG_ATTACK_SPEED) {
        curLvl = g_sfeUpgradeAttackSpeed[player];
    } else {
        return false;
    }

    if (curLvl >= c_UPGRADE_MAX_LEVEL) {
        return false;
    }

    cost = SFE_GetUpgradeCost(curLvl);
    playerMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);

    if (playerMinerals < cost) {
        return false;
    }

    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);

    if (upgradeType == c_UPG_WEAPON_DAMAGE) {
        g_sfeUpgradeWeaponDamage[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ARMOR) {
        g_sfeUpgradeArmor[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_LIFE) {
        g_sfeUpgradeLife[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ENERGY) {
        g_sfeUpgradeEnergy[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ATTACK_SPEED) {
        g_sfeUpgradeAttackSpeed[player] = curLvl + 1;
    }

    SFE_RecalculateStats(player);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Conmutar Autocast ON / OFF para un Jugador
//--------------------------------------------------------------------------------------------------
void SFE_ToggleAutocast (int player) {
    text msg;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return;
    }

    g_sfeUpgradeAutocastActive[player] = !g_sfeUpgradeAutocastActive[player];

    if (g_sfeUpgradeAutocastActive[player]) {
        msg = StringToText("<c val=\"55FF55\">[AUTOCAST ACTIVADO] Las 500 mejoras principales se comprarán automáticamente.</c>");
    } else {
        msg = StringToText("<c val=\"FFAA00\">[AUTOCAST DESACTIVADO] Compra manual de mejoras restaurada.</c>");
    }
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, msg);
}

//--------------------------------------------------------------------------------------------------
// Ejecutar Ciclo de Autocast (compra la mejora más barata disponible en lote)
//--------------------------------------------------------------------------------------------------
void SFE_RunUpgradeAutocast (int player) {
    int iterations;
    int lowestLvl;
    int targetUpg;
    int curLvl;
    bool bought;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeUpgradeAutocastActive[player]) {
        return;
    }

    iterations = 0;
    // Hasta 5 compras por pulso para preservar la reactividad del motor
    while (iterations < 5) {
        lowestLvl = 999999;
        targetUpg = -1;

        // 1: Daño
        curLvl = g_sfeUpgradeWeaponDamage[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_WEAPON_DAMAGE;
        }

        // 2: Blindaje
        curLvl = g_sfeUpgradeArmor[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ARMOR;
        }

        // 3: Vida
        curLvl = g_sfeUpgradeLife[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_LIFE;
        }

        // 4: Energía
        curLvl = g_sfeUpgradeEnergy[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ENERGY;
        }

        // 5: Cadencia
        curLvl = g_sfeUpgradeAttackSpeed[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ATTACK_SPEED;
        }

        if (targetUpg == -1) {
            break; // Todas al nivel máximo 500
        }

        bought = SFE_BuyPrimaryUpgrade(player, targetUpg);
        if (!bought) {
            break; // No alcanza el dinero para la siguiente
        }

        iterations = iterations + 1;
    }
}

//==================================================================================================
// Special Forces Elite 5 - Allied Base & Victory/Defeat Engine
// Fortaleza central aliada, defensas perimetrales y condiciones de fin de partida
//==================================================================================================



unit g_sfeBaseCoreUnit;
unit g_sfeMedic1;
unit g_sfeMedic2;
bool g_sfeGameOverTriggered;

// Declaraciones
void SFE_TriggerDefeat ();
void SFE_TriggerVictory ();
void SFE_BaseHealHeroesTick ();
void SFE_PlanetaryFortressDefendTick ();
bool gt_SFE_BaseClicked_Func (bool testConds, bool runActions);

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Selección/Clic en la Fortaleza Planetaria (Abre Consola de Mando)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_BaseClicked_Func (bool testConds, bool runActions) {
    int p;

    if (!runActions) {
        return true;
    }

    p = EventPlayer();
    if (p >= 1 && p <= c_SFE_MAX_PLAYERS) {
        SFE_TogglePlayerConsole(p);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Inicializar la Base Aliada y Estructuras Defensivas
//--------------------------------------------------------------------------------------------------
void SFE_InitAlliedBase () {
    point pCore;
    point pDefense;
    unit u;
    trigger tClickBase;
    int p;

    // Coordenadas canónicas: Base en la esquina inferior izquierda
    g_sfeBaseCenterPoint = Point(35.0, 35.0);
    g_sfeFinalHivePoint = Point(165.0, 155.0);

    // Las 4 Elevaciones Estratégicas en los cruces de caminos
    g_sfePlateauSouthWest = Point(58.0, 58.0);  // Bifurcación Principal Salida Base
    g_sfePlateauNorthWest = Point(55.0, 105.0); // Cruce Noroeste (Super Spawning Pool)
    g_sfePlateauSouthEast = Point(105.0, 55.0); // Cruce Sureste (Hydralisk Den)
    g_sfePlateauCenter    = Point(135.0, 115.0);// Gran Meseta Central Protoss

    g_sfeGameOverTriggered = false;
    g_sfeBaseCoreHpPercent = 100.0;

    // Configurar alianzas y colores oficiales: Jugador 1 (Base/Usuario) vs Jugador 2 (Hostil)
    PlayerSetAlliance(1, c_allianceIdPassive, 2, false);
    PlayerSetAlliance(2, c_allianceIdPassive, 1, false);
    PlayerSetAlliance(1, c_allianceIdVision, 2, false);
    PlayerSetAlliance(2, c_allianceIdVision, 1, false);
    PlayerSetColorIndex(1, 0, true);
    PlayerSetColorIndex(2, 1, true);

    // Crear Fortaleza Planetaria Troncal en la Esquina Inferior Izquierda (Jugador 1 - Base Aliada)
    UnitCreate(1, "PlanetaryFortress", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 45.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 45.0);
        u = UnitLastCreated();
    }
    g_sfeBaseCoreUnit = u;
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeMax, 15000.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeRegen, 8.0);

    // Conectar evento de clic en la base para abrir consola
    tClickBase = TriggerCreate("gt_SFE_BaseClicked_Func");
    TriggerAddEventUnitClick(tClickBase, UnitRefFromUnit(g_sfeBaseCoreUnit), c_playerAny);

    // Bunkers y Torretas protegiendo los 3 cuellos de botella de salida de la base
    // 1. Salida Norte (hacia Ruta Noroeste / Rupturer / Spawning Pools)
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, Point(35.0, 50.0), 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(29.0, 50.0), 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(41.0, 50.0), 90.0);

    // 2. Salida Este (hacia Ruta Sureste / Roach Den / Hydralisk Den)
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, Point(50.0, 35.0), 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(50.0, 29.0), 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(50.0, 41.0), 0.0);

    // 3. Salida Diagonal / Cuello de botella Central (hacia Meseta Suroeste)
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, Point(48.0, 48.0), 45.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(43.0, 53.0), 45.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(53.0, 43.0), 45.0);

    // Médicos de Campaña Aliados para dar soporte continuo
    UnitCreate(1, "Medic", 0, c_SFE_PLAYER_ALLIED_BASE, Point(33.0, 37.0), 45.0);
    g_sfeMedic1 = UnitLastCreated();
    if (g_sfeMedic1 != null) {
        UnitSetPropertyFixed(g_sfeMedic1, c_unitPropEnergyPercent, 100.0);
    }

    UnitCreate(1, "Medic", 0, c_SFE_PLAYER_ALLIED_BASE, Point(37.0, 33.0), 45.0);
    g_sfeMedic2 = UnitLastCreated();
    if (g_sfeMedic2 != null) {
        UnitSetPropertyFixed(g_sfeMedic2, c_unitPropEnergyPercent, 100.0);
    }

    // Visibilidad permanente de las 4 elevaciones estratégicas para todos los jugadores
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            VisRevealerCreate(p, RegionCircle(g_sfePlateauSouthWest, 6.0));
            VisRevealerCreate(p, RegionCircle(g_sfePlateauNorthWest, 6.0));
            VisRevealerCreate(p, RegionCircle(g_sfePlateauSouthEast, 6.0));
            VisRevealerCreate(p, RegionCircle(g_sfePlateauCenter, 7.0));
        }
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Cañón Ibiks de la Fortaleza Planetaria: Fuego de Artillería Defensivo con Daño de Salpicadura
//--------------------------------------------------------------------------------------------------
void SFE_PlanetaryFortressDefendTick () {
    unitgroup ugEnemies;
    unit target;
    point targetPos;
    int count;
    int i;
    unit splashVictim;
    fixed dist;

    if (g_sfeBaseCoreUnit == null || !UnitIsAlive(g_sfeBaseCoreUnit)) {
        return;
    }

    // Buscar enemigos hostiles a menos de 14.0 unidades de la base
    ugEnemies = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(g_sfeBaseCenterPoint, 14.0), null, 0);
    count = UnitGroupCount(ugEnemies, c_unitCountAlive);
    if (count <= 0) {
        return;
    }

    // Seleccionar objetivo principal
    target = UnitGroupUnit(ugEnemies, 1);
    if (target == null || !UnitIsAlive(target)) {
        return;
    }

    targetPos = UnitGetPosition(target);

    // Daño de impacto directo de cañón Ibiks (150.0)
    UnitDamage(g_sfeBaseCoreUnit, "WeaponNull", target, 150.0);

    // Daño de salpicadura (Splash) a enemigos adyacentes dentro de radio 3.5
    i = 2;
    while (i <= count) {
        splashVictim = UnitGroupUnit(ugEnemies, i);
        if (splashVictim != null && UnitIsAlive(splashVictim)) {
            dist = DistanceBetweenPoints(UnitGetPosition(splashVictim), targetPos);
            if (dist <= 3.5) {
                UnitDamage(g_sfeBaseCoreUnit, "WeaponNull", splashVictim, 75.0);
            }
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Aura de Curación de la Base: Regenera héroes cercanos y ordena a los médicos
//--------------------------------------------------------------------------------------------------
void SFE_BaseHealHeroesTick () {
    int p;
    unit uHero;
    fixed curLife;
    fixed maxLife;
    fixed newLife;
    fixed curEnergy;
    fixed maxEnergy;
    fixed newEnergy;
    fixed dist;
    order ordHeal;
    bool healedAny;

    p = 1;
    healedAny = false;

    // Disparar cañón defensivo Ibiks contra intrusos
    SFE_PlanetaryFortressDefendTick();

    while (p <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[p].isActive) {
            uHero = g_sfeHeroStates[p].heroUnit;
            if (uHero != null && UnitIsAlive(uHero)) {
                dist = DistanceBetweenPoints(UnitGetPosition(uHero), g_sfeBaseCenterPoint);
                if (dist <= 16.0) {
                    // Regeneración pasiva de vida (+3.5% por segundo)
                    curLife = UnitGetPropertyFixed(uHero, c_unitPropLife, true);
                    maxLife = UnitGetPropertyFixed(uHero, c_unitPropLifeMax, true);
                    if (curLife < maxLife) {
                        newLife = curLife + (maxLife * 0.035) + 35.0;
                        if (newLife > maxLife) {
                            newLife = maxLife;
                        }
                        UnitSetPropertyFixed(uHero, c_unitPropLife, newLife);

                        ordHeal = OrderTargetingUnit(AbilityCommand("MedicHeal", 0), uHero);
                        if (g_sfeMedic1 != null && UnitIsAlive(g_sfeMedic1)) {
                            UnitSetPropertyFixed(g_sfeMedic1, c_unitPropEnergyPercent, 100.0);
                            UnitIssueOrder(g_sfeMedic1, ordHeal, c_orderQueueReplace);
                        }
                        if (g_sfeMedic2 != null && UnitIsAlive(g_sfeMedic2)) {
                            UnitSetPropertyFixed(g_sfeMedic2, c_unitPropEnergyPercent, 100.0);
                            UnitIssueOrder(g_sfeMedic2, ordHeal, c_orderQueueReplace);
                        }
                        healedAny = true;
                    }

                    // Regeneración pasiva de energía (+5.0% por segundo)
                    curEnergy = UnitGetPropertyFixed(uHero, c_unitPropEnergy, true);
                    maxEnergy = UnitGetPropertyFixed(uHero, c_unitPropEnergyMax, true);
                    if (curEnergy < maxEnergy) {
                        newEnergy = curEnergy + (maxEnergy * 0.05);
                        if (newEnergy > maxEnergy) {
                            newEnergy = maxEnergy;
                        }
                        UnitSetPropertyFixed(uHero, c_unitPropEnergy, newEnergy);
                    }
                }
            }
        }
        p = p + 1;
    }

    if (!healedAny) {
        if (g_sfeMedic1 != null && UnitIsAlive(g_sfeMedic1)) {
            UnitIssueOrder(g_sfeMedic1, OrderTargetingPoint(AbilityCommand("move", 0), Point(97.0, 95.0)), c_orderQueueReplace);
        }
        if (g_sfeMedic2 != null && UnitIsAlive(g_sfeMedic2)) {
            UnitIssueOrder(g_sfeMedic2, OrderTargetingPoint(AbilityCommand("move", 0), Point(103.0, 95.0)), c_orderQueueReplace);
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Comprobacion de Salud de la Base (Monitoreo regular)
//--------------------------------------------------------------------------------------------------
void SFE_UpdateBaseHealthStatus () {
    fixed currentHp;

    if (g_sfeGameOverTriggered) {
        return;
    }

    if (g_sfeBaseCoreUnit == null) {
        return;
    }

    if (!UnitIsAlive(g_sfeBaseCoreUnit)) {
        SFE_TriggerDefeat();
        return;
    }

    currentHp = UnitGetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, true);
    g_sfeBaseCoreHpPercent = currentHp;

    if (currentHp <= 0.0) {
        SFE_TriggerDefeat();
    }
}

//--------------------------------------------------------------------------------------------------
// Secuencia de Derrota
//--------------------------------------------------------------------------------------------------
void SFE_TriggerDefeat () {
    int p;
    text defText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    p = 1;
    defText = StringToText("<b><c val=\"FF0000\">¡EL CUARTEL GENERAL HA SIDO DESTRUIDO!\nMISIÓN FALLIDA — DERROTA</c></b>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, defText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            GameOver(p, c_gameOverDefeat, true, true);
        }
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Secuencia de Victoria
//--------------------------------------------------------------------------------------------------
void SFE_TriggerVictory () {
    int p;
    text vicText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    p = 1;
    vicText = StringToText("<b><c val=\"00FF7F\">¡¡VICTORIA SUPREMA EN SPECIAL FORCES ELITE 5!!\nTODAS LAS HORDAS Y JEFES HAN SIDO ERRADICADOS</c></b>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, vicText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            // Registrar victoria de la dificultad alcanzada en el banco
            SFE_BankRecordVictory(p, g_sfeCurrentDifficulty);
            GameOver(p, c_gameOverVictory, true, true);
        }
        p = p + 1;
    }
}

//==================================================================================================
// Special Forces Elite 5 - Tripartite Threat Assault Systems
// 1. Vainas de Desembarco (Drop Pods cada 45s tras 120s)
// 2. Asaltos Cronometrados de la Colmena (Cada 5 min con 7 Jefes de Oleada)
// 3. Red de Gusanos Nydus en Cráteres (Emergen cada 90s vomitando refuerzos)
//==================================================================================================



// Declaraciones de funciones
void SFE_InitTripartiteSystem ();
void SFE_TripartiteTickSecond ();
void SFE_CheckDropPods ();
void SFE_CheckTimedHiveAssault ();
void SFE_CheckNydusNetwork ();
void SFE_SpawnTimedHiveBoss (int bossIndex);

//--------------------------------------------------------------------------------------------------
// Inicialización del Sistema de Amenaza Tripartita
//--------------------------------------------------------------------------------------------------
void SFE_InitTripartiteSystem () {
    g_sfeGameElapsedSeconds = 0;
    g_sfeNextDropPodSeconds = 120; // Primer drop pod al minuto 2:00
    g_sfeNextTimedAssaultSeconds = 300; // Primer asalto de colmena al minuto 5:00
    g_sfeCurrentTimedBossIndex = 0;
    g_sfeNextNydusSeconds = 180; // Primer gusano nydus al minuto 3:00
    g_sfeCurrentNydusWorm = null;
    g_sfeNydusAlive = false;

    // Coordenadas fijas de los 4 cráteres del terreno a lo largo de los valles
    g_sfeNydusCraterPoints[0] = Point(45.0, 95.0); // Cráter Noroeste
    g_sfeNydusCraterPoints[1] = Point(85.0, 85.0); // Cráter Central
    g_sfeNydusCraterPoints[2] = Point(95.0, 45.0); // Cráter Sureste
    g_sfeNydusCraterPoints[3] = Point(145.0, 85.0);// Cráter Este-Noreste
}

//--------------------------------------------------------------------------------------------------
// Bucle Por Segundo de la Amenaza Tripartita
//--------------------------------------------------------------------------------------------------
void SFE_TripartiteTickSecond () {
    g_sfeGameElapsedSeconds = g_sfeGameElapsedSeconds + 1;

    SFE_CheckDropPods();
    SFE_CheckTimedHiveAssault();
    SFE_CheckNydusNetwork();
}

//--------------------------------------------------------------------------------------------------
// 1. Vainas de Desembarco: Caen cada 45s sobre jugadores fuera de base
//--------------------------------------------------------------------------------------------------
void SFE_CheckDropPods () {
    int p;
    unit uHero;
    point hPos;
    point dropPos;
    fixed dist;
    unitgroup ugPod;
    unit spawned;
    order ordAtk;
    int i;
    int squadSize;
    string unitType;

    if (g_sfeGameElapsedSeconds < g_sfeNextDropPodSeconds) {
        return;
    }

    g_sfeNextDropPodSeconds = g_sfeGameElapsedSeconds + 45;

    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[p].isActive) {
            uHero = g_sfeHeroStates[p].heroUnit;
            if (uHero != null && UnitIsAlive(uHero)) {
                hPos = UnitGetPosition(uHero);
                dist = DistanceBetweenPoints(hPos, g_sfeBaseCenterPoint);

                // Si el héroe está fuera del perímetro de la base (> 25 unidades)
                if (dist > 25.0) {
                    dropPos = Point(PointGetX(hPos) + RandomFixed(-3.0, 3.0), PointGetY(hPos) + RandomFixed(-3.0, 3.0));

                    // Notificación táctica
                    UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle,
                        StringToText("<b><c val=\"FF4444\">[ALERTA DE DESEMBARCO] ¡Vaina hostil ha impactado en tus inmediaciones!</c></b>"));

                    // Desplegar tropas de asalto según dificultad
                    squadSize = 4;
                    if (g_sfeCurrentDifficulty >= c_DIFF_HARD) {
                        squadSize = 6;
                    }

                    i = 0;
                    while (i < squadSize) {
                        if (i % 2 == 0) {
                            unitType = "InfestedCivilian";
                        } else {
                            unitType = "Roach";
                        }
                        UnitCreate(1, unitType, 0, c_SFE_PLAYER_HOSTILE, dropPos, 225.0);
                        spawned = UnitLastCreated();
                        if (spawned == null) {
                            UnitCreate(1, "Zergling", 0, c_SFE_PLAYER_HOSTILE, dropPos, 225.0);
                            spawned = UnitLastCreated();
                        }

                        if (spawned != null) {
                            UnitSetPropertyFixed(spawned, c_unitPropLifeMax, 
                                UnitGetPropertyFixed(spawned, c_unitPropLifeMax, true) * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
                            UnitSetPropertyFixed(spawned, c_unitPropLifePercent, 100.0);
                            ordAtk = OrderTargetingUnit(AbilityCommand("attack", 0), uHero);
                            UnitIssueOrder(spawned, ordAtk, c_orderQueueReplace);
                        }
                        i = i + 1;
                    }
                }
            }
        }
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// 2. Asaltos Cronometrados de la Colmena: Cada 5 minutos con los 7 Jefes Canónicos
//--------------------------------------------------------------------------------------------------
void SFE_CheckTimedHiveAssault () {
    if (g_sfeGameElapsedSeconds < g_sfeNextTimedAssaultSeconds) {
        return;
    }

    // Programar el siguiente en 300 segundos (5 minutos)
    g_sfeNextTimedAssaultSeconds = g_sfeGameElapsedSeconds + 300;

    SFE_SpawnTimedHiveBoss(g_sfeCurrentTimedBossIndex);

    g_sfeCurrentTimedBossIndex = g_sfeCurrentTimedBossIndex + 1;
    if (g_sfeCurrentTimedBossIndex > 6) {
        g_sfeCurrentTimedBossIndex = 6; // Queda en Ferocious Brutes para el juego tardío
    }
}

void SFE_SpawnTimedHiveBoss (int bossIndex) {
    point pSpawn;
    unit uBoss;
    unit uEscort;
    string bossType;
    string bossName;
    fixed bossHp;
    int escortCount;
    string escortType;
    int i;
    order ordWp1;
    order ordWp2;
    order ordFinal;

    pSpawn = g_sfeFinalHivePoint; // Gran Colmena Zerg en la esquina superior derecha
    ordWp1 = OrderTargetingPoint(AbilityCommand("attack", 0), Point(135.0, 115.0)); // Cruce Meseta Central
    ordWp2 = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest); // Cruce Meseta Suroeste
    ordFinal = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint); // Fortaleza Planetaria

    if (bossIndex == 0) {
        // Minuto 5: Infested General
        bossName = "Infested General";
        bossType = "InfestedColonist";
        bossHp = 4500.0;
        escortType = "Marine";
        escortCount = 8;
    } else if (bossIndex == 1) {
        // Minuto 10: Rageling (Zergling colosal de ultra-velocidad)
        bossName = "Rageling";
        bossType = "Zergling";
        bossHp = 8000.0;
        escortType = "Zergling";
        escortCount = 16;
    } else if (bossIndex == 2) {
        // Minuto 15: Hellbringer (Ultralisco titánico con pisada sísmica)
        bossName = "Hellbringer";
        bossType = "Ultralisk";
        bossHp = 16000.0;
        escortType = "Roach";
        escortCount = 6;
    } else if (bossIndex == 3) {
        // Minuto 20: Brood Emperor (Señor de la prole masivo)
        bossName = "Brood Emperor";
        bossType = "BroodLord";
        bossHp = 20000.0;
        escortType = "Mutalisk";
        escortCount = 8;
    } else if (bossIndex == 4) {
        // Minuto 25: Hybrid Viper (Viper mutada con drenaje)
        bossName = "Hybrid Viper";
        bossType = "Viper";
        bossHp = 25000.0;
        escortType = "Hydralisk";
        escortCount = 8;
    } else if (bossIndex == 5) {
        // Minuto 30: Hybrid Lenkus (Gigante psiónico de plasma)
        bossName = "Hybrid Lenkus";
        bossType = "HybridBehemoth";
        bossHp = 35000.0;
        escortType = "Ultralisk";
        escortCount = 4;
    } else {
        // Minuto 35+: Ferocious Brutes (Legión de asalto final)
        bossName = "Ferocious Brutes";
        bossType = "Ultralisk";
        bossHp = 45000.0;
        escortType = "Aberration";
        escortCount = 6;
    }

    // Crear Jefe en la Colmena Superior Derecha
    UnitCreate(1, bossType, 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
    uBoss = UnitLastCreated();
    if (uBoss == null) {
        UnitCreate(1, "Archon", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        uBoss = UnitLastCreated();
    }

    bossHp = bossHp * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(uBoss, c_unitPropLifeMax, bossHp);
    UnitSetPropertyFixed(uBoss, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(uBoss, c_unitPropLifeRegen, 10.0);
    UnitIssueOrder(uBoss, ordWp1, c_orderQueueReplace);
    UnitIssueOrder(uBoss, ordWp2, c_orderQueueAddToEnd);
    UnitIssueOrder(uBoss, ordFinal, c_orderQueueAddToEnd);

    // Crear escolta vanguardia
    i = 0;
    while (i < escortCount) {
        UnitCreate(1, escortType, 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        uEscort = UnitLastCreated();
        if (uEscort != null) {
            UnitSetPropertyFixed(uEscort, c_unitPropLifeMax, 
                UnitGetPropertyFixed(uEscort, c_unitPropLifeMax, true) * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
            UnitSetPropertyFixed(uEscort, c_unitPropLifePercent, 100.0);
            UnitIssueOrder(uEscort, ordWp1, c_orderQueueReplace);
            UnitIssueOrder(uEscort, ordWp2, c_orderQueueAddToEnd);
            UnitIssueOrder(uEscort, ordFinal, c_orderQueueAddToEnd);
        }
        i = i + 1;
    }

    // Notificación en pantalla
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat,
        StringToText("<b><c val=\"FF0044\">[AMENAZA TRIPARTITA] ¡Asalto Cronometrado de la Colmena!</c>\n<c val=\"FFFF00\">Comandante hostil al frente: " + bossName + "</c></b>"));
}

//--------------------------------------------------------------------------------------------------
// 3. Red de Gusanos Nydus en Cráteres: Emergen periódicamente vomitando hordas
//--------------------------------------------------------------------------------------------------
void SFE_CheckNydusNetwork () {
    int craterIdx;
    point cPos;
    unit u;
    fixed nydusHp;
    order ordMarch;
    int p;
    int i;
    unit spawned;

    // Si hay un Nydus vivo, verificar si sigue con vida
    if (g_sfeNydusAlive) {
        if (!UnitIsAlive(g_sfeCurrentNydusWorm)) {
            g_sfeNydusAlive = false;
            g_sfeCurrentNydusWorm = null;
            g_sfeNextNydusSeconds = g_sfeGameElapsedSeconds + 90;

            // Recompensa a los jugadores por destruir el Gusano Nydus
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat,
                StringToText("<b><c val=\"00FF7F\">[RED NYDUS] ¡Gusano Nydus destruido! (+350 Min / +150 XP para el escuadrón)</c></b>"));

            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                if (PlayerType(p) == c_playerTypeUser) {
                    PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 350);
                    SFE_HeroAddExperience(p, 150);
                    SFE_UpdatePlayerHUD(p);
                }
                p = p + 1;
            }
            return;
        }

        // Si está vivo, vomitar refuerzos cada 15 segundos
        if (g_sfeGameElapsedSeconds % 15 == 0) {
            cPos = UnitGetPosition(g_sfeCurrentNydusWorm);
            ordMarch = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint);

            i = 0;
            while (i < 4) {
                UnitCreate(1, "Zergling", 0, c_SFE_PLAYER_HOSTILE, cPos, 270.0);
                spawned = UnitLastCreated();
                if (spawned != null) {
                    UnitIssueOrder(spawned, ordMarch, c_orderQueueReplace);
                }
                i = i + 1;
            }
            UnitCreate(1, "Roach", 0, c_SFE_PLAYER_HOSTILE, cPos, 270.0);
            spawned = UnitLastCreated();
            if (spawned != null) {
                UnitIssueOrder(spawned, ordMarch, c_orderQueueReplace);
            }
        }
        return;
    }

    // Si no hay Nydus vivo, comprobar si es hora de generar uno nuevo
    if (g_sfeGameElapsedSeconds >= g_sfeNextNydusSeconds) {
        craterIdx = RandomInt(0, 3);
        cPos = g_sfeNydusCraterPoints[craterIdx];

        UnitCreate(1, "NydusCanal", 0, c_SFE_PLAYER_HOSTILE, cPos, 270.0);
        u = UnitLastCreated();
        if (u == null) {
            UnitCreate(1, "NydusWorm", 0, c_SFE_PLAYER_HOSTILE, cPos, 270.0);
            u = UnitLastCreated();
        }
        if (u == null) {
            UnitCreate(1, "SpineCrawler", 0, c_SFE_PLAYER_HOSTILE, cPos, 270.0);
            u = UnitLastCreated();
        }

        g_sfeCurrentNydusWorm = u;
        g_sfeNydusAlive = true;

        nydusHp = 3500.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
        UnitSetPropertyFixed(g_sfeCurrentNydusWorm, c_unitPropLifeMax, nydusHp);
        UnitSetPropertyFixed(g_sfeCurrentNydusWorm, c_unitPropLifePercent, 100.0);
        UnitSetPropertyFixed(g_sfeCurrentNydusWorm, c_unitPropLifeRegen, 5.0);

        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle,
            StringToText("<b><c val=\"FF8800\">[RED NYDUS] ¡Un Gusano Nydus ha emergido en el cráter territorial! ¡Destrúyelo!</c></b>"));
    }
}

//==================================================================================================
// Special Forces Elite 5 - HUD & Tech Shop System
// Panel en pantalla para asignación interactiva de atributos [+] y Tienda Tecnológica
//==================================================================================================



// Panel HUD individual de Atributos (por jugador)
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudDialog;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudLblHeroInfo;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudLblStrength;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudLblDexterity;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudLblIntel;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudLblPoints;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudBtnAddStr;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudBtnAddDex;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudBtnAddInt;
int[c_SFE_MAX_PLAYERS + 1] g_sfeHudBtnOpenShop;

// Barra superior global de estado de la partida
int g_sfeTopBarDialog;
int g_sfeTopBarLblWave;
int g_sfeTopBarLblBaseHp;
int g_sfeTopBarLblDiff;

// Tienda de Mejoras Tecnológicas
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopDialog;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnWeapons;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnArmor;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnShields;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnMedkit;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnBaseRepair;
int[c_SFE_MAX_PLAYERS + 1] g_sfeShopBtnClose;

// Declaraciones de funciones
void SFE_UpdatePlayerHUD (int player);
void SFE_UpdateTopBarHUD ();
void SFE_OpenShop (int player);
void SFE_CloseShop (int player);

//--------------------------------------------------------------------------------------------------
// Actualizar Valores del HUD para un Jugador
//--------------------------------------------------------------------------------------------------
void SFE_UpdatePlayerHUD (int player) {
    playergroup pg;
    text txtInfo;
    text txtStr;
    text txtDex;
    text txtInt;
    text txtPts;
    int hid;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeHeroStates[player].isActive) {
        return;
    }

    pg = PlayerGroupSingle(player);
    hid = g_sfeHeroStates[player].heroId;

    txtInfo = StringToText("<b><c val=\"FFE400\">" + g_sfeHeroes[hid].name + 
        "</c> | Nvl " + IntToString(g_sfeHeroStates[player].level) + 
        " <c val=\"AAAAAA\">(" + IntToString(g_sfeHeroStates[player].currentXp) + "/" + IntToString(g_sfeHeroStates[player].requiredXp) + " XP)</c></b>");

    txtStr = StringToText("<b><c val=\"FF4444\">Fuerza: " + IntToString(g_sfeHeroStates[player].strength) + 
        "</c> <c val=\"AAAAAA\">(+" + FixedToString(g_sfeHeroStates[player].strength * c_FACTOR_ALPHA_STRENGTH_DAMAGE, 1) + " Dmg)</c></b>");

    txtDex = StringToText("<b><c val=\"55FF55\">Destreza: " + IntToString(g_sfeHeroStates[player].dexterity) + 
        "</c> <c val=\"AAAAAA\">(Cadencia " + FixedToString(g_sfeHeroStates[player].currentAttackInterval, 2) + "s)</c></b>");

    txtInt = StringToText("<b><c val=\"00CCFF\">Inteligencia: " + IntToString(g_sfeHeroStates[player].intelligence) + 
        "</c> <c val=\"AAAAAA\">(+" + FixedToString(g_sfeHeroStates[player].intelligence * c_FACTOR_LAMBDA_INTEL_ENERGY, 0) + " Maná)</c></b>");

    if (g_sfeHeroStates[player].unspentAttributePoints > 0) {
        txtPts = StringToText("<b><c val=\"FFFF00\">¡Puntos Disponibles: " + IntToString(g_sfeHeroStates[player].unspentAttributePoints) + "!</c></b>");
    } else {
        txtPts = StringToText("<b><c val=\"888888\">Puntos Disponibles: 0</c></b>");
    }

    DialogControlSetPropertyAsText(g_sfeHudLblHeroInfo[player], c_triggerControlPropertyText, pg, txtInfo);
    DialogControlSetPropertyAsText(g_sfeHudLblStrength[player], c_triggerControlPropertyText, pg, txtStr);
    DialogControlSetPropertyAsText(g_sfeHudLblDexterity[player], c_triggerControlPropertyText, pg, txtDex);
    DialogControlSetPropertyAsText(g_sfeHudLblIntel[player], c_triggerControlPropertyText, pg, txtInt);
    DialogControlSetPropertyAsText(g_sfeHudLblPoints[player], c_triggerControlPropertyText, pg, txtPts);
}

//--------------------------------------------------------------------------------------------------
// Actualizar Barra Superior de Estado Global
//--------------------------------------------------------------------------------------------------
void SFE_UpdateTopBarHUD () {
    text txtWave;
    text txtBase;
    text txtDiff;
    string diffColor;

    if (g_sfeCurrentDifficulty == c_DIFF_TORMENT) {
        diffColor = "FF0044";
    } else if (g_sfeCurrentDifficulty >= c_DIFF_BRUTAL) {
        diffColor = "FF8800";
    } else {
        diffColor = "00FFEA";
    }

    txtDiff = StringToText("<b><c val=\"" + diffColor + "\">[" + g_sfeDiffNames[g_sfeCurrentDifficulty] + "]</c></b>");
    txtWave = StringToText("<b><c val=\"FFFFFF\">Oleada " + IntToString(g_sfeCurrentWaveNumber) + " / 25</c>  |  <c val=\"FFAA00\">Próxima: " + IntToString(g_sfeWaveTimeRemaining) + "s</c></b>");

    if (g_sfeBaseCoreHpPercent < 35.0) {
        txtBase = StringToText("<b><c val=\"FF0000\">¡ALERTA BASE!: " + FixedToString(g_sfeBaseCoreHpPercent, 0) + "%</c></b>");
    } else {
        txtBase = StringToText("<b><c val=\"55FF55\">Núcleo Base: " + FixedToString(g_sfeBaseCoreHpPercent, 0) + "%</c></b>");
    }

    DialogControlSetPropertyAsText(g_sfeTopBarLblDiff, c_triggerControlPropertyText, PlayerGroupAll(), txtDiff);
    DialogControlSetPropertyAsText(g_sfeTopBarLblWave, c_triggerControlPropertyText, PlayerGroupAll(), txtWave);
    DialogControlSetPropertyAsText(g_sfeTopBarLblBaseHp, c_triggerControlPropertyText, PlayerGroupAll(), txtBase);
}

//--------------------------------------------------------------------------------------------------
// Abrir y Cerrar Tienda de Mejoras
//--------------------------------------------------------------------------------------------------
void SFE_OpenShop (int player) {
    if (player >= 1 && player <= c_SFE_MAX_PLAYERS) {
        DialogSetVisible(g_sfeShopDialog[player], PlayerGroupSingle(player), true);
    }
}

void SFE_CloseShop (int player) {
    if (player >= 1 && player <= c_SFE_MAX_PLAYERS) {
        DialogSetVisible(g_sfeShopDialog[player], PlayerGroupSingle(player), false);
    }
}

//--------------------------------------------------------------------------------------------------
// Procesar Compras en la Tienda Tecnológica
//--------------------------------------------------------------------------------------------------
void SFE_ProcessShopPurchase (int player, int itemType) {
    int cost;
    int minerals;
    unit u;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeHeroStates[player].isActive) {
        return;
    }

    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    u = g_sfeHeroStates[player].heroUnit;

    if (itemType == 1) {
        // Calibre Pesado (+6 Daño permanente)
        cost = 350;
        if (minerals >= cost) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfeHeroStates[player].strength = g_sfeHeroStates[player].strength + 4;
            SFE_RecalculateStats(player);
            SFE_UpdatePlayerHUD(player);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"55FF55\">Mejora de Armamento adquirida (+6 Dmg permanente).</c>"));
        } else {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes (Requiere 350 min).</c>"));
        }
    } else if (itemType == 2) {
        // Placas de Blindaje (+100 HP permanente)
        cost = 300;
        if (minerals >= cost) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfeHeroStates[player].strength = g_sfeHeroStates[player].strength + 4;
            SFE_RecalculateStats(player);
            SFE_UpdatePlayerHUD(player);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"55FF55\">Blindaje reforzado adquirido (+100 HP max).</c>"));
        } else {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes (Requiere 300 min).</c>"));
        }
    } else if (itemType == 3) {
        // Botiquín Nanomédico (Restaura 100% Vida)
        cost = 150;
        if (minerals >= cost) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"55FF55\">¡Botiquín Nanomédico aplicado! Salud restaurada al 100%.</c>"));
        } else {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes (Requiere 150 min).</c>"));
        }
    } else if (itemType == 4) {
        // Reparación de Emergencia del Núcleo de Base (+25% HP)
        cost = 500;
        if (minerals >= cost) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            g_sfeBaseCoreHpPercent = g_sfeBaseCoreHpPercent + 25.0;
            if (g_sfeBaseCoreHpPercent > 100.0) {
                g_sfeBaseCoreHpPercent = 100.0;
            }
            SFE_UpdateTopBarHUD();
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"00FFEA\">¡Jugador " + IntToString(player) + " ha reparado el Núcleo Aliado (+25% Vida)!</c>"));
        } else {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, StringToText("<c val=\"FF4444\">Minerales insuficientes (Requiere 500 min).</c>"));
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Interacciones del HUD y Tienda
//--------------------------------------------------------------------------------------------------
bool gt_SFE_HUD_Click_Func (bool testConds, bool runActions) {
    int clickedCtrl;
    int player;

    if (!runActions) {
        return true;
    }

    clickedCtrl = EventDialogControl();
    player = EventPlayer();

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return true;
    }

    // Botones de asignación de atributos
    if (clickedCtrl == g_sfeHudBtnAddStr[player]) {
        if (SFE_AllocateAttribute(player, c_ATTR_STRENGTH)) {
            SFE_UpdatePlayerHUD(player);
        }
        return true;
    }
    if (clickedCtrl == g_sfeHudBtnAddDex[player]) {
        if (SFE_AllocateAttribute(player, c_ATTR_DEXTERITY)) {
            SFE_UpdatePlayerHUD(player);
        }
        return true;
    }
    if (clickedCtrl == g_sfeHudBtnAddInt[player]) {
        if (SFE_AllocateAttribute(player, c_ATTR_INTELLIGENCE)) {
            SFE_UpdatePlayerHUD(player);
        }
        return true;
    }

    // Botón de Abrir Consola de Jugador
    if (clickedCtrl == g_sfeHudBtnOpenShop[player]) {
        SFE_TogglePlayerConsole(player);
        return true;
    }

    // Botones de la Tienda
    if (clickedCtrl == g_sfeShopBtnWeapons[player]) {
        SFE_ProcessShopPurchase(player, 1);
        return true;
    }
    if (clickedCtrl == g_sfeShopBtnArmor[player]) {
        SFE_ProcessShopPurchase(player, 2);
        return true;
    }
    if (clickedCtrl == g_sfeShopBtnMedkit[player]) {
        SFE_ProcessShopPurchase(player, 3);
        return true;
    }
    if (clickedCtrl == g_sfeShopBtnBaseRepair[player]) {
        SFE_ProcessShopPurchase(player, 4);
        return true;
    }
    if (clickedCtrl == g_sfeShopBtnClose[player]) {
        SFE_CloseShop(player);
        return true;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Inicializar Interfaces HUD
//--------------------------------------------------------------------------------------------------
void SFE_InitHUD () {
    trigger tClick;
    int p;
    playergroup pg;

    p = 1;
    tClick = TriggerCreate("gt_SFE_HUD_Click_Func");

    // 1. Barra superior global de estado
    g_sfeTopBarDialog = DialogCreate(700, 75, c_anchorTop, 0, 10, false);
    DialogSetImage(g_sfeTopBarDialog, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    g_sfeTopBarLblDiff = DialogControlCreate(g_sfeTopBarDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeTopBarLblDiff, PlayerGroupAll(), 660, 25);
    DialogControlSetPosition(g_sfeTopBarLblDiff, PlayerGroupAll(), c_anchorTop, 0, 5);

    g_sfeTopBarLblWave = DialogControlCreate(g_sfeTopBarDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeTopBarLblWave, PlayerGroupAll(), 350, 25);
    DialogControlSetPosition(g_sfeTopBarLblWave, PlayerGroupAll(), c_anchorBottomLeft, 20, 10);

    g_sfeTopBarLblBaseHp = DialogControlCreate(g_sfeTopBarDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeTopBarLblBaseHp, PlayerGroupAll(), 280, 25);
    DialogControlSetPosition(g_sfeTopBarLblBaseHp, PlayerGroupAll(), c_anchorBottomRight, 20, 10);

    DialogSetVisible(g_sfeTopBarDialog, PlayerGroupAll(), true);

    // 2. Paneles HUD y Tiendas para cada jugador
    while (p <= c_SFE_MAX_PLAYERS) {
        pg = PlayerGroupSingle(p);

        // Panel HUD de Atributos (Superior Izquierda)
        g_sfeHudDialog[p] = DialogCreate(380, 240, c_anchorTopLeft, 20, 90, false);
        DialogSetImage(g_sfeHudDialog[p], "Assets\\Textures\\ui_glue_backgrounddialog.dds");

        g_sfeHudLblHeroInfo[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeHudLblHeroInfo[p], pg, 360, 25);
        DialogControlSetPosition(g_sfeHudLblHeroInfo[p], pg, c_anchorTopLeft, 10, 10);

        // Fila Fuerza
        g_sfeHudLblStrength[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeHudLblStrength[p], pg, 280, 28);
        DialogControlSetPosition(g_sfeHudLblStrength[p], pg, c_anchorTopLeft, 10, 42);

        g_sfeHudBtnAddStr[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHudBtnAddStr[p], pg, 70, 36);
        DialogControlSetPosition(g_sfeHudBtnAddStr[p], pg, c_anchorTopLeft, 295, 38);
        DialogControlSetPropertyAsText(g_sfeHudBtnAddStr[p], c_triggerControlPropertyText, pg, StringToText("+ F"));

        // Fila Destreza
        g_sfeHudLblDexterity[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeHudLblDexterity[p], pg, 280, 28);
        DialogControlSetPosition(g_sfeHudLblDexterity[p], pg, c_anchorTopLeft, 10, 80);

        g_sfeHudBtnAddDex[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHudBtnAddDex[p], pg, 70, 36);
        DialogControlSetPosition(g_sfeHudBtnAddDex[p], pg, c_anchorTopLeft, 295, 76);
        DialogControlSetPropertyAsText(g_sfeHudBtnAddDex[p], c_triggerControlPropertyText, pg, StringToText("+ D"));

        // Fila Inteligencia
        g_sfeHudLblIntel[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeHudLblIntel[p], pg, 280, 28);
        DialogControlSetPosition(g_sfeHudLblIntel[p], pg, c_anchorTopLeft, 10, 118);

        g_sfeHudBtnAddInt[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHudBtnAddInt[p], pg, 70, 36);
        DialogControlSetPosition(g_sfeHudBtnAddInt[p], pg, c_anchorTopLeft, 295, 114);
        DialogControlSetPropertyAsText(g_sfeHudBtnAddInt[p], c_triggerControlPropertyText, pg, StringToText("+ I"));

        // Puntos disponibles y Botón de Tienda
        g_sfeHudLblPoints[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeHudLblPoints[p], pg, 230, 30);
        DialogControlSetPosition(g_sfeHudLblPoints[p], pg, c_anchorTopLeft, 10, 160);

        g_sfeHudBtnOpenShop[p] = DialogControlCreate(g_sfeHudDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHudBtnOpenShop[p], pg, 130, 36);
        DialogControlSetPosition(g_sfeHudBtnOpenShop[p], pg, c_anchorTopLeft, 235, 157);
        DialogControlSetPropertyAsText(g_sfeHudBtnOpenShop[p], c_triggerControlPropertyText, pg, StringToText("<c val=\"FFE400\">CONSOLA [Alt+C]</c>"));

        DialogSetVisible(g_sfeHudDialog[p], pg, true);

        // Diálogo de la Tienda de Mejoras
        g_sfeShopDialog[p] = DialogCreate(500, 380, c_anchorCenter, 0, 0, false);
        DialogSetImage(g_sfeShopDialog[p], "Assets\\Textures\\ui_glue_backgrounddialog.dds");

        // Título Tienda
        DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeLabel);
        DialogControlSetSize(DialogControlLastCreated(), pg, 460, 35);
        DialogControlSetPosition(DialogControlLastCreated(), pg, c_anchorTop, 0, 15);
        DialogControlSetPropertyAsText(DialogControlLastCreated(), c_triggerControlPropertyText, pg, 
            StringToText("<b><c val=\"FFE400\">ARSENAL Y MEJORAS TÁCTICAS</c></b>"));

        // Opciones Tienda
        g_sfeShopBtnWeapons[p] = DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeShopBtnWeapons[p], pg, 440, 45);
        DialogControlSetPosition(g_sfeShopBtnWeapons[p], pg, c_anchorTop, 0, 65);
        DialogControlSetPropertyAsText(g_sfeShopBtnWeapons[p], c_triggerControlPropertyText, pg, 
            StringToText("Calibre Pesado (+6 Daño permanente) — <c val=\"55FF55\">350 Min</c>"));

        g_sfeShopBtnArmor[p] = DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeShopBtnArmor[p], pg, 440, 45);
        DialogControlSetPosition(g_sfeShopBtnArmor[p], pg, c_anchorTop, 0, 120);
        DialogControlSetPropertyAsText(g_sfeShopBtnArmor[p], c_triggerControlPropertyText, pg, 
            StringToText("Placas de Blindaje (+100 HP permanente) — <c val=\"55FF55\">300 Min</c>"));

        g_sfeShopBtnMedkit[p] = DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeShopBtnMedkit[p], pg, 440, 45);
        DialogControlSetPosition(g_sfeShopBtnMedkit[p], pg, c_anchorTop, 0, 175);
        DialogControlSetPropertyAsText(g_sfeShopBtnMedkit[p], c_triggerControlPropertyText, pg, 
            StringToText("Botiquín Nanomédico (Cura 100% Vida) — <c val=\"55FF55\">150 Min</c>"));

        g_sfeShopBtnBaseRepair[p] = DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeShopBtnBaseRepair[p], pg, 440, 45);
        DialogControlSetPosition(g_sfeShopBtnBaseRepair[p], pg, c_anchorTop, 0, 230);
        DialogControlSetPropertyAsText(g_sfeShopBtnBaseRepair[p], c_triggerControlPropertyText, pg, 
            StringToText("Reparación del Núcleo Aliado (+25% HP Base) — <c val=\"55FF55\">500 Min</c>"));

        g_sfeShopBtnClose[p] = DialogControlCreate(g_sfeShopDialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeShopBtnClose[p], pg, 180, 40);
        DialogControlSetPosition(g_sfeShopBtnClose[p], pg, c_anchorBottom, 0, 15);
        DialogControlSetPropertyAsText(g_sfeShopBtnClose[p], c_triggerControlPropertyText, pg, StringToText("CERRAR"));

        DialogSetVisible(g_sfeShopDialog[p], pg, false);

        // Conectar Eventos
        TriggerAddEventDialogControl(tClick, p, g_sfeHudBtnAddStr[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeHudBtnAddDex[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeHudBtnAddInt[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeHudBtnOpenShop[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeShopBtnWeapons[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeShopBtnArmor[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeShopBtnMedkit[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeShopBtnBaseRepair[p], c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(tClick, p, g_sfeShopBtnClose[p], c_triggerControlEventTypeClick);

        p = p + 1;
    }
}

//==================================================================================================
// Special Forces Elite 5 - Hero Selection System
// Interfaz de diálogo avanzada: 12 héroes canónicos, previsualización táctica, cuenta atrás de 45s
// y selección aleatoria (con 1% de easter egg de héroes secretos satíricos)
//==================================================================================================



// Variables de UI
int g_sfeSelectDialog;
int g_sfeSelectTimerLabel;
int[c_HERO_CANONICAL_COUNT] g_sfeHeroButtons;
int g_sfeBtnConfirm;
int g_sfeBtnRandom;

int g_sfePreviewName;
int g_sfePreviewArchetype;
int g_sfePreviewDesc;
int g_sfePreviewStats;

int[c_SFE_MAX_PLAYERS + 1] g_sfePlayerSelectedHeroId;
bool[c_SFE_MAX_PLAYERS + 1] g_sfePlayerHasConfirmed;
timer g_sfeSelectCountdownTimer;
int g_sfeSelectSecondsRemaining;

// Declaraciones adelantadas de funciones
void SFE_UpdateHeroPreview (int player, int heroId);
void SFE_ConfirmHeroSelection (int player, int heroId);
void SFE_HeroSelectionRandom (int player);

//--------------------------------------------------------------------------------------------------
// Actualizar Panel de Previsualización para un Jugador
//--------------------------------------------------------------------------------------------------
void SFE_UpdateHeroPreview (int player, int heroId) {
    playergroup pg;
    text txtName;
    text txtArchetype;
    text txtDesc;
    text txtStats;
    string attrName;

    if (heroId < 0 || heroId >= c_HERO_TOTAL_COUNT) {
        return;
    }

    pg = PlayerGroupSingle(player);
    g_sfePlayerSelectedHeroId[player] = heroId;

    if (g_sfeHeroes[heroId].primaryAttribute == c_ATTR_STRENGTH) {
        attrName = "FUERZA (HP + Daño)";
    } else if (g_sfeHeroes[heroId].primaryAttribute == c_ATTR_DEXTERITY) {
        attrName = "DESTREZA (Cadencia + Regen)";
    } else {
        attrName = "INTELIGENCIA (Maná + Visión)";
    }

    txtName = StringToText("<b><c val=\"FFE400\">" + g_sfeHeroes[heroId].name + "</c> <c val=\"AAAAAA\">(" + g_sfeHeroes[heroId].faction + ")</c></b>");
    txtArchetype = StringToText("<b><c val=\"00FFEA\">Rol:</c> " + g_sfeHeroes[heroId].archetype + "  |  <c val=\"FFB700\">Atributo:</c> " + attrName + "</b>");
    txtDesc = StringToText("<b>" + g_sfeHeroes[heroId].description + "</b>");
    
    txtStats = StringToText("<b><c val=\"55FF55\">Vida Base:</c> " + FixedToString(g_sfeHeroes[heroId].baseHp, 0) + 
        "   |   <c val=\"00CCFF\">Escudos:</c> " + FixedToString(g_sfeHeroes[heroId].baseShields, 0) + 
        "   |   <c val=\"CC88FF\">Energía:</c> " + FixedToString(g_sfeHeroes[heroId].baseEnergy, 0) + 
        "\n<c val=\"FF4444\">Daño Base:</c> " + FixedToString(g_sfeHeroes[heroId].baseDamage, 0) + 
        "   |   <c val=\"FFFF44\">Intervalo Ataque:</c> " + FixedToString(g_sfeHeroes[heroId].baseAttackInterval, 2) + "s" + 
        "   |   <c val=\"AAAAAA\">Blindaje:</c> " + FixedToString(g_sfeHeroes[heroId].baseArmor, 0) + "</b>");

    DialogControlSetPropertyAsText(g_sfePreviewName, c_triggerControlPropertyText, pg, txtName);
    DialogControlSetPropertyAsText(g_sfePreviewArchetype, c_triggerControlPropertyText, pg, txtArchetype);
    DialogControlSetPropertyAsText(g_sfePreviewDesc, c_triggerControlPropertyText, pg, txtDesc);
    DialogControlSetPropertyAsText(g_sfePreviewStats, c_triggerControlPropertyText, pg, txtStats);
}

//--------------------------------------------------------------------------------------------------
// Confirmar Selección y Desplegar Héroe
//--------------------------------------------------------------------------------------------------
void SFE_ConfirmHeroSelection (int player, int heroId) {
    unit u;
    string unitType;
    text announce;
    point pSpawn;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || g_sfePlayerHasConfirmed[player]) {
        return;
    }

    g_sfePlayerHasConfirmed[player] = true;
    unitType = g_sfeHeroes[heroId].unitType;
    pSpawn = Point(38.0, 38.0);

    // Despliegue de la unidad
    UnitCreate(1, unitType, 0, player, pSpawn, 90.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, g_sfeHeroes[heroId].fallbackUnitType, 0, player, pSpawn, 90.0);
        u = UnitLastCreated();
    }

    // Inicializar atributos matemáticos del héroe
    SFE_InitHeroAttributes(player, u, heroId);

    // Centrar cámara y seleccionar unidad
    CameraPan(player, pSpawn, 0.4, -1, 10.0, false);
    UnitSelect(u, player, true);

    // Ocultar diálogo para este jugador
    DialogSetVisible(g_sfeSelectDialog, PlayerGroupSingle(player), false);

    // Anuncio a toda la partida
    announce = StringToText("<c val=\"00FF7F\">Jugador " + IntToString(player) + " ha seleccionado a </c><c val=\"FFE400\">" + g_sfeHeroes[heroId].name + "</c> <c val=\"AAAAAA\">(" + g_sfeHeroes[heroId].archetype + ")</c>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, announce);
}

//--------------------------------------------------------------------------------------------------
// Selección Aleatoria (1% probabilidad de héroes satíricos secretos)
//--------------------------------------------------------------------------------------------------
void SFE_HeroSelectionRandom (int player) {
    int roll;
    int pickedHero;
    int secretIdx;

    if (g_sfePlayerHasConfirmed[player]) {
        return;
    }

    roll = RandomInt(1, 100);
    if (roll == 100) {
        // 1% Easter Egg Satírico (Dr. Evil, Donald Trump, Alex Jones)
        secretIdx = RandomInt(c_HERO_SECRET_EVIL, c_HERO_SECRET_JONES);
        pickedHero = secretIdx;
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<b><c val=\"FF00FF\">¡¡EVENTO ESPECIAL!! ¡Jugador " + IntToString(player) + " ha obtenido a " + g_sfeHeroes[secretIdx].name + " (1% Probabilidad)!</c></b>"));
    } else {
        // Uno de los 12 héroes canónicos
        pickedHero = RandomInt(0, c_HERO_CANONICAL_COUNT - 1);
    }

    SFE_ConfirmHeroSelection(player, pickedHero);
}

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Clic en Controles del Diálogo
//--------------------------------------------------------------------------------------------------
bool gt_SFE_HeroSelection_Click_Func (bool testConds, bool runActions) {
    int clickedCtrl;
    int player;
    int i;

    if (!runActions) {
        return true;
    }

    clickedCtrl = EventDialogControl();
    player = EventPlayer();
    i = 0;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || g_sfePlayerHasConfirmed[player]) {
        return true;
    }

    // Revisar si pulsó algún héroe de la matriz
    while (i < c_HERO_CANONICAL_COUNT) {
        if (clickedCtrl == g_sfeHeroButtons[i]) {
            SFE_UpdateHeroPreview(player, i);
            return true;
        }
        i = i + 1;
    }

    // Botón de Confirmar
    if (clickedCtrl == g_sfeBtnConfirm) {
        SFE_ConfirmHeroSelection(player, g_sfePlayerSelectedHeroId[player]);
        return true;
    }

    // Botón de Aleatorio
    if (clickedCtrl == g_sfeBtnRandom) {
        SFE_HeroSelectionRandom(player);
        return true;
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Trigger Callback: Temporizador de Cuenta Atrás de Selección (45s)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_HeroSelection_Timer_Func (bool testConds, bool runActions) {
    int p;
    text timerText;

    if (!runActions) {
        return true;
    }

    p = 1;
    g_sfeSelectSecondsRemaining = g_sfeSelectSecondsRemaining - 1;
    timerText = StringToText("<b><c val=\"FF5555\">Tiempo restante para elegir:</c> " + IntToString(g_sfeSelectSecondsRemaining) + "s</b>");
    DialogControlSetPropertyAsText(g_sfeSelectTimerLabel, c_triggerControlPropertyText, PlayerGroupAll(), timerText);

    if (g_sfeSelectSecondsRemaining <= 0) {
        // Tiempo agotado: forzar selección aleatoria para quienes falten
        while (p <= c_SFE_MAX_PLAYERS) {
            if (PlayerType(p) == c_playerTypeUser && !g_sfePlayerHasConfirmed[p]) {
                SFE_HeroSelectionRandom(p);
            }
            p = p + 1;
        }
        DialogSetVisible(g_sfeSelectDialog, PlayerGroupAll(), false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Creación del Diálogo de Selección de Héroes
//--------------------------------------------------------------------------------------------------
void SFE_InitHeroSelectionUI () {
    trigger tClick;
    trigger tTimer;
    int row;
    int col;
    int i;
    int btnX;
    int btnY;
    int p;

    g_sfeSelectSecondsRemaining = 45;

    // Crear Diálogo principal
    g_sfeSelectDialog = DialogCreate(1140, 700, c_anchorCenter, 0, 0, true);
    DialogSetImage(g_sfeSelectDialog, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    // Título superior
    DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(DialogControlLastCreated(), PlayerGroupAll(), 1100, 45);
    DialogControlSetPosition(DialogControlLastCreated(), PlayerGroupAll(), c_anchorTop, 0, 20);
    DialogControlSetPropertyAsText(DialogControlLastCreated(), c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<b><c val=\"00FFEA\">SPECIAL FORCES ELITE 5</c> — <c val=\"FFFFFF\">SELECCIÓN DE HÉROE</c></b>"));

    // Etiqueta del temporizador
    g_sfeSelectTimerLabel = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeSelectTimerLabel, PlayerGroupAll(), 600, 35);
    DialogControlSetPosition(g_sfeSelectTimerLabel, PlayerGroupAll(), c_anchorTop, 0, 68);
    DialogControlSetPropertyAsText(g_sfeSelectTimerLabel, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<b><c val=\"FF5555\">Tiempo restante para elegir:</c> 45s</b>"));

    // Matriz 3 filas x 4 columnas para los 12 héroes canónicos
    i = 0;
    while (i < c_HERO_CANONICAL_COUNT) {
        col = i % 4;
        row = i / 4;
        btnX = 40 + (col * 140);
        btnY = 125 + (row * 135);

        g_sfeHeroButtons[i] = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeHeroButtons[i], PlayerGroupAll(), 130, 120);
        DialogControlSetPosition(g_sfeHeroButtons[i], PlayerGroupAll(), c_anchorTopLeft, btnX, btnY);
        DialogControlSetPropertyAsText(g_sfeHeroButtons[i], c_triggerControlPropertyText, PlayerGroupAll(), 
            StringToText("<b>" + g_sfeHeroes[i].name + "\n<c val=\"AAAAAA\">(" + g_sfeHeroes[i].faction + ")</c></b>"));

        i = i + 1;
    }

    // Panel derecho: Ficha Técnica de Previsualización
    g_sfePreviewName = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewName, PlayerGroupAll(), 480, 40);
    DialogControlSetPosition(g_sfePreviewName, PlayerGroupAll(), c_anchorTopLeft, 630, 125);

    g_sfePreviewArchetype = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewArchetype, PlayerGroupAll(), 480, 35);
    DialogControlSetPosition(g_sfePreviewArchetype, PlayerGroupAll(), c_anchorTopLeft, 630, 170);

    g_sfePreviewDesc = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewDesc, PlayerGroupAll(), 480, 80);
    DialogControlSetPosition(g_sfePreviewDesc, PlayerGroupAll(), c_anchorTopLeft, 630, 215);

    g_sfePreviewStats = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfePreviewStats, PlayerGroupAll(), 480, 120);
    DialogControlSetPosition(g_sfePreviewStats, PlayerGroupAll(), c_anchorTopLeft, 630, 305);

    // Botón de Confirmar Selección
    g_sfeBtnConfirm = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeBtnConfirm, PlayerGroupAll(), 230, 55);
    DialogControlSetPosition(g_sfeBtnConfirm, PlayerGroupAll(), c_anchorTopLeft, 630, 480);
    DialogControlSetPropertyAsText(g_sfeBtnConfirm, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<b><c val=\"55FF55\">CONFIRMAR</c></b>"));

    // Botón de Selección Aleatoria (con 1% de héroe secreto)
    g_sfeBtnRandom = DialogControlCreate(g_sfeSelectDialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeBtnRandom, PlayerGroupAll(), 230, 55);
    DialogControlSetPosition(g_sfeBtnRandom, PlayerGroupAll(), c_anchorTopLeft, 880, 480);
    DialogControlSetPropertyAsText(g_sfeBtnRandom, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<b><c val=\"FFAA00\">ALEATORIO (1%)</c></b>"));

    // Conectar Triggers de Interacción
    tClick = TriggerCreate("gt_SFE_HeroSelection_Click_Func");
    i = 0;
    while (i < c_HERO_CANONICAL_COUNT) {
        TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeHeroButtons[i], c_triggerControlEventTypeClick);
        i = i + 1;
    }
    TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeBtnConfirm, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, c_playerAny, g_sfeBtnRandom, c_triggerControlEventTypeClick);

    // Inicializar previsualización predeterminada (Jim Raynor) para cada jugador
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        g_sfePlayerSelectedHeroId[p] = c_HERO_RAYNOR;
        g_sfePlayerHasConfirmed[p] = false;
        SFE_UpdateHeroPreview(p, c_HERO_RAYNOR);
        p = p + 1;
    }

    // Mostrar el diálogo
    DialogSetVisible(g_sfeSelectDialog, PlayerGroupAll(), true);

    // Temporizador de 1s para cuenta atrás
    g_sfeSelectCountdownTimer = TimerCreate();
    TimerStart(g_sfeSelectCountdownTimer, 1.0, true, c_timeGame);
    tTimer = TriggerCreate("gt_SFE_HeroSelection_Timer_Func");
    TriggerAddEventTimer(tTimer, g_sfeSelectCountdownTimer);
}

//==================================================================================================
// Special Forces Elite 5 - Wave Spawner & Hostile AI Engine
// Generador perimetral de 25 oleadas, nidos destructibles, escalado de estadísticas,
// curva de entropía (T_up) y asignación táctica hacia el núcleo
//==================================================================================================



const int c_TOTAL_WAVES = 25;

// Estructuras de Nidos Hostiles Destructibles
unit g_sfeOutpostNorth;
unit g_sfeOutpostEast;
unit g_sfeOutpostWest;

bool g_sfeOutpostNorthAlive;
bool g_sfeOutpostEastAlive;
bool g_sfeOutpostWestAlive;

// Puntos de aparición cardinales
point g_sfeSpawnNorth;
point g_sfeSpawnSouth;
point g_sfeSpawnEast;
point g_sfeSpawnWest;

// Temporizadores de oleada
timer g_sfeWaveTimer;
timer g_sfeWaveTickTimer;
timer g_sfeEntropyTimer;

// Bonificaciones acumulativas de entropía enemiga (T_up)
fixed g_sfeHostileArmorBonus;
fixed g_sfeHostileLifeBonusPct;

// Declaraciones de funciones
void SFE_SpawnWave (int waveNum);
void SFE_CheckOutpostStatus ();
void SFE_OrderHostilesToCore (unitgroup ug);
void SFE_TriggerBossMaarSpawn ();
void SFE_TriggerBossDestroyerSpawn ();
void SFE_TriggerBossDiabloSpawn ();

//--------------------------------------------------------------------------------------------------
// Inicializar Puntos de Rutas y Nidos de Asedio
//--------------------------------------------------------------------------------------------------
void SFE_InitWaveSpawner () {
    trigger tEntropy;

    // Puntos de generación en los extremos de los 3 caminos y la Gran Colmena
    g_sfeSpawnNorth = Point(55.0, 165.0); // Extremo Norte de la Ruta Noroeste
    g_sfeSpawnSouth = Point(165.0, 55.0); // Extremo Este de la Ruta Sureste
    g_sfeSpawnEast  = Point(140.0, 120.0);// Meseta Central Protoss
    g_sfeSpawnWest  = Point(165.0, 155.0);// Bastión de la Gran Colmena (Top-Right)

    g_sfeCurrentWaveNumber = 1;
    g_sfeWaveTimeRemaining = FixedToInt(g_sfeDiffWaveIntervalSeconds[g_sfeCurrentDifficulty]);

    g_sfeHostileArmorBonus = 0.0;
    g_sfeHostileLifeBonusPct = 0.0;

    // Crear los 3 reductos/nidos hostiles sobre los caminos (Jugador 15)
    // 1. Super Spawning Pool (Ruta Noroeste)
    UnitCreate(1, "SpawningPool", 0, c_SFE_PLAYER_HOSTILE, Point(35.0, 105.0), 270.0);
    g_sfeOutpostNorth = UnitLastCreated();
    if (g_sfeOutpostNorth == null) {
        UnitCreate(1, "Hive", 0, c_SFE_PLAYER_HOSTILE, Point(35.0, 105.0), 270.0);
        g_sfeOutpostNorth = UnitLastCreated();
    }
    UnitSetPropertyFixed(g_sfeOutpostNorth, c_unitPropLifeMax, 5000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostNorth, c_unitPropLifePercent, 100.0);
    g_sfeOutpostNorthAlive = true;

    // 2. Madriguera de Cucarachas / Roach Den (Ruta Sureste)
    UnitCreate(1, "RoachWarren", 0, c_SFE_PLAYER_HOSTILE, Point(90.0, 35.0), 180.0);
    g_sfeOutpostEast = UnitLastCreated();
    if (g_sfeOutpostEast == null) {
        UnitCreate(1, "Nexus", 0, c_SFE_PLAYER_HOSTILE, Point(90.0, 35.0), 180.0);
        g_sfeOutpostEast = UnitLastCreated();
    }
    UnitSetPropertyFixed(g_sfeOutpostEast, c_unitPropLifeMax, 5000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostEast, c_unitPropLifePercent, 100.0);
    g_sfeOutpostEastAlive = true;

    // 3. Base Protoss Corrompida (Ruta Central)
    UnitCreate(1, "Nexus", 0, c_SFE_PLAYER_HOSTILE, Point(115.0, 135.0), 225.0);
    g_sfeOutpostWest = UnitLastCreated();
    if (g_sfeOutpostWest == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_HOSTILE, Point(115.0, 135.0), 225.0);
        g_sfeOutpostWest = UnitLastCreated();
    }
    UnitSetPropertyFixed(g_sfeOutpostWest, c_unitPropLifeMax, 5000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(g_sfeOutpostWest, c_unitPropLifePercent, 100.0);
    g_sfeOutpostWestAlive = true;

    // Inicializar temporizador de evolución de entropía (T_up)
    g_sfeEntropyTimer = TimerCreate();
    TimerStart(g_sfeEntropyTimer, g_sfeDiffUpgradeIntervalSeconds[g_sfeCurrentDifficulty], true, c_timeGame);
    tEntropy = TriggerCreate("gt_SFE_EntropyUpgrade_Timer_Func");
    TriggerAddEventTimer(tEntropy, g_sfeEntropyTimer);
}

//--------------------------------------------------------------------------------------------------
// Enviar Grupo de Unidades Hostiles Siguiendo los Caminos Hacia el Núcleo
//--------------------------------------------------------------------------------------------------
void SFE_OrderHostilesAlongRoute (unitgroup ug, int routeType) {
    int i;
    int count;
    unit u;
    point wp1;
    point wp2;
    order ord1;
    order ord2;
    order ordFinal;

    count = UnitGroupCount(ug, c_unitCountAlive);
    if (count <= 0) {
        return;
    }

    if (routeType == 1) {
        // Ruta Noroeste: baja bordeando el flanco oeste hasta el cruce suroeste
        wp1 = Point(45.0, 95.0);
        wp2 = g_sfePlateauSouthWest;
    } else if (routeType == 2) {
        // Ruta Sureste: avanza por el flanco sur hacia la entrada este de la base
        wp1 = Point(105.0, 55.0);
        wp2 = Point(50.0, 35.0);
    } else if (routeType == 3) {
        // Ruta Central: desciende desde la meseta central hacia el cruce suroeste
        wp1 = Point(110.0, 105.0);
        wp2 = g_sfePlateauSouthWest;
    } else {
        // Ruta Colmena Final: cruza la meseta central y avanza al cruce suroeste
        wp1 = Point(135.0, 115.0);
        wp2 = g_sfePlateauSouthWest;
    }

    ord1 = OrderTargetingPoint(AbilityCommand("attack", 0), wp1);
    ord2 = OrderTargetingPoint(AbilityCommand("attack", 0), wp2);
    ordFinal = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint);

    i = 1;
    while (i <= count) {
        u = UnitGroupUnit(ug, i);
        UnitIssueOrder(u, ord1, c_orderQueueReplace);
        UnitIssueOrder(u, ord2, c_orderQueueAddToEnd);
        UnitIssueOrder(u, ordFinal, c_orderQueueAddToEnd);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Enviar Grupo de Unidades Hostiles Directo al Núcleo Aliado
//--------------------------------------------------------------------------------------------------
void SFE_OrderHostilesToCore (unitgroup ug) {
    int i;
    int count;
    unit u;
    order ordWp;
    order ordCore;

    count = UnitGroupCount(ug, c_unitCountAlive);
    if (count <= 0) {
        return;
    }

    ordWp = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest);
    ordCore = OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint);

    i = 1;
    while (i <= count) {
        u = UnitGroupUnit(ug, i);
        UnitIssueOrder(u, ordWp, c_orderQueueReplace);
        UnitIssueOrder(u, ordCore, c_orderQueueAddToEnd);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Desplegar Oleada Hostil a lo largo de las Rutas
//--------------------------------------------------------------------------------------------------
void SFE_SpawnWave (int waveNum) {
    unitgroup ugNorth;
    unitgroup ugSouth;
    unitgroup ugEast;
    unitgroup ugWest;
    fixed statMult;
    int countNorth;
    int countSouth;
    int countEast;
    int countWest;
    string uType1;
    string uType2;
    int k;
    unit u;

    ugNorth = UnitGroupEmpty();
    ugSouth = UnitGroupEmpty();
    ugEast  = UnitGroupEmpty();
    ugWest  = UnitGroupEmpty();

    statMult = g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty] * (1.0 + (g_sfeHostileLifeBonusPct / 100.0));
    countNorth = 4 + (waveNum * 2);
    countSouth = 4 + (waveNum * 2);
    countEast  = 4 + (waveNum * 2);
    countWest  = 4 + (waveNum * 2);

    // Selección escalonada de unidades según el número de oleada
    if (waveNum <= 5) {
        uType1 = "Zergling";
        uType2 = "Roach";
    } else if (waveNum <= 10) {
        uType1 = "Hydralisk";
        uType2 = "Marauder";
    } else if (waveNum <= 15) {
        uType1 = "Ultralisk";
        uType2 = "Immortal";
    } else if (waveNum <= 20) {
        uType1 = "Thor";
        uType2 = "Colossus";
    } else {
        uType1 = "HybridDestroyer";
        uType2 = "Aberration";
    }

    // Generar tropas en las 4 rutas
    k = 0;
    while (k < countNorth) {
        UnitCreate(1, uType1, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnNorth, 225.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ugNorth, u);
        k = k + 1;
    }

    k = 0;
    while (k < countSouth) {
        UnitCreate(1, uType2, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnSouth, 225.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ugSouth, u);
        k = k + 1;
    }

    k = 0;
    while (k < countEast) {
        UnitCreate(1, uType1, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnEast, 225.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ugEast, u);
        k = k + 1;
    }

    k = 0;
    while (k < countWest) {
        UnitCreate(1, uType2, 0, c_SFE_PLAYER_HOSTILE, g_sfeSpawnWest, 225.0);
        u = UnitLastCreated();
        UnitSetPropertyFixed(u, c_unitPropLifeMax, UnitGetPropertyFixed(u, c_unitPropLifeMax, false) * statMult);
        UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
        UnitGroupAdd(ugWest, u);
        k = k + 1;
    }

    // Ordenar avance por sus respectivas rutas tácticas
    SFE_OrderHostilesAlongRoute(ugNorth, 1);
    SFE_OrderHostilesAlongRoute(ugSouth, 2);
    SFE_OrderHostilesAlongRoute(ugEast, 3);
    SFE_OrderHostilesAlongRoute(ugWest, 4);

    // Eventos especiales de Jefes por hito de oleada
    if (waveNum == 10) {
        SFE_TriggerBossMaarSpawn();
    } else if (waveNum == 20) {
        SFE_TriggerBossDestroyerSpawn();
    } else if (waveNum == 25) {
        SFE_TriggerBossDiabloSpawn();
    }
}

//--------------------------------------------------------------------------------------------------
// Verificacion de Reductos Destruidos y Concesion de Recompensas
//--------------------------------------------------------------------------------------------------
void SFE_CheckOutpostStatus () {
    int p;
    text bountyText;

    if (g_sfeOutpostNorthAlive && g_sfeOutpostNorth != null && !UnitIsAlive(g_sfeOutpostNorth)) {
        g_sfeOutpostNorthAlive = false;
        bountyText = StringToText("<c val=\"FFE400\"><b>¡COLMENA ZERG NORTE DESTRUIDA! +1000 MINERALES PARA EL EQUIPO</b></c>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossMaarSpawn();
    }

    if (g_sfeOutpostEastAlive && g_sfeOutpostEast != null && !UnitIsAlive(g_sfeOutpostEast)) {
        g_sfeOutpostEastAlive = false;
        bountyText = StringToText("<c val=\"FFE400\"><b>¡FORTALEZA PROTOSS ESTE DESTRUIDA! +1000 MINERALES PARA EL EQUIPO</b></c>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossDestroyerSpawn();
    }

    if (g_sfeOutpostWestAlive && g_sfeOutpostWest != null && !UnitIsAlive(g_sfeOutpostWest)) {
        g_sfeOutpostWestAlive = false;
        bountyText = StringToText("<c val=\"FFE400\"><b>¡COMPLEJO INFESTADO OESTE DESTRUIDO! +1000 MINERALES PARA EL EQUIPO</b></c>");
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, bountyText);

        p = 1;
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1000);
            p = p + 1;
        }
        SFE_TriggerBossDiabloSpawn();
    }
}

//--------------------------------------------------------------------------------------------------
// Bucle de Entropía: Mejoras Periódicas de la IA Hostil (T_up)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_EntropyUpgrade_Timer_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    g_sfeHostileArmorBonus = g_sfeHostileArmorBonus + 1.0;
    g_sfeHostileLifeBonusPct = g_sfeHostileLifeBonusPct + 10.0;

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, 
        StringToText("<c val=\"FF4444\">[Evolución Hostil T_up] +1 Blindaje / +10% Vitalidad enemiga acumulada</c>"));

    return true;
}

//--------------------------------------------------------------------------------------------------
// Bucle del Temporizador de Oleadas (Tick cada 1 segundo)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_WaveLoop_Timer_Func (bool testConds, bool runActions) {
    int p;

    if (!runActions) {
        return true;
    }

    g_sfeWaveTimeRemaining = g_sfeWaveTimeRemaining - 1;

    // Actualizar estado de salud de la base, curación y HUD
    SFE_UpdateBaseHealthStatus();
    SFE_BaseHealHeroesTick();
    SFE_CheckOutpostStatus();
    SFE_UpdateTopBarHUD();

    // Actualizar bucles de Buffs y Autocast de mejoras
    SFE_PeriodicBuffTick();
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_RunUpgradeAutocast(p);
        }
        p = p + 1;
    }

    // Actualizar bucle por segundo de la Amenaza Tripartita
    SFE_TripartiteTickSecond();

    if (g_sfeWaveTimeRemaining <= 0) {
        // Desplegar oleada
        SFE_SpawnWave(g_sfeCurrentWaveNumber);

        g_sfeCurrentWaveNumber = g_sfeCurrentWaveNumber + 1;
        if (g_sfeCurrentWaveNumber > c_TOTAL_WAVES) {
            g_sfeCurrentWaveNumber = c_TOTAL_WAVES;
        }

        // Reiniciar tiempo según dificultad
        g_sfeWaveTimeRemaining = FixedToInt(g_sfeDiffWaveIntervalSeconds[g_sfeCurrentDifficulty]);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Recompensa de Minerales y XP por Enemigo Eliminado (Last Hit)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_UnitDied_Reward_Func (bool testConds, bool runActions) {
    unit dyingU;
    unit killerU;
    int killerPlayer;
    int dyingPlayer;
    int bounty;

    if (!runActions) {
        return true;
    }

    dyingU = EventUnit();
    killerU = EventUnitDamageSourceUnit();
    dyingPlayer = UnitGetOwner(dyingU);

    // Muerte de Héroe Aliado: reembolso y pérdida de buffs
    if (dyingPlayer >= 1 && dyingPlayer <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[dyingPlayer].isActive && dyingU == g_sfeHeroStates[dyingPlayer].heroUnit) {
            SFE_OnHeroDeathRefundBuffs(dyingPlayer);
            SFE_UpdatePlayerHUD(dyingPlayer);
        }
    }

    if (dyingPlayer != c_SFE_PLAYER_HOSTILE) {
        return true;
    }

    killerPlayer = UnitGetOwner(killerU);
    if (killerPlayer >= 1 && killerPlayer <= c_SFE_MAX_PLAYERS) {
        // Recompensa en minerales escalada por la dificultad (M_inc)
        bounty = FixedToInt(15.0 * g_sfeDiffIncomeMultiplier[g_sfeCurrentDifficulty]);
        if (bounty < 5) {
            bounty = 5;
        }

        PlayerModifyPropertyInt(killerPlayer, c_playerPropMinerals, c_playerPropOperAdd, bounty);
        SFE_HeroAddExperience(killerPlayer, 25);

        // Veterancy: contador de bajas para unidades veteranas
        if (g_sfePlayerVeterancy[killerPlayer]) {
            g_sfePlayerVeterancyKills[killerPlayer] = g_sfePlayerVeterancyKills[killerPlayer] + 1;
            SFE_RecalculateStats(killerPlayer);
        }

        SFE_UpdatePlayerHUD(killerPlayer);
    }

    return true;
}

