int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblUpgLife;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnBuyUpgLife;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblUpgEnergy;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnBuyUpgEnergy;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblUpgSpeed;
