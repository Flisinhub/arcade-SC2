// Pestaña 4: Ajustes & Comercio
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnTradeMinerals;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnToggleIncomeText;

// Declaraciones adelantadas
void SFE_InitPlayerConsoleUI (int player);
void SFE_TogglePlayerConsole (int player);
void SFE_ShowConsoleTab (int player, int tab);
void SFE_UpdateConsoleContent (int player);
bool gt_SFE_ConsoleClick_Func (bool testConds, bool runActions);
bool gt_SFE_ConsoleKey_Func (bool testConds, bool runActions);
bool gt_SFE_ConsoleShift_Func (bool testConds, bool runActions);

//--------------------------------------------------------------------------------------------------
// Inicializar la Consola del Jugador (Alt+C)
//--------------------------------------------------------------------------------------------------
void SFE_InitPlayerConsoleUI (int player) {
    playergroup pg;
    int dlg;
    int t;
    int opt;
    int rowY;
    trigger tClick;
    trigger tKeyAltC;
    trigger tKeyShiftDown;
    trigger tKeyShiftUp;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return;
    }

    pg = PlayerGroupSingle(player);
    g_sfeConsoleOpen[player] = false;
    g_sfeConsoleActiveTab[player] = 1;
    g_sfeShiftHeld[player] = false;
    g_sfeShowIncomeText[player] = true;

    // Crear Diálogo Centralizado (840 x 640)
    dlg = DialogCreate(840, 640, c_anchorCenter, 0, 0, true);
    g_sfeConsoleDialog[player] = dlg;
    DialogSetImage(dlg, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    // Título Principal
    g_sfeConsoleLblTitle[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblTitle[player], pg, 500, 30);
    DialogControlSetPosition(g_sfeConsoleLblTitle[player], pg, c_anchorTop, 0, 15);
    DialogControlSetPropertyAsText(g_sfeConsoleLblTitle[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize20Bold\"><c val=\"FFE400\">SPECIAL FORCES ELITE 5 — CONSOLA DE JUGADOR</c></s>"));

    // Indicador de Minerales Disponibles
    g_sfeConsoleLblMinerals[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblMinerals[player], pg, 300, 25);
    DialogControlSetPosition(g_sfeConsoleLblMinerals[player], pg, c_anchorTopRight, -30, 18);

    // Botones de Pestañas (Tabs)
    g_sfeConsoleBtnTabBuffs[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnTabBuffs[player], pg, 185, 34);
    DialogControlSetPosition(g_sfeConsoleBtnTabBuffs[player], pg, c_anchorTopLeft, 25, 55);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnTabBuffs[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"00FFEA\">1. BUFFS (T1 - T7)</c></s>"));

    g_sfeConsoleBtnTabStats[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnTabStats[player], pg, 185, 34);
    DialogControlSetPosition(g_sfeConsoleBtnTabStats[player], pg, c_anchorTopLeft, 220, 55);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnTabStats[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"55FF55\">2. ATRIBUTOS & STATS</c></s>"));

    g_sfeConsoleBtnTabUpgrades[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnTabUpgrades[player], pg, 215, 34);
    DialogControlSetPosition(g_sfeConsoleBtnTabUpgrades[player], pg, c_anchorTopLeft, 415, 55);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnTabUpgrades[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"FFE400\">3. 500 UPGRADES / AUTO</c></s>"));

    g_sfeConsoleBtnTabSettings[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnTabSettings[player], pg, 175, 34);
    DialogControlSetPosition(g_sfeConsoleBtnTabSettings[player], pg, c_anchorTopLeft, 640, 55);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnTabSettings[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"CC88FF\">4. AJUSTES / COMERCIO</c></s>"));

    // Botón de Cierre
    g_sfeConsoleBtnClose[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnClose[player], pg, 200, 36);
    DialogControlSetPosition(g_sfeConsoleBtnClose[player], pg, c_anchorBottom, 0, 15);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnClose[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"FFFFFF\">Cerrar Consola [Alt+C]</c></s>"));

    tClick = TriggerCreate("gt_SFE_ConsoleClick_Func");
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnTabBuffs[player], c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnTabStats[player], c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnTabUpgrades[player], c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnTabSettings[player], c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnClose[player], c_triggerControlEventTypeClick);

    // =========================================================================
    // PESTAÑA 1: BUFFS TIERS 1 A 7 Y ULTIMATES
    // =========================================================================
    t = 1;
    while (t <= 7) {
        rowY = 100 + ((t - 1) * 60);

        // Etiqueta del Tier
        g_sfeConsoleLblTierInfo[player][t] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
        DialogControlSetSize(g_sfeConsoleLblTierInfo[player][t], pg, 130, 48);
        DialogControlSetPosition(g_sfeConsoleLblTierInfo[player][t], pg, c_anchorTopLeft, 25, rowY);

        // 4 Botones de opciones por cada Tier
        opt = 1;
        while (opt <= 4) {
            g_sfeConsoleBtnBuff[player][t][opt] = DialogControlCreate(dlg, c_triggerControlTypeButton);
            DialogControlSetSize(g_sfeConsoleBtnBuff[player][t][opt], pg, 135, 48);
            DialogControlSetPosition(g_sfeConsoleBtnBuff[player][t][opt], pg, c_anchorTopLeft, 160 + ((opt - 1) * 140), rowY);
            TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuff[player][t][opt], c_triggerControlEventTypeClick);
            opt = opt + 1;
        }

        // Botón Vender Tier
        g_sfeConsoleBtnSellBuff[player][t] = DialogControlCreate(dlg, c_triggerControlTypeButton);
        DialogControlSetSize(g_sfeConsoleBtnSellBuff[player][t], pg, 105, 48);
        DialogControlSetPosition(g_sfeConsoleBtnSellBuff[player][t], pg, c_anchorTopLeft, 720, rowY);
        DialogControlSetPropertyAsText(g_sfeConsoleBtnSellBuff[player][t], c_triggerControlPropertyText, pg, 
            StringToText("<s val=\"ModCenterSize12Bold\"><c val=\"FF8888\">Vender T" + IntToString(t) + "</c></s>"));
        TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnSellBuff[player][t], c_triggerControlEventTypeClick);

        t = t + 1;
    }

    // Fila de Ultimates
    g_sfeConsoleBtnAce[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnAce[player], pg, 185, 45);
    DialogControlSetPosition(g_sfeConsoleBtnAce[player], pg, c_anchorTopLeft, 25, 525);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnAce[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize13Bold\"><c val=\"FFE400\">ACE (15k)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnAce[player], c_triggerControlEventTypeClick);

    g_sfeConsoleBtnDemiurge[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnDemiurge[player], pg, 185, 45);
    DialogControlSetPosition(g_sfeConsoleBtnDemiurge[player], pg, c_anchorTopLeft, 220, 525);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnDemiurge[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize13Bold\"><c val=\"00FFEA\">DEMIURGE (30k)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnDemiurge[player], c_triggerControlEventTypeClick);

    g_sfeConsoleBtnVeterancy[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnVeterancy[player], pg, 185, 45);
    DialogControlSetPosition(g_sfeConsoleBtnVeterancy[player], pg, c_anchorTopLeft, 415, 525);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnVeterancy[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize13Bold\"><c val=\"55FF55\">VETERANCY (10k)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnVeterancy[player], c_triggerControlEventTypeClick);

    g_sfeConsoleBtnMaxExp[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnMaxExp[player], pg, 210, 45);
    DialogControlSetPosition(g_sfeConsoleBtnMaxExp[player], pg, c_anchorTopLeft, 610, 525);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnMaxExp[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize13Bold\"><c val=\"FF44AA\">MAX EXP (75k)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnMaxExp[player], c_triggerControlEventTypeClick);

    // =========================================================================
    // PESTAÑA 2: ATRIBUTOS & STATS
    // =========================================================================
    // Fuerza
    g_sfeConsoleLblStrength[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblStrength[player], pg, 500, 45);
    DialogControlSetPosition(g_sfeConsoleLblStrength[player], pg, c_anchorTopLeft, 50, 120);

    g_sfeConsoleBtnBuyStr[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnBuyStr[player], pg, 200, 45);
    DialogControlSetPosition(g_sfeConsoleBtnBuyStr[player], pg, c_anchorTopLeft, 580, 120);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnBuyStr[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"FF5555\">+5 Fuerza (1,000)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuyStr[player], c_triggerControlEventTypeClick);

    // Destreza
    g_sfeConsoleLblDexterity[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblDexterity[player], pg, 500, 45);
    DialogControlSetPosition(g_sfeConsoleLblDexterity[player], pg, c_anchorTopLeft, 50, 180);

    g_sfeConsoleBtnBuyDex[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnBuyDex[player], pg, 200, 45);
    DialogControlSetPosition(g_sfeConsoleBtnBuyDex[player], pg, c_anchorTopLeft, 580, 180);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnBuyDex[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"55FF55\">+5 Destreza (1,000)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuyDex[player], c_triggerControlEventTypeClick);

    // Inteligencia
    g_sfeConsoleLblIntel[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblIntel[player], pg, 500, 45);
    DialogControlSetPosition(g_sfeConsoleLblIntel[player], pg, c_anchorTopLeft, 50, 240);

    g_sfeConsoleBtnBuyInt[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnBuyInt[player], pg, 200, 45);
    DialogControlSetPosition(g_sfeConsoleBtnBuyInt[player], pg, c_anchorTopLeft, 580, 240);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnBuyInt[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"00CCFF\">+5 Inteligencia (1,000)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuyInt[player], c_triggerControlEventTypeClick);

    // Resistencia / Stamina
    g_sfeConsoleLblStamina[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblStamina[player], pg, 500, 45);
    DialogControlSetPosition(g_sfeConsoleLblStamina[player], pg, c_anchorTopLeft, 50, 300);

    g_sfeConsoleBtnBuyStamina[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnBuyStamina[player], pg, 200, 45);
    DialogControlSetPosition(g_sfeConsoleBtnBuyStamina[player], pg, c_anchorTopLeft, 580, 300);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnBuyStamina[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"FFE400\">+1 Stamina (500)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuyStamina[player], c_triggerControlEventTypeClick);

    // Neutron Armor
    g_sfeConsoleLblNeutron[player] = DialogControlCreate(dlg, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sfeConsoleLblNeutron[player], pg, 500, 45);
    DialogControlSetPosition(g_sfeConsoleLblNeutron[player], pg, c_anchorTopLeft, 50, 360);

    g_sfeConsoleBtnBuyNeutron[player] = DialogControlCreate(dlg, c_triggerControlTypeButton);
    DialogControlSetSize(g_sfeConsoleBtnBuyNeutron[player], pg, 200, 45);
    DialogControlSetPosition(g_sfeConsoleBtnBuyNeutron[player], pg, c_anchorTopLeft, 580, 360);
    DialogControlSetPropertyAsText(g_sfeConsoleBtnBuyNeutron[player], c_triggerControlPropertyText, pg, 
        StringToText("<s val=\"ModCenterSize14Bold\"><c val=\"FFAA00\">Neutron Armor (12.5k)</c></s>"));
    TriggerAddEventDialogControl(tClick, player, g_sfeConsoleBtnBuyNeutron[player], c_triggerControlEventTypeClick);

    // =========================================================================
    // PESTAÑA 3: 500 UPGRADES & AUTOCAST
