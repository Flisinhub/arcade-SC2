// Pestaña 3: 500 Upgrades
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnAutocast;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblUpgDmg;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnBuyUpgDmg;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblUpgArmor;
