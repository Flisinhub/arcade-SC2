//==================================================================================================
// Special Forces Elite 5 - Player Console (Alt+C) System
// Consola de Mando del Jugador: Buffs T1-T7, Atributos con Shift-Buy, 500 Upgrades y Autocast
//==================================================================================================

#ifndef SFE_PLAYER_CONSOLE_INCLUDED
#define SFE_PLAYER_CONSOLE_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/BuffsEngine.galaxy"
include "Scripts/UpgradesEngine.galaxy"
include "Scripts/Attributes.galaxy"


// Controles Comunes
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblTitle;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleLblMinerals;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnTabBuffs;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnTabStats;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnTabUpgrades;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnTabSettings;
int[c_SFE_MAX_PLAYERS + 1] g_sfeConsoleBtnClose;

// Pestaña 1: Buffs (Botones por Tier 1..7 + Venta + Ultimates)
int[c_SFE_MAX_PLAYERS + 1][8][5] g_sfeConsoleBtnBuff; // [player][tier][option 1..4]
int[c_SFE_MAX_PLAYERS + 1][8]    g_sfeConsoleBtnSellBuff; // [player][tier]
