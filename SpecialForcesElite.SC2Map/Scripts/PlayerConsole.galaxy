int[c_SFE_MAX_PLAYERS + 1]       g_sfeConsoleBtnAce;
int[c_SFE_MAX_PLAYERS + 1]       g_sfeConsoleBtnDemiurge;
int[c_SFE_MAX_PLAYERS + 1]       g_sfeConsoleBtnVeterancy;
