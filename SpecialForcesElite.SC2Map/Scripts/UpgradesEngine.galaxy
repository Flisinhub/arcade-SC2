//==================================================================================================
// Special Forces Elite 5 - 500 Primary Race Upgrades & Autocast Engine
// Daño, Blindaje, Vida, Energía y Cadencia de Disparo (hasta nivel 500 con Autocast)
//==================================================================================================

#ifndef SFE_UPGRADES_INCLUDED
#define SFE_UPGRADES_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Attributes.galaxy"

// Declaraciones adelantadas
void SFE_InitUpgradesEngine ();
int SFE_GetUpgradeCost (int currentLvl);
bool SFE_BuyPrimaryUpgrade (int player, int upgradeType);
void SFE_ToggleAutocast (int player);
void SFE_RunUpgradeAutocast (int player);

//--------------------------------------------------------------------------------------------------
// Inicializar Variables del Motor de Mejoras
//--------------------------------------------------------------------------------------------------
void SFE_InitUpgradesEngine () {
    int p;
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        g_sfeUpgradeWeaponDamage[p] = 0;
        g_sfeUpgradeArmor[p] = 0;
        g_sfeUpgradeLife[p] = 0;
        g_sfeUpgradeEnergy[p] = 0;
        g_sfeUpgradeAttackSpeed[p] = 0;
        g_sfeUpgradeAutocastActive[p] = false;
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Calcular Coste Progresivo de una Mejora según su Nivel Actual
//--------------------------------------------------------------------------------------------------
int SFE_GetUpgradeCost (int currentLvl) {
    if (currentLvl >= c_UPGRADE_MAX_LEVEL) {
        return 999999;
    }
    // Progresión suave: nivel 0 cuesta 50 min, nivel 10 cuesta 150 min, nivel 100 cuesta 1050 min
    return 50 + (currentLvl * 10);
}

//--------------------------------------------------------------------------------------------------
// Comprar un Nivel de Mejora Principal
//--------------------------------------------------------------------------------------------------
bool SFE_BuyPrimaryUpgrade (int player, int upgradeType) {
    int curLvl;
    int cost;
    int playerMinerals;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return false;
    }

    if (upgradeType == c_UPG_WEAPON_DAMAGE) {
        curLvl = g_sfeUpgradeWeaponDamage[player];
    } else if (upgradeType == c_UPG_ARMOR) {
        curLvl = g_sfeUpgradeArmor[player];
    } else if (upgradeType == c_UPG_LIFE) {
        curLvl = g_sfeUpgradeLife[player];
    } else if (upgradeType == c_UPG_ENERGY) {
        curLvl = g_sfeUpgradeEnergy[player];
    } else if (upgradeType == c_UPG_ATTACK_SPEED) {
        curLvl = g_sfeUpgradeAttackSpeed[player];
    } else {
        return false;
    }

    if (curLvl >= c_UPGRADE_MAX_LEVEL) {
        return false;
    }

    cost = SFE_GetUpgradeCost(curLvl);
    playerMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);

    if (playerMinerals < cost) {
        return false;
    }

    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, cost);

    if (upgradeType == c_UPG_WEAPON_DAMAGE) {
        g_sfeUpgradeWeaponDamage[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ARMOR) {
        g_sfeUpgradeArmor[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_LIFE) {
        g_sfeUpgradeLife[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ENERGY) {
        g_sfeUpgradeEnergy[player] = curLvl + 1;
    } else if (upgradeType == c_UPG_ATTACK_SPEED) {
        g_sfeUpgradeAttackSpeed[player] = curLvl + 1;
    }

    SFE_RecalculateStats(player);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Conmutar Autocast ON / OFF para un Jugador
//--------------------------------------------------------------------------------------------------
void SFE_ToggleAutocast (int player) {
    text msg;

    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return;
    }

    g_sfeUpgradeAutocastActive[player] = !g_sfeUpgradeAutocastActive[player];

    if (g_sfeUpgradeAutocastActive[player]) {
        msg = StringToText("<c val=\"55FF55\">[AUTOCAST ACTIVADO] Las 500 mejoras principales se comprarán automáticamente.</c>");
    } else {
        msg = StringToText("<c val=\"FFAA00\">[AUTOCAST DESACTIVADO] Compra manual de mejoras restaurada.</c>");
    }
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, msg);
}

//--------------------------------------------------------------------------------------------------
// Ejecutar Ciclo de Autocast (compra la mejora más barata disponible en lote)
//--------------------------------------------------------------------------------------------------
void SFE_RunUpgradeAutocast (int player) {
    int iterations;
    int lowestLvl;
    int targetUpg;
    int curLvl;
    bool bought;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeUpgradeAutocastActive[player]) {
        return;
    }

    iterations = 0;
    // Hasta 5 compras por pulso para preservar la reactividad del motor
    while (iterations < 5) {
        lowestLvl = 999999;
        targetUpg = -1;

        // 1: Daño
        curLvl = g_sfeUpgradeWeaponDamage[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_WEAPON_DAMAGE;
        }

        // 2: Blindaje
        curLvl = g_sfeUpgradeArmor[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ARMOR;
        }

        // 3: Vida
        curLvl = g_sfeUpgradeLife[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_LIFE;
        }

        // 4: Energía
        curLvl = g_sfeUpgradeEnergy[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ENERGY;
        }

        // 5: Cadencia
        curLvl = g_sfeUpgradeAttackSpeed[player];
        if (curLvl < c_UPGRADE_MAX_LEVEL && curLvl < lowestLvl) {
            lowestLvl = curLvl;
            targetUpg = c_UPG_ATTACK_SPEED;
        }

        if (targetUpg == -1) {
            break; // Todas al nivel máximo 500
        }

        bought = SFE_BuyPrimaryUpgrade(player, targetUpg);
        if (!bought) {
            break; // No alcanza el dinero para la siguiente
        }

        iterations = iterations + 1;
    }
}

#endif
