// Tipos de Atributos Primarios
const int c_ATTR_STRENGTH = 0;     // Fuerza (HP, Daño primario)
const int c_ATTR_DEXTERITY = 1;    // Destreza (Cadencia, Regeneracion)
const int c_ATTR_INTELLIGENCE = 2; // Inteligencia (Mana, Vision, Regen Mana)

struct SFE_HeroDefinition {
    int id;
    string unitType;
    string fallbackUnitType;
    string name;
    string archetype;
    string description;
    int primaryAttribute;
    fixed baseHp;
    fixed baseShields;
    fixed baseEnergy;
    fixed baseArmor;
    fixed baseDamage;
    fixed baseAttackInterval;
    string portraitIcon;
};

SFE_HeroDefinition[c_HERO_TOTAL_COUNT] g_sfeHeroes;

