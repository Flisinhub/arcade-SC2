//==================================================================================================
// Special Forces Elite 5 - Attribute Engine (Fuerza, Destreza, Inteligencia)
// Implementacion matemática determinista de combate y escalado táctico
//==================================================================================================

#ifndef SFE_ATTRIBUTES_INCLUDED
#define SFE_ATTRIBUTES_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Persistence.galaxy"

// Declaraciones adelantadas
void SFE_RecalculateStats (int player);
void SFE_HeroLevelUp (int player);

//--------------------------------------------------------------------------------------------------
// Inicializar Atributos de un Heroe
//--------------------------------------------------------------------------------------------------
void SFE_InitHeroAttributes (int player, unit u, int heroId) {
    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return;
    }

    g_sfeHeroStates[player].heroUnit = u;
    g_sfeHeroStates[player].heroId = heroId;
    g_sfeHeroStates[player].isActive = true;

    g_sfeHeroStates[player].level = 1;
    g_sfeHeroStates[player].currentXp = 0;
    g_sfeHeroStates[player].requiredXp = 100;
    g_sfeHeroStates[player].unspentAttributePoints = 5; // Puntos iniciales de cortesia

    // Atributos base segun arquetipo
    if (g_sfeHeroes[heroId].primaryAttribute == c_ATTR_STRENGTH) {
        g_sfeHeroStates[player].strength = 15;
        g_sfeHeroStates[player].dexterity = 8;
        g_sfeHeroStates[player].intelligence = 5;
    } else if (g_sfeHeroes[heroId].primaryAttribute == c_ATTR_DEXTERITY) {
        g_sfeHeroStates[player].strength = 8;
        g_sfeHeroStates[player].dexterity = 15;
        g_sfeHeroStates[player].intelligence = 5;
    } else {
        g_sfeHeroStates[player].strength = 5;
        g_sfeHeroStates[player].dexterity = 8;
        g_sfeHeroStates[player].intelligence = 15;
    }

    SFE_RecalculateStats(player);
}

//--------------------------------------------------------------------------------------------------
// Recalcular Estadisticas Matematicas Deterministas
//--------------------------------------------------------------------------------------------------
void SFE_RecalculateStats (int player) {
    unit u;
    int hid;
    fixed hp;
    fixed shields;
    fixed energy;
    fixed lRegen;
    fixed eRegen;
    fixed sight;
    fixed speed;
    fixed armor;
    fixed damage;
    fixed interval;
    int b1;
    int b2;
    int b3;
    int b4;
    int b5;
    int b6;
    int b7;

    if (!g_sfeHeroStates[player].isActive) {
        return;
    }

    u = g_sfeHeroStates[player].heroUnit;
    hid = g_sfeHeroStates[player].heroId;

    if (!UnitIsAlive(u)) {
        return;
    }

    b1 = g_sfePlayerBuffTiers[player][1];
    b2 = g_sfePlayerBuffTiers[player][2];
    b3 = g_sfePlayerBuffTiers[player][3];
    b4 = g_sfePlayerBuffTiers[player][4];
    b5 = g_sfePlayerBuffTiers[player][5];
    b6 = g_sfePlayerBuffTiers[player][6];
    b7 = g_sfePlayerBuffTiers[player][7];

    // 1. HP Base + Fuerza + Stamina + Mejoras de Raza (500)
    hp = g_sfeHeroes[hid].baseHp 
       + (g_sfeHeroStates[player].strength * c_FACTOR_ALPHA_STRENGTH_HP)
       + (g_sfeHeroStates[player].stamina * 15.0)
       + (g_sfeUpgradeLife[player] * 20.0);

    // Buffs de HP
    if (b3 == c_BUFF_T3_RESISTANCE) {
        hp = hp * 1.10;
    }
    if (b4 == c_BUFF_T4_QUANTUM_FIELD) {
        hp = hp + 150.0;
    }
    if (b6 == c_BUFF_T6_DEFIANCE) {
        hp = hp + 500.0;
    }
    if (b7 == c_BUFF_T7_VIGOR) {
        hp = hp + 1000.0;
    }
    if (g_sfePlayerAce[player]) {
        hp = hp * 1.50;
    }
    if (g_sfePlayerVeterancy[player]) {
        hp = hp + ((g_sfePlayerVeterancyKills[player] / 10) * 50.0);
    }
    if (g_sfePlayerDemiurge[player]) {
        hp = hp + 5000.0;
    }
    g_sfeHeroStates[player].currentMaxHp = hp;

    // 2. Dano Base + Fuerza + Mejoras de Raza (500)
    damage = g_sfeHeroes[hid].baseDamage 
           + (g_sfeHeroStates[player].strength * c_FACTOR_ALPHA_STRENGTH_DAMAGE)
           + (g_sfeUpgradeWeaponDamage[player] * 2.0);

    // Buffs de Dano
    if (b2 == c_BUFF_T2_IMPACT) {
        damage = damage + 25.0;
    }
    if (b2 == c_BUFF_T2_ANCIENT_VALOR) {
        damage = damage * 1.05;
    }
    if (b3 == c_BUFF_T3_HARDENED_AMMO) {
        damage = damage * 1.15;
    }
    if (b3 == c_BUFF_T3_MOMENTUM) {
        damage = damage * (1.0 + (g_sfeMomentumStacks[player] * 0.05));
    }
    if (b5 == c_BUFF_T5_WARRIOR) {
        damage = damage * 1.50;
    }
    if (b5 == c_BUFF_T5_SHARPSHOOTER) {
        damage = damage * 1.30;
    }
    if (b6 == c_BUFF_T6_MIGHT) {
        damage = damage * 1.40;
    }
    if (b7 == c_BUFF_T7_MARKSMAN) {
        damage = damage * 1.50;
    }
    if (g_sfePlayerAce[player]) {
        damage = damage * 1.50;
    }
    if (g_sfePlayerVeterancy[player]) {
        damage = damage + ((g_sfePlayerVeterancyKills[player] / 10) * 5.0);
    }
    if (g_sfePlayerDemiurge[player]) {
        damage = damage + 500.0;
    }
    g_sfeHeroStates[player].currentDamage = damage;

    // 3. Cadencia / Intervalo de Ataque (Destreza + Mejoras de Raza 500)
    interval = g_sfeHeroes[hid].baseAttackInterval / (1.0 + (g_sfeHeroStates[player].dexterity * c_FACTOR_BETA_DEXTERITY_SPEED) + (g_sfeUpgradeAttackSpeed[player] * 0.005));
    if (b5 == c_BUFF_T5_TIME_LORD) {
        interval = interval * 0.75;
    }
    if (b7 == c_BUFF_T7_SPIRITED) {
        interval = interval * 0.70;
    }
    if (interval < 0.1) {
        interval = 0.1;
    }
    g_sfeHeroStates[player].currentAttackInterval = interval;

    // 4. Regeneracion de Vida (Destreza + Stamina + Buffs)
    lRegen = 0.5 + (g_sfeHeroStates[player].dexterity * c_FACTOR_GAMMA_DEXTERITY_REGEN) + (g_sfeHeroStates[player].stamina * 0.1);
    if (b4 == c_BUFF_T4_ENHANCED_REGEN) {
        lRegen = lRegen + 15.0;
    }
    if (b7 == c_BUFF_T7_VIGOR) {
        lRegen = lRegen + 10.0;
    }
    g_sfeHeroStates[player].currentLifeRegen = lRegen;

    // 5. Energia y Regeneracion (Inteligencia + Mejoras de Raza 500)
    energy = g_sfeHeroes[hid].baseEnergy + (g_sfeHeroStates[player].intelligence * c_FACTOR_LAMBDA_INTEL_ENERGY) + (g_sfeUpgradeEnergy[player] * 10.0);
    if (b2 == c_BUFF_T2_ANCIENT_VALOR) {
        energy = energy * 1.05;
    }
    if (b4 == c_BUFF_T4_MENTAL_POWER) {
        energy = energy + 100.0;
    }
    if (b5 == c_BUFF_T5_WIZARD) {
        energy = energy * 1.50;
    }
    if (b7 == c_BUFF_T7_SPELLBOUND) {
        energy = energy + 200.0;
    }
    if (g_sfePlayerAce[player]) {
        energy = energy * 1.50;
    }
    if (g_sfePlayerDemiurge[player]) {
        energy = energy + 500.0;
    }
    g_sfeHeroStates[player].currentMaxEnergy = energy;

    eRegen = 0.75 + (g_sfeHeroStates[player].intelligence * c_FACTOR_LAMBDA_INTEL_REGEN) + (g_sfeUpgradeEnergy[player] * 0.05);
    if (b4 == c_BUFF_T4_ENHANCED_REGEN) {
        eRegen = eRegen + 10.0;
    }
    if (b4 == c_BUFF_T4_MENTAL_POWER) {
        eRegen = eRegen + 5.0;
    }
    if (b7 == c_BUFF_T7_SPELLBOUND) {
        eRegen = eRegen + 15.0;
    }
    g_sfeHeroStates[player].currentEnergyRegen = eRegen;

    // 6. Radio de Vision
    sight = 9.0 + (g_sfeHeroStates[player].intelligence * c_FACTOR_LAMBDA_INTEL_SIGHT);
    if (b1 == c_BUFF_T1_OPTICAL_LENS) {
        sight = sight + 10.0;
    }
    g_sfeHeroStates[player].currentSightRadius = sight;

    // 7. Velocidad de Movimiento
    speed = 2.8;
    if (b1 == c_BUFF_T1_EXOSKELETON) {
        speed = speed + 1.5;
    }
    if (b1 == c_BUFF_T1_HYPERACTIVITY) {
        speed = speed + 1.0;
    }
    if (b1 == c_BUFF_T1_KEVLAR) {
        speed = speed + 0.5;
    }
    if (b2 == c_BUFF_T2_TRANSIENT) {
        speed = speed + 1.0;
    }
    if (b7 == c_BUFF_T7_SPIRITED) {
        speed = speed + 1.0;
    }
    if (g_sfePlayerAce[player]) {
        speed = speed + 1.0;
    }
    g_sfeHeroStates[player].currentMovementSpeed = speed;

    // 8. Blindaje (Armadura)
    armor = (g_sfeUpgradeArmor[player] * 1.0) + (g_sfeHeroStates[player].neutronArmor * 1.0) + (g_sfeHeroStates[player].stamina * 0.2);
    if (b2 == c_BUFF_T2_ADV_ARMOR) {
        armor = (armor + 75.0) * 1.50;
    }
    if (b3 == c_BUFF_T3_RESISTANCE) {
        armor = armor * 2.00;
    }
    if (b6 == c_BUFF_T6_BULWARK) {
        armor = armor + (g_sfeBulwarkStacks[player] * 20.0);
    }
    if (g_sfePlayerDemiurge[player]) {
        armor = armor + 50.0;
    }
    g_sfeHeroStates[player].currentArmor = armor;

    // Escudos (si la unidad los tiene por base)
    shields = g_sfeHeroes[hid].baseShields;
    if (shields > 0.0) {
        shields = shields + (g_sfeHeroStates[player].strength * 10.0) + (g_sfeUpgradeLife[player] * 10.0);
        if (b4 == c_BUFF_T4_QUANTUM_FIELD) {
            shields = shields + 200.0;
        }
        if (b6 == c_BUFF_T6_HOLY_SHELL) {
            shields = shields + 300.0;
        }
        g_sfeHeroStates[player].currentMaxShields = shields;
        UnitSetPropertyFixed(u, c_unitPropShieldsMax, shields);
        UnitSetPropertyFixed(u, c_unitPropShieldsRegen, lRegen);
    }

    // Aplicar al motor de la unidad en StarCraft II
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, lRegen);
    UnitSetPropertyFixed(u, c_unitPropEnergyMax, energy);
    UnitSetPropertyFixed(u, c_unitPropEnergyRegen, eRegen);
    UnitSetPropertyFixed(u, c_unitPropMovementSpeed, speed);

    // Si tiene Ace y es unidad de soporte/transporte, otorgar invulnerabilidad
    if (g_sfePlayerAce[player]) {
        if (UnitGetType(u) == "Medivac" || UnitGetType(u) == "WarpPrism" || UnitGetType(u) == "Overlord" || UnitGetType(u) == "Observer") {
            UnitSetState(u, c_unitStateInvulnerable, true);
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Asignacion de Puntos de Atributo
//--------------------------------------------------------------------------------------------------
bool SFE_AllocateAttribute (int player, int attributeType) {
    if (player < 1 || player > c_SFE_MAX_PLAYERS) {
        return false;
    }

    if (g_sfeHeroStates[player].unspentAttributePoints <= 0) {
        return false;
    }

    if (attributeType == c_ATTR_STRENGTH) {
        g_sfeHeroStates[player].strength = g_sfeHeroStates[player].strength + 1;
    } else if (attributeType == c_ATTR_DEXTERITY) {
        g_sfeHeroStates[player].dexterity = g_sfeHeroStates[player].dexterity + 1;
    } else if (attributeType == c_ATTR_INTELLIGENCE) {
        g_sfeHeroStates[player].intelligence = g_sfeHeroStates[player].intelligence + 1;
    } else {
        return false;
    }

    g_sfeHeroStates[player].unspentAttributePoints = g_sfeHeroStates[player].unspentAttributePoints - 1;
    SFE_RecalculateStats(player);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Concesion de Experiencia y Subida de Nivel
//--------------------------------------------------------------------------------------------------
void SFE_HeroAddExperience (int player, int amount) {
    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeHeroStates[player].isActive) {
        return;
    }

    g_sfeHeroStates[player].currentXp = g_sfeHeroStates[player].currentXp + amount;

    while (g_sfeHeroStates[player].currentXp >= g_sfeHeroStates[player].requiredXp && g_sfeHeroStates[player].level < 50) {
        g_sfeHeroStates[player].currentXp = g_sfeHeroStates[player].currentXp - g_sfeHeroStates[player].requiredXp;
        SFE_HeroLevelUp(player);
    }
}

void SFE_HeroLevelUp (int player) {
    unit u;
    text msg;

    g_sfeHeroStates[player].level = g_sfeHeroStates[player].level + 1;
    g_sfeHeroStates[player].requiredXp = 100 * g_sfeHeroStates[player].level * g_sfeHeroStates[player].level;
    g_sfeHeroStates[player].unspentAttributePoints = g_sfeHeroStates[player].unspentAttributePoints + 3;

    u = g_sfeHeroStates[player].heroUnit;

    // Restaurar completamente vida y energia al subir de nivel
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropEnergyPercent, 100.0);
    if (g_sfeHeroes[g_sfeHeroStates[player].heroId].baseShields > 0.0) {
        UnitSetPropertyFixed(u, c_unitPropShieldsPercent, 100.0);
    }

    SFE_RecalculateStats(player);

    // Notificación de subida de nivel
    msg = StringToText("<s val=\"ModCenterSize22Bold\"><c val=\"FFFF00\">¡NIVEL " + IntToString(g_sfeHeroStates[player].level) + "! (+3 Puntos Disponibles)</c></s>");
    UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, msg);

    // Conceder experiencia de cuenta al banco
    SFE_BankAddExp(player, 100);
}

//--------------------------------------------------------------------------------------------------
// Modificador de Dano Efectivo (Formula de Blindaje y Corte Minimo a 0.5)
// Dano_real = max(0.5, (Dano_base + F * alpha) - Armadura)
//--------------------------------------------------------------------------------------------------
fixed SFE_CalculateEffectiveDamage (int attackerPlayer, fixed baseDamage, fixed targetArmor) {
    fixed rawDamage;
    fixed effectiveDamage;

    if (attackerPlayer >= 1 && attackerPlayer <= c_SFE_MAX_PLAYERS && g_sfeHeroStates[attackerPlayer].isActive) {
        rawDamage = g_sfeHeroStates[attackerPlayer].currentDamage;
    } else {
        rawDamage = baseDamage;
    }

    effectiveDamage = rawDamage - targetArmor;
    if (effectiveDamage < 0.5) {
        effectiveDamage = 0.5;
    }

    return effectiveDamage;
}

#endif
