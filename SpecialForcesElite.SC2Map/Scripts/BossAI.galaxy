//--------------------------------------------------------------------------------------------------
// Invocación Secreta 4: Hell Gate (NE - Gran Nydus)
//--------------------------------------------------------------------------------------------------
void SFE_TriggerHellGateIncursion () {
    point pSpawn;
    int k;
    unit u;
    int p;

    if (g_sfeBossHellGateTriggered) {
        return;
    }
    g_sfeBossHellGateTriggered = true;

    pSpawn = g_sfeFinalHivePoint;

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF0000\">¡¡PORTAL DEL INFIERNO DESATADO!! ¡INCURSIÓN MASIVA DE ÉLITE EN EL SECTOR NE!</c></b>"));

    k = 0;
    while (k < 12) {
        UnitCreate(1, "Aberration", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauCenter), c_orderQueueReplace);
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest), c_orderQueueAddToEnd);
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueAddToEnd);
        k = k + 1;
    }

    k = 0;
    while (k < 6) {
        UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauCenter), c_orderQueueReplace);
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest), c_orderQueueAddToEnd);
        UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueAddToEnd);
        k = k + 1;
    }

    // Registrar logro Hell Gate en banco para todos los jugadores
    p = 1;
    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            SFE_BankAddExp(p, 500);
        }
        p = p + 1;
    }
}

