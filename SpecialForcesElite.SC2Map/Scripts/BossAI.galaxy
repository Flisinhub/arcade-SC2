//==================================================================================================
// Special Forces Elite 5 - Boss AI & Encounter Engine
// Mecánica de jefes mayores por fases (75%, 50%, 25%), tabla de amenaza, esbirros,
// habilidades de zona y los 5 eventos de invocación territorial secreta (120s)
//==================================================================================================

#ifndef SFE_BOSSAI_INCLUDED
#define SFE_BOSSAI_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Attributes.galaxy"
include "Scripts/Persistence.galaxy"
include "Scripts/AlliedBase.galaxy"

// Unidades de Jefes
unit g_sfeBossMaarUnit;
unit g_sfeBossDestroyerUnit;
unit g_sfeBossDiabloUnit;
unit g_sfeBossChainDogUnit;
unit g_sfeBossHybridsUnit;

// Banderas de aparición
bool g_sfeBossMaarSpawned;
bool g_sfeBossDestroyerSpawned;
bool g_sfeBossDiabloSpawned;
bool g_sfeBossChainDogSpawned;
bool g_sfeBossHybridsSpawned;
bool g_sfeBossHellGateTriggered;

// Fases de combate
int g_sfeBossMaarPhase;
int g_sfeBossDestroyerPhase;
int g_sfeBossDiabloPhase;
int g_sfeBossChainDogPhase;
int g_sfeBossHybridsPhase;

// Contadores de Invocación Secreta Territorial (en segundos)
int g_sfeTimerDestroyer;
int g_sfeTimerHybrids;
int g_sfeTimerChainDog;
int g_sfeTimerHellGate;
int g_sfeTimerDiablo;

timer g_sfeBossAITimer;

// Declaraciones de funciones
void SFE_BossCastShockwave (unit bossUnit, fixed radius, fixed damage);
void SFE_BossSummonMinions (point p, string minionType, int count);
void SFE_TriggerBossMaarSpawn ();
void SFE_TriggerBossDestroyerSpawn ();
void SFE_TriggerBossDiabloSpawn ();
void SFE_TriggerBossChainDogSpawn ();
void SFE_TriggerBossHybridsSpawn ();
void SFE_TriggerHellGateIncursion ();

//--------------------------------------------------------------------------------------------------
// Invocación del Jefe 1: Híbrido Maar (Sector Central-Norte)
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossMaarSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossMaarSpawned) {
        return;
    }
    g_sfeBossMaarSpawned = true;
    g_sfeBossMaarPhase = 1;

    pSpawn = Point(115.0, 135.0);
    UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Archon", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
    }
    g_sfeBossMaarUnit = u;

    hp = 12000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 15.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF00FF\">¡ALERTA MAYOR! ¡EL HÍBRIDO MAAR HA DESPERTADO EN EL SECTOR CENTRAL-NORTE!</c></b>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest), c_orderQueueReplace);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueAddToEnd);
}

//--------------------------------------------------------------------------------------------------
// Invocación Secreta 1: Destroyer of Worlds (NW - Restos de Nave Nodriza)
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossDestroyerSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossDestroyerSpawned) {
        return;
    }
    g_sfeBossDestroyerSpawned = true;
    g_sfeBossDestroyerPhase = 1;

    pSpawn = Point(55.0, 155.0);
    UnitCreate(1, "HybridReaver", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Colossus", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 225.0);
        u = UnitLastCreated();
    }
    g_sfeBossDestroyerUnit = u;

    hp = 22000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 25.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF4400\">¡RITUAL COMPLETADO! ¡DESTROYER OF WORLDS HA SIDO INVOCADO EN EL CUADRANTE NW!</c></b>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauNorthWest), c_orderQueueReplace);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfePlateauSouthWest), c_orderQueueAddToEnd);
    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueAddToEnd);
}

