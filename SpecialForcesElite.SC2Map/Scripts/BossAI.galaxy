//==================================================================================================
// Special Forces Elite 5 - Boss AI & Encounter Engine
// Mecánica de jefes mayores por fases (75%, 50%, 25%), tabla de amenaza, esbirros y habilidades de zona
//==================================================================================================

#ifndef SFE_BOSSAI_INCLUDED
#define SFE_BOSSAI_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Attributes.galaxy"
include "Scripts/Persistence.galaxy"
include "Scripts/AlliedBase.galaxy"

unit g_sfeBossMaarUnit;
unit g_sfeBossDestroyerUnit;
unit g_sfeBossDiabloUnit;

bool g_sfeBossMaarSpawned;
bool g_sfeBossDestroyerSpawned;
bool g_sfeBossDiabloSpawned;

int g_sfeBossMaarPhase;
int g_sfeBossDestroyerPhase;
int g_sfeBossDiabloPhase;

timer g_sfeBossAITimer;

// Declaraciones
void SFE_BossCastShockwave (unit bossUnit, fixed radius, fixed damage);
void SFE_BossSummonMinions (point p, string minionType, int count);

//--------------------------------------------------------------------------------------------------
// Invocación del Jefe 1: Híbrido Maar
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossMaarSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossMaarSpawned) {
        return;
    }
    g_sfeBossMaarSpawned = true;
    g_sfeBossMaarPhase = 1;

    pSpawn = Point(100.0, 150.0);
    UnitCreate(1, "HybridDestroyer", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 270.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Archon", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 270.0);
        u = UnitLastCreated();
    }
    g_sfeBossMaarUnit = u;

    hp = 12000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 15.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize26Bold\"><c val=\"FF00FF\">¡ALERTA MAYOR! ¡EL HÍBRIDO MAAR HA DESPERTADO EN EL SECTOR NORTE!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// Invocación del Jefe 2: Destroyer of Worlds
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossDestroyerSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossDestroyerSpawned) {
        return;
    }
    g_sfeBossDestroyerSpawned = true;
    g_sfeBossDestroyerPhase = 1;

    pSpawn = Point(150.0, 100.0);
    UnitCreate(1, "HybridReaver", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 180.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Colossus", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 180.0);
        u = UnitLastCreated();
    }
    g_sfeBossDestroyerUnit = u;

    hp = 22000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 25.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize26Bold\"><c val=\"FF4400\">¡ALERTA APOCALÍPTICA! ¡EL DESTROYER OF WORLDS HA DESCENDIDO EN EL SECTOR ESTE!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// Invocación del Jefe Final: Diablo / Megaboss
//--------------------------------------------------------------------------------------------------
void SFE_TriggerBossDiabloSpawn () {
    point pSpawn;
    unit u;
    fixed hp;

    if (g_sfeBossDiabloSpawned) {
        return;
    }
    g_sfeBossDiabloSpawned = true;
    g_sfeBossDiabloPhase = 1;

    pSpawn = Point(50.0, 100.0);
    UnitCreate(1, "HybridDominator", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 0.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Ultralisk", 0, c_SFE_PLAYER_HOSTILE, pSpawn, 0.0);
        u = UnitLastCreated();
    }
    g_sfeBossDiabloUnit = u;

    hp = 35000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty];
    UnitSetPropertyFixed(u, c_unitPropLifeMax, hp);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 40.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FF0000\">¡¡AMENAZA DESTRUCTORA FINAL!! ¡DIABLO HA ENTRADO AL CAMPO DE BATALLA!</c></s>"));

    UnitIssueOrder(u, OrderTargetingPoint(AbilityCommand("attack", 0), g_sfeBaseCenterPoint), c_orderQueueReplace);
}

//--------------------------------------------------------------------------------------------------
// Habilidad de Jefe: Onda de Choque Zonal
//--------------------------------------------------------------------------------------------------
void SFE_BossCastShockwave (unit bossUnit, fixed radius, fixed damage) {
    point p;
    unitgroup ug;
    int count;
    int i;
    unit target;
    int owner;

    p = UnitGetPosition(bossUnit);
    ug = UnitGroup(null, c_playerAny, RegionCircle(p, radius), null, 0);
    count = UnitGroupCount(ug, c_unitCountAlive);
    i = 1;

    while (i <= count) {
        target = UnitGroupUnit(ug, i);
        owner = UnitGetOwner(target);
        if (owner >= 1 && owner <= c_SFE_MAX_PLAYERS || owner == c_SFE_PLAYER_ALLIED_BASE) {
            UnitDamage(bossUnit, "WeaponNull", target, damage);
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Habilidad de Jefe: Invocación de Esbirros de Soporte
//--------------------------------------------------------------------------------------------------
void SFE_BossSummonMinions (point p, string minionType, int count) {
    int i;
    unit u;
    unitgroup ug;

    i = 0;
    ug = UnitGroupEmpty();

    while (i < count) {
        UnitCreate(1, minionType, 0, c_SFE_PLAYER_HOSTILE, p, RandomFixed(0.0, 360.0));
        u = UnitLastCreated();
        UnitGroupAdd(ug, u);
        i = i + 1;
    }

    SFE_OrderHostilesToCore(ug);
}

//--------------------------------------------------------------------------------------------------
// Bucle de Inteligencia Artificial y Fases de Jefes (Tick cada 2 segundos)
//--------------------------------------------------------------------------------------------------
bool gt_SFE_BossAI_Loop_Func (bool testConds, bool runActions) {
    fixed hpPct;
    point bPos;
    int p;

    if (!runActions) {
        return true;
    }

    // 1. Lógica Híbrido Maar
    if (g_sfeBossMaarSpawned && UnitIsAlive(g_sfeBossMaarUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossMaarUnit);

        // Fase 75%
        if (hpPct <= 75.0 && g_sfeBossMaarPhase == 1) {
            g_sfeBossMaarPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar entra en Fase 2: ¡Invocando Enjambre del Vacío!</c>"));
            SFE_BossSummonMinions(bPos, "Mutalisk", 8);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 8.0, 150.0);
        }
        // Fase 50%
        else if (hpPct <= 50.0 && g_sfeBossMaarPhase == 2) {
            g_sfeBossMaarPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar entra en Fase 3: ¡Onda de Choque Psiónica Devastadora!</c>"));
            SFE_BossSummonMinions(bPos, "Roach", 12);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 10.0, 250.0);
        }
        // Fase 25% (Enfurecimiento)
        else if (hpPct <= 25.0 && g_sfeBossMaarPhase == 3) {
            g_sfeBossMaarPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF00FF\">Híbrido Maar ¡ENFURECIDO!: Regeneración triplicada y Nova Crítica!</c>"));
            UnitSetPropertyFixed(g_sfeBossMaarUnit, c_unitPropLifeRegen, 60.0);
            SFE_BossCastShockwave(g_sfeBossMaarUnit, 12.0, 400.0);
        }
    }

    // 2. Lógica Destroyer of Worlds
    if (g_sfeBossDestroyerSpawned && UnitIsAlive(g_sfeBossDestroyerUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDestroyerUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDestroyerUnit);

        if (hpPct <= 75.0 && g_sfeBossDestroyerPhase == 1) {
            g_sfeBossDestroyerPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 2: ¡Impacto Sísmico!</c>"));
            SFE_BossSummonMinions(bPos, "Immortal", 4);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 9.0, 200.0);
        } else if (hpPct <= 50.0 && g_sfeBossDestroyerPhase == 2) {
            g_sfeBossDestroyerPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds Fase 3: ¡Bombardeo Orbital Masivo!</c>"));
            SFE_BossSummonMinions(bPos, "Colossus", 3);
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 11.0, 350.0);
        } else if (hpPct <= 25.0 && g_sfeBossDestroyerPhase == 3) {
            g_sfeBossDestroyerPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF4400\">Destroyer of Worlds ¡SOBRECARGA NUCLEAR TOTAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDestroyerUnit, 14.0, 500.0);
        }
    }

    // 3. Lógica Diablo Final
    if (g_sfeBossDiabloSpawned && UnitIsAlive(g_sfeBossDiabloUnit)) {
        hpPct = UnitGetPropertyFixed(g_sfeBossDiabloUnit, c_unitPropLifePercent, true);
        bPos = UnitGetPosition(g_sfeBossDiabloUnit);

        if (hpPct <= 75.0 && g_sfeBossDiabloPhase == 1) {
            g_sfeBossDiabloPhase = 2;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 2: ¡Llamas del Infierno!</c>"));
            SFE_BossSummonMinions(bPos, "Ultralisk", 4);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 10.0, 300.0);
        } else if (hpPct <= 50.0 && g_sfeBossDiabloPhase == 2) {
            g_sfeBossDiabloPhase = 3;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo Fase 3: ¡Tormenta de Almas!</c>"));
            SFE_BossSummonMinions(bPos, "HybridDestroyer", 3);
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 12.0, 450.0);
        } else if (hpPct <= 25.0 && g_sfeBossDiabloPhase == 3) {
            g_sfeBossDiabloPhase = 4;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("<c val=\"FF0000\">Diablo ¡CATACLISMO FINAL!</c>"));
            SFE_BossCastShockwave(g_sfeBossDiabloUnit, 15.0, 700.0);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Muerte de Jefe y Registro de Victoria
//--------------------------------------------------------------------------------------------------
bool gt_SFE_BossDied_Func (bool testConds, bool runActions) {
    unit dyingU = EventUnit();
    int p = 1;

    if (!runActions) {
        return true;
    }

    if (dyingU == g_sfeBossMaarUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡HÍBRIDO MAAR ELIMINADO! +2500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDestroyerUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize24Bold\"><c val=\"55FF55\">¡DESTROYER OF WORLDS ERRADICADO! +3500 MINERALES PARA CADA JUGADOR</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 3500);
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
    } else if (dyingU == g_sfeBossDiabloUnit) {
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
            StringToText("<s val=\"ModCenterSize28Bold\"><c val=\"FFE400\">¡¡DIABLO HA SIDO DERROTADO!! ¡EL ARCADE HA SIDO COMPLETADO!</c></s>"));
        while (p <= c_SFE_MAX_PLAYERS) {
            SFE_BankRecordBossKill(p);
            p = p + 1;
        }
        // Desencadenar la Victoria Absoluta
        SFE_TriggerVictory();
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Inicializar el Sistema de Jefes
//--------------------------------------------------------------------------------------------------
void SFE_InitBossSystem () {
    trigger tBossAI;
    trigger tBossDied;

    g_sfeBossMaarSpawned = false;
    g_sfeBossDestroyerSpawned = false;
    g_sfeBossDiabloSpawned = false;

    // Timer recurrente de IA de jefes cada 2 segundos
    g_sfeBossAITimer = TimerCreate();
    TimerStart(g_sfeBossAITimer, 2.0, true, c_timeGame);
    tBossAI = TriggerCreate("gt_SFE_BossAI_Loop_Func");
    TriggerAddEventTimer(tBossAI, g_sfeBossAITimer);

    // Evento de muerte de unidad para jefes
    tBossDied = TriggerCreate("gt_SFE_BossDied_Func");
    TriggerAddEventUnitDied(tBossDied, null);
}

#endif
