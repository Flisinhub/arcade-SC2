//==================================================================================================
// Special Forces Elite 5 - Buffs & Ultimates Engine
// Sistema oficial de 7 Tiers de Buffs, Ultimates, Estados Condicionales y Reembolsos por Muerte
//==================================================================================================

#ifndef SFE_BUFFS_INCLUDED
#define SFE_BUFFS_INCLUDED

include "Scripts/Constants.galaxy"

// Declaraciones adelantadas
void SFE_InitBuffCatalog ();
int SFE_GetBuffCost (int buffId);
string SFE_GetBuffName (int buffId);
bool SFE_BuyBuff (int player, int buffId);
void SFE_SellBuff (int player, int tier);
void SFE_OnHeroDeathRefundBuffs (int player);
void SFE_PeriodicBuffTick ();

//--------------------------------------------------------------------------------------------------
// Inicializar Catálogo de Buffs
//--------------------------------------------------------------------------------------------------
void SFE_InitBuffCatalog () {
    int i;
    int p;
    int t;

    i = 0;
    while (i < c_TOTAL_BUFFS_COUNT) {
        g_sfeBuffCatalog[i].id = i;
        g_sfeBuffCatalog[i].tier = 0;
        g_sfeBuffCatalog[i].cost = 0;
        g_sfeBuffCatalog[i].name = "";
        g_sfeBuffCatalog[i].description = "";
        i = i + 1;
    }

    // Tier 1
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].tier = 1;
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].cost = 5000;
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].name = "Exoskeleton";
    g_sfeBuffCatalog[c_BUFF_T1_EXOSKELETON].description = "+1.5 Vel. Movimiento, -50% Radio de Colision.";

    g_sfeBuffCatalog[c_BUFF_T1_HYPERACTIVITY].tier = 1;
    g_sfeBuffCatalog[c_BUFF_T1_HYPERACTIVITY].cost = 5000;
    g_sfeBuffCatalog[c_BUFF_T1_HYPERACTIVITY].name = "Hyperactivity";
    g_sfeBuffCatalog[c_BUFF_T1_HYPERACTIVITY].description = "+15% Reduccion Enfriamiento, +1.0 Vel. Movimiento.";

