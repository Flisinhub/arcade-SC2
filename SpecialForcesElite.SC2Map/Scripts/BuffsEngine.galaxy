    g_sfeBuffCatalog[c_BUFF_T3_HARDENED_AMMO].description = "+15% Danio Arma, +20% Danio Habilidad, +0.5 Rango.";

    g_sfeBuffCatalog[c_BUFF_T3_PREDATOR].tier = 3;
    g_sfeBuffCatalog[c_BUFF_T3_PREDATOR].cost = 10000;
    g_sfeBuffCatalog[c_BUFF_T3_PREDATOR].name = "Predator";
    g_sfeBuffCatalog[c_BUFF_T3_PREDATOR].description = "+100% Danio vs Heroicos (+150% tras 5s sin recibir danio).";

    g_sfeBuffCatalog[c_BUFF_T3_RESISTANCE].tier = 3;
    g_sfeBuffCatalog[c_BUFF_T3_RESISTANCE].cost = 10000;
    g_sfeBuffCatalog[c_BUFF_T3_RESISTANCE].name = "Resistance";
    g_sfeBuffCatalog[c_BUFF_T3_RESISTANCE].description = "+10% Vida/Escudos, +100% Blindaje, +25% Resist. Magica.";

    // Tier 4
    g_sfeBuffCatalog[c_BUFF_T4_ENHANCED_REGEN].tier = 4;
    g_sfeBuffCatalog[c_BUFF_T4_ENHANCED_REGEN].cost = 12500;
    g_sfeBuffCatalog[c_BUFF_T4_ENHANCED_REGEN].name = "Enhanced Regen";
    g_sfeBuffCatalog[c_BUFF_T4_ENHANCED_REGEN].description = "+25% y +40 Regen Vida/Escudos (Doble tras 10s fuera de combate).";

    g_sfeBuffCatalog[c_BUFF_T4_MENTAL_POWER].tier = 4;
    g_sfeBuffCatalog[c_BUFF_T4_MENTAL_POWER].cost = 12500;
    g_sfeBuffCatalog[c_BUFF_T4_MENTAL_POWER].name = "Mental Power";
    g_sfeBuffCatalog[c_BUFF_T4_MENTAL_POWER].description = "+30 Regen Energia, +50% Energia Maxima.";

    g_sfeBuffCatalog[c_BUFF_T4_QUANTUM_FIELD].tier = 4;
    g_sfeBuffCatalog[c_BUFF_T4_QUANTUM_FIELD].cost = 12500;
    g_sfeBuffCatalog[c_BUFF_T4_QUANTUM_FIELD].name = "Quantum Field";
    g_sfeBuffCatalog[c_BUFF_T4_QUANTUM_FIELD].description = "+200% Energia Maxima. Sobrecarga de +75% Danio Magico al 100% Mana.";

    g_sfeBuffCatalog[c_BUFF_T4_STATIC_CHARGE].tier = 4;
    g_sfeBuffCatalog[c_BUFF_T4_STATIC_CHARGE].cost = 12500;
    g_sfeBuffCatalog[c_BUFF_T4_STATIC_CHARGE].name = "Static Charge";
    g_sfeBuffCatalog[c_BUFF_T4_STATIC_CHARGE].description = "+20 Regen. Recibir impactos otorga cargas de danio y regeneracion.";

    // Tier 5
    g_sfeBuffCatalog[c_BUFF_T5_SHARPSHOOTER].tier = 5;
