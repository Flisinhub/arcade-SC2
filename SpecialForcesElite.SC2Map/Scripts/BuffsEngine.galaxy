    g_sfeBuffCatalog[c_BUFF_T2_ANCIENT_VALOR].name = "Ancient Valor";
    g_sfeBuffCatalog[c_BUFF_T2_ANCIENT_VALOR].description = "+20% Danio Habilidades, +5% Energia Max, +5% Danio Arma.";

    g_sfeBuffCatalog[c_BUFF_T2_IMPACT].tier = 2;
    g_sfeBuffCatalog[c_BUFF_T2_IMPACT].cost = 7500;
    g_sfeBuffCatalog[c_BUFF_T2_IMPACT].name = "Impact";
    g_sfeBuffCatalog[c_BUFF_T2_IMPACT].description = "+25 Danio Base Arma y Habilidades, +0.5 Rango Ataque.";

    g_sfeBuffCatalog[c_BUFF_T2_TRANSIENT].tier = 2;
    g_sfeBuffCatalog[c_BUFF_T2_TRANSIENT].cost = 7500;
