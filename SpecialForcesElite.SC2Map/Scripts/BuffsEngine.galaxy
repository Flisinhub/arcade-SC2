    g_sfeBuffCatalog[c_BUFF_T1_OPTICAL_LENS].name = "Optical Lens";
    g_sfeBuffCatalog[c_BUFF_T1_OPTICAL_LENS].description = "+10 Vision, +12 Deteccion, Sigilo tras 2s sin danio.";

    // Tier 2
    g_sfeBuffCatalog[c_BUFF_T2_ADV_ARMOR].tier = 2;
    g_sfeBuffCatalog[c_BUFF_T2_ADV_ARMOR].cost = 7500;
    g_sfeBuffCatalog[c_BUFF_T2_ADV_ARMOR].name = "Advanced Armor";
    g_sfeBuffCatalog[c_BUFF_T2_ADV_ARMOR].description = "+5% Reduccion Danio, +75 Blindaje Base, +50% Blindaje.";

