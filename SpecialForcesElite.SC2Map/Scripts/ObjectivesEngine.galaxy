//==================================================================================================
// Special Forces Elite 5 - Territorial Campaign & Objectives Engine
// Máquina de estados de la campaña territorial (4 fases consecutivas de avance),
// generación de Mini-Jefes en Mesetas, combate final contra Kerrigan y pantalla de Victoria.
//==================================================================================================

#ifndef SFE_OBJECTIVESENGINE_INCLUDED
#define SFE_OBJECTIVESENGINE_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Attributes.galaxy"
include "Scripts/AlliedBase.galaxy"

// Declaraciones de funciones
void SFE_InitObjectivesEngine ();
void SFE_ObjectivesTickSecond ();
void SFE_SpawnMiniBosses ();
void SFE_SpawnFinalBossKerrigan ();
void SFE_KerriganCombatAI ();
void SFE_TriggerVictorySequence ();
text SFE_GetObjectiveCurrentText ();

// Variables de UI para el Diálogo de Victoria
int g_sfeVictoryDialog;
int g_sfeVictoryBtnExit;

//--------------------------------------------------------------------------------------------------
// Inicialización del Motor de Objetivos
//--------------------------------------------------------------------------------------------------
void SFE_InitObjectivesEngine () {
    g_sfeCurrentObjectiveStage = c_OBJ_STAGE_OUTPOSTS;
    g_sfeOutpostsDestroyedCount = 0;
    g_sfeOutpostNorthDestroyed = false;
    g_sfeOutpostEastDestroyed = false;
    g_sfeOutpostWestDestroyed = false;

    g_sfeFrankensteinSpawned = false;
    g_sfeRupturerSpawned = false;
    g_sfeStankSpawned = false;
    g_sfeFrankensteinAlive = false;
    g_sfeRupturerAlive = false;
    g_sfeStankAlive = false;

    g_sfeKerriganSpawned = false;
    g_sfeKerriganAlive = false;
    g_sfeFinalHiveDestroyed = false;
    g_sfeGameWon = false;

    // Proteger la Gran Colmena con escudo invulnerable hasta llegar a la Fase 3
    if (g_sfeFinalHiveUnit != null) {
        UnitSetState(g_sfeFinalHiveUnit, c_unitStateInvulnerable, true);
    }
}

//--------------------------------------------------------------------------------------------------
// Invocación de Mini-Jefes en las 3 Mesetas Estratégicas de Cruce
//--------------------------------------------------------------------------------------------------
void SFE_SpawnMiniBosses () {
    unit u;

    // 1. Frankenstein (Meseta Noroeste - Cruce Norte)
    UnitCreate(1, "Aberration", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauNorthWest, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Ultralisk", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauNorthWest, 225.0);
        u = UnitLastCreated();
    }
    g_sfeMiniBossFrankenstein = u;
    UnitSetPropertyFixed(u, c_unitPropLifeMax, 8500.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 10.0);
    g_sfeFrankensteinSpawned = true;
    g_sfeFrankensteinAlive = true;
    VisRevealerCreate(1, RegionCircle(g_sfePlateauNorthWest, 12.0));

    // 2. Rupturer (Meseta Sureste - Cruce Sur)
    UnitCreate(1, "Ravager", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauSouthEast, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Roach", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauSouthEast, 225.0);
        u = UnitLastCreated();
    }
    g_sfeMiniBossRupturer = u;
    UnitSetPropertyFixed(u, c_unitPropLifeMax, 9500.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 10.0);
    g_sfeRupturerSpawned = true;
    g_sfeRupturerAlive = true;
    VisRevealerCreate(1, RegionCircle(g_sfePlateauSouthEast, 12.0));

    // 3. The Stank (Meseta Central - Cruce Mayor)
    UnitCreate(1, "Stank", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauCenter, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Ultralisk", 0, c_SFE_PLAYER_HOSTILE, g_sfePlateauCenter, 225.0);
        u = UnitLastCreated();
    }
    g_sfeMiniBossStank = u;
    UnitSetPropertyFixed(u, c_unitPropLifeMax, 15000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 15.0);
    g_sfeStankSpawned = true;
    g_sfeStankAlive = true;
    VisRevealerCreate(1, RegionCircle(g_sfePlateauCenter, 14.0));

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF0044\">[¡ALERTA MAYOR!] 3 Mini-Jefes han tomado posiciones en las Mesetas Elevadas: ¡Frankenstein (NO), Rupturer (SE) y The Stank (Centro)!</c></b>"));
}

//--------------------------------------------------------------------------------------------------
// Invocación del Jefe Supremo: La Reina de Espadas (Kerrigan)
//--------------------------------------------------------------------------------------------------
void SFE_SpawnFinalBossKerrigan () {
    unit u;

    UnitCreate(1, "Kerrigan", 0, c_SFE_PLAYER_HOSTILE, g_sfeFinalHivePoint, 225.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "Ghost", 0, c_SFE_PLAYER_HOSTILE, g_sfeFinalHivePoint, 225.0);
        u = UnitLastCreated();
    }
    g_sfeFinalBossKerrigan = u;
    UnitSetPropertyFixed(u, c_unitPropLifeMax, 30000.0 * g_sfeDiffHostileStatMultiplier[g_sfeCurrentDifficulty]);
    UnitSetPropertyFixed(u, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(u, c_unitPropLifeRegen, 25.0);
    UnitSetPropertyFixed(u, c_unitPropEnergyMax, 500.0);
    UnitSetPropertyFixed(u, c_unitPropEnergyPercent, 100.0);

    g_sfeKerriganSpawned = true;
    g_sfeKerriganAlive = true;

    // Escolta de Torrasques de Élite
    UnitCreate(2, "Ultralisk", 0, c_SFE_PLAYER_HOSTILE, g_sfeFinalHivePoint, 225.0);

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FF00FF\">[¡ALERTA APOCALÍPTICA!] ¡LA REINA DE ESPADAS (KERRIGAN) HA EMERGIDO DE LA COLMENA! ¡ANIKÍLALA PARA PURGAR EL ENJAMBRE!</c></b>"));
}

//--------------------------------------------------------------------------------------------------
// IA de Combate de Kerrigan (Tormenta Psiónica y Choque Cinético)
//--------------------------------------------------------------------------------------------------
void SFE_KerriganCombatAI () {
    point kPos;
    unitgroup ug;
    int count;
    int i;
    unit target;

    if (!g_sfeKerriganSpawned || !g_sfeKerriganAlive || g_sfeFinalBossKerrigan == null) {
        return;
    }

    if (!UnitIsAlive(g_sfeFinalBossKerrigan)) {
        g_sfeKerriganAlive = false;
        return;
    }

    kPos = UnitGetPosition(g_sfeFinalBossKerrigan);
    ug = UnitGroup(null, c_SFE_PLAYER_ALLIED_BASE, RegionCircle(kPos, 11.0), null, 0);
    count = UnitGroupCount(ug, c_unitCountAlive);

    if (count > 0) {
        // Impacto cinético en área cada ciclo
        i = 1;
        while (i <= count) {
            target = UnitGroupUnit(ug, i);
            UnitDamage(g_sfeFinalBossKerrigan, "WeaponNull", target, 160.0);
            i = i + 1;
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Bucle Por Segundo del Motor de Objetivos
//--------------------------------------------------------------------------------------------------
void SFE_ObjectivesTickSecond () {
    int p;
    fixed hiveHpPct;

    if (g_sfeGameWon) {
        return;
    }

    // 1. Verificación de Fase 1: Destrucción de los 3 Reductos Perimetrales
    if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_OUTPOSTS) {
        if (g_sfeOutpostNorth != null && !UnitIsAlive(g_sfeOutpostNorth) && !g_sfeOutpostNorthDestroyed) {
            g_sfeOutpostNorthDestroyed = true;
            g_sfeOutpostsDestroyedCount = g_sfeOutpostsDestroyedCount + 1;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[OBJETIVO] ¡Reducto Noroeste (Spawning Pool) destruido! (+1500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1500);
                p = p + 1;
            }
        }

        if (g_sfeOutpostEast != null && !UnitIsAlive(g_sfeOutpostEast) && !g_sfeOutpostEastDestroyed) {
            g_sfeOutpostEastDestroyed = true;
            g_sfeOutpostsDestroyedCount = g_sfeOutpostsDestroyedCount + 1;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[OBJETIVO] ¡Reducto Sureste (Roach Warren) destruido! (+1500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1500);
                p = p + 1;
            }
        }

        if (g_sfeOutpostWest != null && !UnitIsAlive(g_sfeOutpostWest) && !g_sfeOutpostWestDestroyed) {
            g_sfeOutpostWestDestroyed = true;
            g_sfeOutpostsDestroyedCount = g_sfeOutpostsDestroyedCount + 1;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[OBJETIVO] ¡Reducto Central (Nexo Protoss) destruido! (+1500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 1500);
                p = p + 1;
            }
        }

        if (g_sfeOutpostsDestroyedCount >= 3) {
            g_sfeCurrentObjectiveStage = c_OBJ_STAGE_PLATEAUS;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"00FFEA\">[FASE 1 COMPLETADA] ¡Perímetro asegurado! Avanzad hacia las Mesetas Estratégicas y tomad los cruces de caminos.</c></b>"));
            SFE_SpawnMiniBosses();
        }
    }

    // 2. Verificación de Fase 2: Eliminación de los 3 Mini-Jefes de Meseta
    else if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_PLATEAUS) {
        if (g_sfeFrankensteinAlive && g_sfeMiniBossFrankenstein != null && !UnitIsAlive(g_sfeMiniBossFrankenstein)) {
            g_sfeFrankensteinAlive = false;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[MINI-JEFE ABATIDO] ¡Frankenstein aniquilado en la Meseta Noroeste! (+2500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
                p = p + 1;
            }
        }

        if (g_sfeRupturerAlive && g_sfeMiniBossRupturer != null && !UnitIsAlive(g_sfeMiniBossRupturer)) {
            g_sfeRupturerAlive = false;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[MINI-JEFE ABATIDO] ¡Rupturer aniquilado en la Meseta Sureste! (+2500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 2500);
                p = p + 1;
            }
        }

        if (g_sfeStankAlive && g_sfeMiniBossStank != null && !UnitIsAlive(g_sfeMiniBossStank)) {
            g_sfeStankAlive = false;
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"55FF55\">[MINI-JEFE ABATIDO] ¡The Stank aniquilado en la Meseta Central! (+3500 minerales)</c></b>"));
            p = 1;
            while (p <= c_SFE_MAX_PLAYERS) {
                PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperAdd, 3500);
                p = p + 1;
            }
        }

        if (!g_sfeFrankensteinAlive && !g_sfeRupturerAlive && !g_sfeStankAlive) {
            g_sfeCurrentObjectiveStage = c_OBJ_STAGE_HIVE_ASSAULT;
            if (g_sfeFinalHiveUnit != null) {
                UnitSetState(g_sfeFinalHiveUnit, c_unitStateInvulnerable, false);
            }
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                StringToText("<b><c val=\"FF0044\">[FASE 2 COMPLETADA] ¡Mesetas aseguradas! El escudo de la Gran Colmena ha colapsado. ¡Asaltad la esquina Noreste!</c></b>"));
        }
    }

    // 3. Verificación de Fase 3: Asedio a la Colmena Noreste y Kerrigan
    else if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_HIVE_ASSAULT) {
        if (g_sfeFinalHiveUnit != null && UnitIsAlive(g_sfeFinalHiveUnit)) {
            hiveHpPct = UnitGetPropertyFixed(g_sfeFinalHiveUnit, c_unitPropLifePercent, false);
            if (hiveHpPct <= 50.0 && !g_sfeKerriganSpawned) {
                SFE_SpawnFinalBossKerrigan();
            }
        } else {
            g_sfeFinalHiveDestroyed = true;
        }

        // Ejecutar IA táctica de combate de Kerrigan
        if (g_sfeKerriganSpawned && g_sfeKerriganAlive) {
            SFE_KerriganCombatAI();
            if (g_sfeFinalBossKerrigan != null && !UnitIsAlive(g_sfeFinalBossKerrigan)) {
                g_sfeKerriganAlive = false;
                UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
                    StringToText("<b><c val=\"FF00FF\">¡LA REINA DE ESPADAS HA CAÍDO! ¡REMATAD LA GRAN COLMENA PARA LA VICTORIA TOTAL!</c></b>"));
            }
        }

        // Condición de Victoria Absoluta: Kerrigan derrotada y Colmena destruida
        if (g_sfeKerriganSpawned && !g_sfeKerriganAlive && g_sfeFinalHiveDestroyed) {
            g_sfeCurrentObjectiveStage = c_OBJ_STAGE_VICTORY;
            SFE_TriggerVictorySequence();
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Disparo y Presentación de la Secuencia de Victoria
//--------------------------------------------------------------------------------------------------
void SFE_TriggerVictorySequence () {
    int minutes;
    int seconds;
    string timeStr;
    string rankStr;
    text vicSummary;
    int ctrl;

    g_sfeGameWon = true;

    minutes = g_sfeGameElapsedSeconds / 60;
    seconds = g_sfeGameElapsedSeconds % 60;
    timeStr = IntToString(minutes) + "m " + IntToString(seconds) + "s";

    if (g_sfeCurrentDifficulty == c_DIFF_TORMENT) {
        rankStr = "S (Rango Torment Supremo)";
    } else if (g_sfeCurrentDifficulty >= c_DIFF_BRUTAL) {
        rankStr = "A+ (Rango Veterano de Élite)";
    } else if (g_sfeCurrentDifficulty >= c_DIFF_HARD) {
        rankStr = "A (Rango Especialista)";
    } else {
        rankStr = "B (Rango Escuadrón)";
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FFE400\">*******************************************************</c></b>"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"00FFEA\">¡¡¡VICTORIA COMPLETA EN SPECIAL FORCES ELITE 5!!!</c></b>"));
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, 
        StringToText("<b><c val=\"FFE400\">*******************************************************</c></b>"));

    // Modal de Victoria en el centro de la pantalla
    g_sfeVictoryDialog = DialogCreate(620, 480, c_anchorCenter, 0, 0, true);
    DialogSetImage(g_sfeVictoryDialog, "Assets\\Textures\\ui_glue_backgrounddialog.dds");

    // Título
    DialogControlCreate(g_sfeVictoryDialog, c_triggerControlTypeLabel);
    ctrl = DialogControlLastCreated();
    DialogControlSetSize(ctrl, PlayerGroupAll(), 580, 50);
    DialogControlSetPosition(ctrl, PlayerGroupAll(), c_anchorTop, 0, 25);
    DialogControlSetPropertyAsText(ctrl, c_triggerControlPropertyText, PlayerGroupAll(), 
        StringToText("<b><c val=\"00FFEA\">¡MISIÓN CUMPLIDA - VICTORIA TOTAL!</c></b>"));

    // Resumen de Estadísticas
    vicSummary = StringToText("<b><c val=\"FFE400\">SPECIAL FORCES ELITE 5 - RESUMEN DE CAMPAÑA</c>\n\n" +
        "<c val=\"FFFFFF\">Dificultad Superada:</c> <c val=\"00FFEA\">" + g_sfeDiffNames[g_sfeCurrentDifficulty] + "</c>\n" +
        "<c val=\"FFFFFF\">Tiempo de Conquista:</c> <c val=\"FFFF00\">" + timeStr + "</c>\n" +
        "<c val=\"FFFFFF\">Reductos Hostiles Purgados:</c> <c val=\"55FF55\">3 / 3 (100%)</c>\n" +
        "<c val=\"FFFFFF\">Mesetas Tácticas Conquistadas:</c> <c val=\"55FF55\">4 / 4 (100%)</c>\n" +
        "<c val=\"FFFFFF\">Mini-Jefes Abatidos:</c> <c val=\"55FF55\">Frankenstein, Rupturer, The Stank</c>\n" +
        "<c val=\"FFFFFF\">Jefe Supremo Eliminado:</c> <c val=\"FF00FF\">Reina de Espadas (Kerrigan)</c>\n\n" +
        "<c val=\"FFFFFF\">Rango de Honor Otorgado:</c> <c val=\"FFE400\">" + rankStr + "</c></b>");

    DialogControlCreate(g_sfeVictoryDialog, c_triggerControlTypeLabel);
    ctrl = DialogControlLastCreated();
    DialogControlSetSize(ctrl, PlayerGroupAll(), 560, 240);
    DialogControlSetPosition(ctrl, PlayerGroupAll(), c_anchorTop, 0, 95);
    DialogControlSetPropertyAsText(ctrl, c_triggerControlPropertyText, PlayerGroupAll(), vicSummary);

    // Visible para todos los jugadores
    DialogSetVisible(g_sfeVictoryDialog, PlayerGroupAll(), true);
}

//--------------------------------------------------------------------------------------------------
// Texto Descriptivo Dinámico del Objetivo para el Panel HUD
//--------------------------------------------------------------------------------------------------
text SFE_GetObjectiveCurrentText () {
    string t1;
    string t2;
    string t3;

    if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_OUTPOSTS) {
        if (g_sfeOutpostNorthDestroyed) { t1 = "<c val=\"55FF55\">[DESTRUIDO]</c>"; } else { t1 = "<c val=\"FF4444\">[ACTIVO]</c>"; }
        if (g_sfeOutpostEastDestroyed)  { t2 = "<c val=\"55FF55\">[DESTRUIDO]</c>"; } else { t2 = "<c val=\"FF4444\">[ACTIVO]</c>"; }
        if (g_sfeOutpostWestDestroyed)  { t3 = "<c val=\"55FF55\">[DESTRUIDO]</c>"; } else { t3 = "<c val=\"FF4444\">[ACTIVO]</c>"; }

        return StringToText("<b><c val=\"FFE400\">[FASE 1/3]: Limpiar Reductos Hostiles (" + IntToString(g_sfeOutpostsDestroyedCount) + "/3)</c>\n" +
            "  * Nido NO (Spawning Pool): " + t1 + "\n" +
            "  * Nido SE (Roach Warren): " + t2 + "\n" +
            "  * Nido Centro (Nexo Protoss): " + t3 + "\n" +
            "<c val=\"AAAAAA\">Botín: +1500 minerales por nido destruido</c></b>");
    } else if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_PLATEAUS) {
        if (!g_sfeFrankensteinAlive) { t1 = "<c val=\"55FF55\">[ELIMINADO]</c>"; } else { t1 = "<c val=\"FF4444\">[VIVO]</c>"; }
        if (!g_sfeRupturerAlive)     { t2 = "<c val=\"55FF55\">[ELIMINADO]</c>"; } else { t2 = "<c val=\"FF4444\">[VIVO]</c>"; }
        if (!g_sfeStankAlive)        { t3 = "<c val=\"55FF55\">[ELIMINADO]</c>"; } else { t3 = "<c val=\"FF4444\">[VIVO]</c>"; }

        return StringToText("<b><c val=\"FFE400\">[FASE 2/3]: Conquistar Mesetas y Mini-Jefes</c>\n" +
            "  * Meseta NO (Frankenstein): " + t1 + "\n" +
            "  * Meseta SE (Rupturer): " + t2 + "\n" +
            "  * Meseta Central (The Stank): " + t3 + "\n" +
            "<c val=\"00FFEA\">¡Despliega defensas en las 4 mesetas elevadas!</c></b>");
    } else if (g_sfeCurrentObjectiveStage == c_OBJ_STAGE_HIVE_ASSAULT) {
        if (g_sfeFinalHiveDestroyed) { t1 = "<c val=\"55FF55\">[DESTRUIDA]</c>"; } else { t1 = "<c val=\"FF4444\">[VULNERABLE]</c>"; }
        if (g_sfeKerriganSpawned) {
            if (!g_sfeKerriganAlive) { t2 = "<c val=\"55FF55\">[ELIMINADA]</c>"; } else { t2 = "<c val=\"FF00FF\">[EN COMBATE]</c>"; }
        } else {
            t2 = "<c val=\"AAAAAA\">[EN ESPERA]</c>";
        }

        return StringToText("<b><c val=\"FF0044\">[FASE 3/3]: Asalto Final a la Gran Colmena</c>\n" +
            "  * Gran Colmena Noreste: " + t1 + "\n" +
            "  * Reina de Espadas (Kerrigan): " + t2 + "\n" +
            "<c val=\"FFE400\">¡Destruye a Kerrigan y la Colmena para la Victoria!</c></b>");
    }

    return StringToText("<b><c val=\"00FFEA\">¡¡¡MISIÓN CUMPLIDA - VICTORIA TOTAL!!!</c></b>");
}

#endif
