//==================================================================================================
// Special Forces Elite 5 - Hero Active Combat Abilities System
// Habilidades tácticas activas vinculadas a los héroes canónicos (Q y E)
// integradas con la reserva de maná/energía otorgada por Inteligencia.
//==================================================================================================

#ifndef SFE_HEROABILITIES_INCLUDED
#define SFE_HEROABILITIES_INCLUDED

include "Scripts/Constants.galaxy"

// Declaraciones de funciones
string SFE_GetHeroAbility1Name (int heroId);
string SFE_GetHeroAbility2Name (int heroId);
int SFE_GetHeroAbility1Cost (int heroId);
int SFE_GetHeroAbility2Cost (int heroId);
void SFE_CastHeroAbility1 (int player);
void SFE_CastHeroAbility2 (int player);

//--------------------------------------------------------------------------------------------------
// Obtener Nombre de la Habilidad 1 (Atajo [Q])
//--------------------------------------------------------------------------------------------------
string SFE_GetHeroAbility1Name (int heroId) {
    if (heroId == c_HERO_RAYNOR || heroId == c_HERO_KERRIGAN || heroId == c_HERO_DUKE || heroId == c_HERO_MONTAG) {
        return "Disparo de Precisión [Q]";
    } else if (heroId == c_HERO_SWANN || heroId == c_HERO_BLACKHAMMER) {
        return "Cañón Pesado [Q]";
    } else if (heroId == c_HERO_TASSADAR || heroId == c_HERO_REVENANT) {
        return "Tormenta Psiónica [Q]";
    } else if (heroId == c_HERO_SHADOW_WALKER) {
        return "Haz Desintegrador [Q]";
    } else if (heroId == c_HERO_TORRASQUE || heroId == c_HERO_STUKOV) {
        return "Hendidura Sísmica [Q]";
    } else if (heroId == c_HERO_NYAMI) {
        return "Aluvión de Espinas [Q]";
    }
    return "Descarga Concentrada [Q]";
}

//--------------------------------------------------------------------------------------------------
// Obtener Nombre de la Habilidad 2 (Atajo [E])
//--------------------------------------------------------------------------------------------------
string SFE_GetHeroAbility2Name (int heroId) {
    if (heroId == c_HERO_RAYNOR || heroId == c_HERO_KERRIGAN || heroId == c_HERO_DUKE || heroId == c_HERO_MONTAG) {
        return "Granada PEM Táctica [E]";
    } else if (heroId == c_HERO_SWANN || heroId == c_HERO_BLACKHAMMER) {
        return "Blindaje Reforzado [E]";
    } else if (heroId == c_HERO_TASSADAR || heroId == c_HERO_REVENANT || heroId == c_HERO_SHADOW_WALKER) {
        return "Sobrecarga de Escudos [E]";
    } else if (heroId == c_HERO_TORRASQUE || heroId == c_HERO_NYAMI || heroId == c_HERO_STUKOV) {
        return "Furia del Enjambre [E]";
    }
    return "Pulso Deflector [E]";
}

//--------------------------------------------------------------------------------------------------
// Coste de Energía de las Habilidades
//--------------------------------------------------------------------------------------------------
int SFE_GetHeroAbility1Cost (int heroId) {
    return 35;
}

int SFE_GetHeroAbility2Cost (int heroId) {
    return 40;
}

//--------------------------------------------------------------------------------------------------
// Ejecutar Habilidad 1 (Atajo [Q])
//--------------------------------------------------------------------------------------------------
void SFE_CastHeroAbility1 (int player) {
    unit uHero;
    int hid;
    fixed currentEnergy;
    fixed cost;
    point hPos;
    unitgroup ug;
    int count;
    int i;
    unit target;
    fixed damage;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeHeroStates[player].isActive) {
        return;
    }

    uHero = g_sfeHeroStates[player].heroUnit;
    if (uHero == null || !UnitIsAlive(uHero)) {
        return;
    }

    hid = g_sfeHeroStates[player].heroId;
    cost = IntToFixed(SFE_GetHeroAbility1Cost(hid));
    currentEnergy = UnitGetPropertyFixed(uHero, c_unitPropEnergy, true);

    if (currentEnergy < cost) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"FF4444\">Energía insuficiente (Requiere " + FixedToString(cost, 0) + " Maná).</c></b>"));
        return;
    }

    UnitSetPropertyFixed(uHero, c_unitPropEnergy, currentEnergy - cost);
    hPos = UnitGetPosition(uHero);

    if (hid == c_HERO_RAYNOR || hid == c_HERO_KERRIGAN || hid == c_HERO_DUKE || hid == c_HERO_MONTAG || hid == c_HERO_SWANN || hid == c_HERO_BLACKHAMMER) {
        // Disparo de Francotirador / Precisión a objetivo prioritario en radio 14
        ug = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(hPos, 14.0), null, 0);
        target = UnitGroupNearestUnit(ug, hPos);
        if (target != null && UnitIsAlive(target)) {
            damage = 450.0 + (IntToFixed(g_sfeHeroStates[player].dexterity) * 5.0) + (IntToFixed(g_sfeHeroStates[player].strength) * 2.0);
            UnitDamage(uHero, "WeaponNull", target, damage);
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
                StringToText("<b><c val=\"00FFEA\">¡DISPARO DE ALTA POTENCIA! (-" + FixedToString(damage, 0) + " Daño)</c></b>"));
        } else {
            UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
                StringToText("<b><c val=\"FFFF00\">Sin objetivos hostiles en el rango de tiro (14m).</c></b>"));
        }
    } else if (hid == c_HERO_TASSADAR || hid == c_HERO_REVENANT || hid == c_HERO_SHADOW_WALKER) {
        // Tormenta Psiónica en área (radio 7)
        damage = 320.0 + (IntToFixed(g_sfeHeroStates[player].intelligence) * 6.0);
        ug = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(hPos, 7.0), null, 0);
        count = UnitGroupCount(ug, c_unitCountAlive);
        i = 1;
        while (i <= count) {
            target = UnitGroupUnit(ug, i);
            UnitDamage(uHero, "WeaponNull", target, damage);
            i = i + 1;
        }
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"00FFEA\">¡TORMENTA PSIÓNICA DESATADA! (" + IntToString(count) + " objetivos impactados)</c></b>"));
    } else {
        // Hendidura Sísmica / Torbellino de impacto en radio 5.5
        damage = 280.0 + (IntToFixed(g_sfeHeroStates[player].strength) * 5.0);
        ug = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(hPos, 5.5), null, 0);
        count = UnitGroupCount(ug, c_unitCountAlive);
        i = 1;
        while (i <= count) {
            target = UnitGroupUnit(ug, i);
            UnitDamage(uHero, "WeaponNull", target, damage);
            i = i + 1;
        }
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"FFB700\">¡HENDIDURA DE COMBATE! (" + IntToString(count) + " objetivos impactados)</c></b>"));
    }
}

//--------------------------------------------------------------------------------------------------
// Ejecutar Habilidad 2 (Atajo [E])
//--------------------------------------------------------------------------------------------------
void SFE_CastHeroAbility2 (int player) {
    unit uHero;
    int hid;
    fixed currentEnergy;
    fixed cost;
    point hPos;
    unitgroup ug;
    int count;
    int i;
    unit target;
    fixed damage;
    fixed curShields;
    fixed maxShields;
    fixed curLife;
    fixed maxLife;

    if (player < 1 || player > c_SFE_MAX_PLAYERS || !g_sfeHeroStates[player].isActive) {
        return;
    }

    uHero = g_sfeHeroStates[player].heroUnit;
    if (uHero == null || !UnitIsAlive(uHero)) {
        return;
    }

    hid = g_sfeHeroStates[player].heroId;
    cost = IntToFixed(SFE_GetHeroAbility2Cost(hid));
    currentEnergy = UnitGetPropertyFixed(uHero, c_unitPropEnergy, true);

    if (currentEnergy < cost) {
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"FF4444\">Energía insuficiente (Requiere " + FixedToString(cost, 0) + " Maná).</c></b>"));
        return;
    }

    UnitSetPropertyFixed(uHero, c_unitPropEnergy, currentEnergy - cost);
    hPos = UnitGetPosition(uHero);

    if (hid == c_HERO_RAYNOR || hid == c_HERO_KERRIGAN || hid == c_HERO_DUKE || hid == c_HERO_MONTAG || hid == c_HERO_SWANN || hid == c_HERO_BLACKHAMMER) {
        // Granada PEM Táctica: daña en radio 6 y cura al héroe 25% de vida
        ug = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(hPos, 6.0), null, 0);
        count = UnitGroupCount(ug, c_unitCountAlive);
        damage = 220.0 + (IntToFixed(g_sfeHeroStates[player].intelligence) * 4.0);
        i = 1;
        while (i <= count) {
            target = UnitGroupUnit(ug, i);
            UnitDamage(uHero, "WeaponNull", target, damage);
            i = i + 1;
        }
        curLife = UnitGetPropertyFixed(uHero, c_unitPropLife, true);
        maxLife = UnitGetPropertyFixed(uHero, c_unitPropLifeMax, false);
        UnitSetPropertyFixed(uHero, c_unitPropLife, MinF(maxLife, curLife + (maxLife * 0.25)));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"00FFEA\">¡GRANADA PEM DETONADA! (+25% Salud Restaurada)</c></b>"));
    } else if (hid == c_HERO_TASSADAR || hid == c_HERO_REVENANT || hid == c_HERO_SHADOW_WALKER) {
        // Sobrecarga de Escudos Plasmáticos: restaura hasta 600 escudos instantáneamente
        curShields = UnitGetPropertyFixed(uHero, c_unitPropShields, true);
        maxShields = UnitGetPropertyFixed(uHero, c_unitPropShieldsMax, false);
        UnitSetPropertyFixed(uHero, c_unitPropShields, MinF(maxShields, curShields + 600.0));
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"00CCFF\">¡SOBRECARGA DE ESCUDOS ACTIVADA! (+600 Escudos)</c></b>"));
    } else {
        // Furia del Enjambre / Carga Berserk: regenera salud y pulso de choque
        curLife = UnitGetPropertyFixed(uHero, c_unitPropLife, true);
        maxLife = UnitGetPropertyFixed(uHero, c_unitPropLifeMax, false);
        UnitSetPropertyFixed(uHero, c_unitPropLife, MinF(maxLife, curLife + 450.0));
        damage = 250.0 + (IntToFixed(g_sfeHeroStates[player].strength) * 4.0);
        ug = UnitGroup(null, c_SFE_PLAYER_HOSTILE, RegionCircle(hPos, 5.0), null, 0);
        count = UnitGroupCount(ug, c_unitCountAlive);
        i = 1;
        while (i <= count) {
            target = UnitGroupUnit(ug, i);
            UnitDamage(uHero, "WeaponNull", target, damage);
            i = i + 1;
        }
        UIDisplayMessage(PlayerGroupSingle(player), c_messageAreaSubtitle, 
            StringToText("<b><c val=\"FF4444\">¡FURIA DE ENJAMBRE DESATADA! (+450 Salud restaurada y choque en área)</c></b>"));
    }
}

#endif
