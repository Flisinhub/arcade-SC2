//==================================================================================================
// Special Forces Elite 5 - Allied Base & Victory/Defeat Engine
// Fortaleza central aliada, defensas perimetrales y condiciones de fin de partida
//==================================================================================================

#ifndef SFE_ALLIEDBASE_INCLUDED
#define SFE_ALLIEDBASE_INCLUDED

include "Scripts/Constants.galaxy"
include "Scripts/Persistence.galaxy"
include "Scripts/Attributes.galaxy"
include "Scripts/HUD.galaxy"

unit g_sfeBaseCoreUnit;
unit g_sfeMedic1;
unit g_sfeMedic2;
point g_sfeBaseCenterPoint;
bool g_sfeGameOverTriggered;

// Declaraciones
void SFE_TriggerDefeat ();
void SFE_TriggerVictory ();
void SFE_BaseHealHeroesTick ();

//--------------------------------------------------------------------------------------------------
// Inicializar la Base Aliada y Estructuras Defensivas
//--------------------------------------------------------------------------------------------------
void SFE_InitAlliedBase () {
    point pCore;
    point pDefense;
    unit u;

    g_sfeBaseCenterPoint = Point(100.0, 100.0);
    g_sfeGameOverTriggered = false;
    g_sfeBaseCoreHpPercent = 100.0;

    // Crear Fortaleza Planetaria Troncal (Jugador 14 - Aliado)
    UnitCreate(1, "PlanetaryFortress", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 270.0);
    u = UnitLastCreated();
    if (u == null) {
        UnitCreate(1, "CommandCenter", 0, c_SFE_PLAYER_ALLIED_BASE, g_sfeBaseCenterPoint, 270.0);
        u = UnitLastCreated();
    }
    g_sfeBaseCoreUnit = u;
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeMax, 8000.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifeRegen, 5.0);

    // Torretas y Bunkers en los 4 accesos cardinales
    // Norte
    pDefense = Point(100.0, 115.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 270.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(94.0, 115.0), 270.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(106.0, 115.0), 270.0);

    // Sur
    pDefense = Point(100.0, 85.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(94.0, 85.0), 90.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(106.0, 85.0), 90.0);

    // Este
    pDefense = Point(115.0, 100.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 180.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(115.0, 94.0), 180.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(115.0, 106.0), 180.0);

    // Oeste
    pDefense = Point(85.0, 100.0);
    UnitCreate(1, "Bunker", 0, c_SFE_PLAYER_ALLIED_BASE, pDefense, 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(85.0, 94.0), 0.0);
    UnitCreate(1, "MissileTurret", 0, c_SFE_PLAYER_ALLIED_BASE, Point(85.0, 106.0), 0.0);

    // Médicos de Campaña Aliados para dar soporte continuo
    UnitCreate(1, "Medic", 0, c_SFE_PLAYER_ALLIED_BASE, Point(97.0, 95.0), 45.0);
    g_sfeMedic1 = UnitLastCreated();
    if (g_sfeMedic1 != null) {
        UnitSetPropertyFixed(g_sfeMedic1, c_unitPropEnergyPercent, 100.0);
    }

    UnitCreate(1, "Medic", 0, c_SFE_PLAYER_ALLIED_BASE, Point(103.0, 95.0), 135.0);
    g_sfeMedic2 = UnitLastCreated();
    if (g_sfeMedic2 != null) {
        UnitSetPropertyFixed(g_sfeMedic2, c_unitPropEnergyPercent, 100.0);
    }
}

//--------------------------------------------------------------------------------------------------
// Aura de Curación de la Base: Regenera héroes cercanos y ordena a los médicos
//--------------------------------------------------------------------------------------------------
void SFE_BaseHealHeroesTick () {
    int p;
    unit uHero;
    fixed curLife;
    fixed maxLife;
    fixed newLife;
    fixed dist;
    order ordHeal;
    bool healedAny;

    p = 1;
    healedAny = false;

    while (p <= c_SFE_MAX_PLAYERS) {
        if (g_sfeHeroStates[p].isActive) {
            uHero = g_sfeHeroStates[p].heroUnit;
            if (uHero != null && UnitIsAlive(uHero)) {
                dist = DistanceBetweenPoints(UnitGetPosition(uHero), g_sfeBaseCenterPoint);
                if (dist <= 18.0) {
                    curLife = UnitGetPropertyFixed(uHero, c_unitPropLife, true);
                    maxLife = UnitGetPropertyFixed(uHero, c_unitPropLifeMax, true);
                    if (curLife < maxLife) {
                        newLife = curLife + 35.0;
                        if (newLife > maxLife) {
                            newLife = maxLife;
                        }
                        UnitSetPropertyFixed(uHero, c_unitPropLife, newLife);

                        ordHeal = OrderTargetingUnit(AbilityCommand("MedicHeal", 0), uHero);
                        if (g_sfeMedic1 != null && UnitIsAlive(g_sfeMedic1)) {
                            UnitSetPropertyFixed(g_sfeMedic1, c_unitPropEnergyPercent, 100.0);
                            UnitIssueOrder(g_sfeMedic1, ordHeal, c_orderQueueReplace);
                        }
                        if (g_sfeMedic2 != null && UnitIsAlive(g_sfeMedic2)) {
                            UnitSetPropertyFixed(g_sfeMedic2, c_unitPropEnergyPercent, 100.0);
                            UnitIssueOrder(g_sfeMedic2, ordHeal, c_orderQueueReplace);
                        }
                        healedAny = true;
                    }
                }
            }
        }
        p = p + 1;
    }

    if (!healedAny) {
        if (g_sfeMedic1 != null && UnitIsAlive(g_sfeMedic1)) {
            UnitIssueOrder(g_sfeMedic1, OrderTargetingPoint(AbilityCommand("move", 0), Point(97.0, 95.0)), c_orderQueueReplace);
        }
        if (g_sfeMedic2 != null && UnitIsAlive(g_sfeMedic2)) {
            UnitIssueOrder(g_sfeMedic2, OrderTargetingPoint(AbilityCommand("move", 0), Point(103.0, 95.0)), c_orderQueueReplace);
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Comprobacion de Salud de la Base (Monitoreo regular)
//--------------------------------------------------------------------------------------------------
void SFE_UpdateBaseHealthStatus () {
    fixed currentHp;

    if (g_sfeGameOverTriggered) {
        return;
    }

    if (!UnitIsAlive(g_sfeBaseCoreUnit)) {
        SFE_TriggerDefeat();
        return;
    }

    currentHp = UnitGetPropertyFixed(g_sfeBaseCoreUnit, c_unitPropLifePercent, true);
    g_sfeBaseCoreHpPercent = currentHp;

    if (currentHp <= 0.0) {
        SFE_TriggerDefeat();
    }
}

//--------------------------------------------------------------------------------------------------
// Secuencia de Derrota
//--------------------------------------------------------------------------------------------------
void SFE_TriggerDefeat () {
    int p;
    text defText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    p = 1;
    defText = StringToText("<s val=\"ModCenterSize36Bold\"><c val=\"FF0000\">¡EL CUARTEL GENERAL HA SIDO DESTRUIDO!\nMISIÓN FALLIDA — DERROTA</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, defText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            GameOver(p, c_gameOverDefeat, true, true);
        }
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Secuencia de Victoria
//--------------------------------------------------------------------------------------------------
void SFE_TriggerVictory () {
    int p;
    text vicText;

    if (g_sfeGameOverTriggered) {
        return;
    }
    g_sfeGameOverTriggered = true;

    p = 1;
    vicText = StringToText("<s val=\"ModCenterSize36Bold\"><c val=\"00FF7F\">¡¡VICTORIA SUPREMA EN SPECIAL FORCES ELITE 5!!\nTODAS LAS HORDAS Y JEFES HAN SIDO ERRADICADOS</c></s>");
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, vicText);

    while (p <= c_SFE_MAX_PLAYERS) {
        if (PlayerType(p) == c_playerTypeUser) {
            // Registrar victoria de la dificultad alcanzada en el banco
            SFE_BankRecordVictory(p, g_sfeCurrentDifficulty);
            GameOver(p, c_gameOverVictory, true, true);
        }
        p = p + 1;
    }
}

#endif
