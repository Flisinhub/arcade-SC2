//--------------------------------------------------------------------------------------------------
// Trigger: Something Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_SomethingDestroyed_Func (bool testConds, bool runActions) {
    string auto9B719DF4_val;

    // Variable Declarations
    int lv_intMoney;

    // Variable Initialization
    lv_intMoney = 0;

    // Conditions
    if (testConds) {
        if (!(((UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeStructure) == true) || (UnitTypeTestAttribute(UnitGetType(EventUnit()), c_unitAttributeHeroic) == true)))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 15))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    auto9B719DF4_val = UnitGetType(EventUnit());
    if (auto9B719DF4_val == "Omegalisk") {
        lv_intMoney = 250;
    }
    else if (auto9B719DF4_val == "CreepTumorBurrowed") {
        lv_intMoney = 25;
    }
    else if (auto9B719DF4_val == "SporeCrawler") {
        lv_intMoney = 100;
    }
    else if (auto9B719DF4_val == "SpineCrawler") {
        lv_intMoney = 100;
    }
    else if (auto9B719DF4_val == "EvolutionChamber") {
        TriggerExecute(gt_DeathInfChamber, true, false);
        lv_intMoney = 200;
    }
    else if (auto9B719DF4_val == "SpawningPool") {
        TriggerExecute(gt_DeathSpawningPool, true, false);
        lv_intMoney = 300;
    }
    else if (auto9B719DF4_val == "Spire") {
        TriggerExecute(gt_DeathSpire, true, false);
        lv_intMoney = 400;
    }
    else if (auto9B719DF4_val == "RoachWarren") {
        TriggerExecute(gt_DeathRoach, true, false);
        lv_intMoney = 400;
    }
    else if (auto9B719DF4_val == "HydraliskDen") {
        TriggerExecute(gt_DeathHydralisk, true, false);
        lv_intMoney = 500;
    }
    else if (auto9B719DF4_val == "GreaterSpire") {
        TriggerExecute(gt_DeathGreaterSpire, true, false);
        lv_intMoney = 500;
    }
    else if (auto9B719DF4_val == "Hatchery") {
        lv_intMoney = 500;
    }
    else if (auto9B719DF4_val == "UltraliskCavern") {
        TriggerExecute(gt_DeathUltra, true, false);
        lv_intMoney = 750;
    }
    else if (auto9B719DF4_val == "Lair") {
        lv_intMoney = 1000;
    }
    else if (auto9B719DF4_val == "Hive") {
        lv_intMoney = 1500;
    }
    else if (auto9B719DF4_val == "KerriganChar") {
        gv_inKerriDeaths = (gv_inKerriDeaths + 1);
        lv_intMoney = 2500;
    }
    else {
    }
    if ((lv_intMoney > 0)) {
        TriggerExecute(gt_ReCalculatePlayers, true, true);
        TextTagCreate((StringExternal("Param/Value/DBDCB531") + IntToText(lv_intMoney)), 35, UnitGetPosition(EventUnit()), 0.4, true, false, PlayerGroupAll());
        TextTagSetColor(TextTagLastCreated(), c_textTagColorText, Color(0.00, 50.20, 75.29));
        TextTagSetTime(TextTagLastCreated(), c_textTagTimeDuration, 10.0);
        TextTagSetVelocity(TextTagLastCreated(), 1.0, 90.0);
        PlayerGroupLoopBegin(gv_pgEliteForces);
        while (!PlayerGroupLoopDone()) {
            PlayerModifyPropertyInt(PlayerGroupLoopCurrent(), c_playerPropMinerals, c_playerPropOperAdd, lv_intMoney);
            PlayerGroupLoopStep();
        }
        PlayerGroupLoopEnd();
    }
    else {
    }
    Wait(0.3, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_SomethingDestroyed_Init () {
    gt_SomethingDestroyed = TriggerCreate("gt_SomethingDestroyed_Func");
    TriggerAddEventUnitDied(gt_SomethingDestroyed, null);
}

