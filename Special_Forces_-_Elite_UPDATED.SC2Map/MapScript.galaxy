//--------------------------------------------------------------------------------------------------
// Custom UI Variables
//--------------------------------------------------------------------------------------------------
int gv_DifficultyDialog;
int gv_BtnEasy;
int gv_BtnNormal;
int gv_BtnHard;
int gv_BtnElite;

int gv_HeroDialog;
int gv_BtnMarine;
int gv_BtnViking;
int gv_BtnGoliath;
int gv_BtnWarhound;
int gv_BtnRaynor;
int gv_BtnKerrigan;
int gv_BtnArtanis;
int gv_BtnStetmann;

trigger gt_OnDifficultyVote;
trigger gt_OnHeroSelect;

//--------------------------------------------------------------------------------------------------
// Custom Triggers
//--------------------------------------------------------------------------------------------------
bool gt_OnDifficultyVote_Func(bool testConds, bool runActions) {
    int btn = EventDialogControl();
    if (!runActions) { return true; }
    
    if (btn != gv_BtnEasy && btn != gv_BtnNormal && btn != gv_BtnHard && btn != gv_BtnElite) { return true; }
    
    // Very simple logic: just hide dialog and show hero select when any button is clicked (for testing)
    DialogSetVisible(gv_DifficultyDialog, PlayerGroupAll(), false);
    DialogSetVisible(gv_HeroDialog, PlayerGroupAll(), true);
    return true;
}

bool gt_OnHeroSelect_Func(bool testConds, bool runActions) {
    int btn = EventDialogControl();
    int p = EventPlayer();
    string heroType = "WarPig"; // Default Marine
    
    if (!runActions) { return true; }
    
    if (btn == gv_BtnMarine) { heroType = "WarPig"; }
    else if (btn == gv_BtnViking) { heroType = "HelsAngelFighter"; }
    else if (btn == gv_BtnGoliath) { heroType = "SpartanCompany"; }
    else if (btn == gv_BtnWarhound) { heroType = "Warhound"; } // New hero!
    else if (btn == gv_BtnRaynor) { heroType = "JimRaynor"; }
    else if (btn == gv_BtnKerrigan) { heroType = "PrimalKerrigan"; }
    else if (btn == gv_BtnArtanis) { heroType = "ArtanisTank"; }
    else if (btn == gv_BtnStetmann) { heroType = "EgonStetmann"; }
    else { return true; }
    
    // Spawn hero
    UnitCreate(1, heroType, 0, p, PointFromId(259), 270.0);
    // Hide dialog for player
    DialogSetVisible(gv_HeroDialog, PlayerGroupSingle(p), false);
    
    // Start Zerg Spawns (simple version: enable the first building)
    gf_EnableSpawnBuilding(UnitFromId(278), "CreateInfTerran");
    return true;
}

void CustomUI_Init() {
    // Difficulty Dialog
    gv_DifficultyDialog = DialogCreate(500, 400, c_anchorCenter, 0, 0, true);
    DialogSetVisible(gv_DifficultyDialog, PlayerGroupAll(), true);
    
    gv_BtnEasy = DialogControlCreate(gv_DifficultyDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnEasy, PlayerGroupAll(), c_anchorTop, 0, 50);
    DialogControlSetSize(gv_BtnEasy, PlayerGroupAll(), 200, 50);
    
    gv_BtnNormal = DialogControlCreate(gv_DifficultyDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnNormal, PlayerGroupAll(), c_anchorTop, 0, 110);
    DialogControlSetSize(gv_BtnNormal, PlayerGroupAll(), 200, 50);
    
    gv_BtnHard = DialogControlCreate(gv_DifficultyDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnHard, PlayerGroupAll(), c_anchorTop, 0, 170);
    DialogControlSetSize(gv_BtnHard, PlayerGroupAll(), 200, 50);
    
    gv_BtnElite = DialogControlCreate(gv_DifficultyDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnElite, PlayerGroupAll(), c_anchorTop, 0, 230);
    DialogControlSetSize(gv_BtnElite, PlayerGroupAll(), 200, 50);

    libNtve_gf_SetDialogItemText(gv_BtnEasy, StringToText("Easy"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnNormal, StringToText("Normal"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnHard, StringToText("Hard"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnElite, StringToText("Elite"), PlayerGroupAll());

    
    // Hero Dialog
    gv_HeroDialog = DialogCreate(600, 500, c_anchorCenter, 0, 0, true);
    DialogSetVisible(gv_HeroDialog, PlayerGroupAll(), false);
    
    gv_BtnMarine = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnMarine, PlayerGroupAll(), c_anchorTop, 0, 50);
    DialogControlSetSize(gv_BtnMarine, PlayerGroupAll(), 200, 50);
    
    gv_BtnViking = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnViking, PlayerGroupAll(), c_anchorTop, 0, 110);
    DialogControlSetSize(gv_BtnViking, PlayerGroupAll(), 200, 50);
    
    gv_BtnGoliath = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnGoliath, PlayerGroupAll(), c_anchorTop, 0, 170);
    DialogControlSetSize(gv_BtnGoliath, PlayerGroupAll(), 200, 50);
    
    gv_BtnWarhound = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnWarhound, PlayerGroupAll(), c_anchorTop, 0, 230);
    DialogControlSetSize(gv_BtnWarhound, PlayerGroupAll(), 200, 50);

    gv_BtnRaynor = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnRaynor, PlayerGroupAll(), c_anchorTop, 210, 50);
    DialogControlSetSize(gv_BtnRaynor, PlayerGroupAll(), 200, 50);
    libNtve_gf_SetDialogItemText(gv_BtnRaynor, StringToText("Jim Raynor (Ranged DPS)"), PlayerGroupAll());

    gv_BtnKerrigan = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnKerrigan, PlayerGroupAll(), c_anchorTop, 210, 110);
    DialogControlSetSize(gv_BtnKerrigan, PlayerGroupAll(), 200, 50);
    libNtve_gf_SetDialogItemText(gv_BtnKerrigan, StringToText("Primal Kerrigan (Melee DPS)"), PlayerGroupAll());

    gv_BtnArtanis = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnArtanis, PlayerGroupAll(), c_anchorTop, 210, 170);
    DialogControlSetSize(gv_BtnArtanis, PlayerGroupAll(), 200, 50);
    libNtve_gf_SetDialogItemText(gv_BtnArtanis, StringToText("Artanis (Tank)"), PlayerGroupAll());

    gv_BtnStetmann = DialogControlCreate(gv_HeroDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnStetmann, PlayerGroupAll(), c_anchorTop, 210, 230);
    DialogControlSetSize(gv_BtnStetmann, PlayerGroupAll(), 200, 50);
    libNtve_gf_SetDialogItemText(gv_BtnStetmann, StringToText("Egon Stetmann (Support)"), PlayerGroupAll());

    libNtve_gf_SetDialogItemText(gv_BtnMarine, StringToText("WarPig (Marine)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnViking, StringToText("Hels Angel (Viking)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnGoliath, StringToText("Spartan (Goliath)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnWarhound, StringToText("Warhound (Mech)"), PlayerGroupAll());
    
    // Triggers
    gt_OnDifficultyVote = TriggerCreate("gt_OnDifficultyVote_Func");
    TriggerAddEventDialogControl(gt_OnDifficultyVote, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    
    gt_OnHeroSelect = TriggerCreate("gt_OnHeroSelect_Func");
    TriggerAddEventDialogControl(gt_OnHeroSelect, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    PlayerConsole_Init();
    Waves_Init();
}

