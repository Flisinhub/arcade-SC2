void gf_GiveRandomBuff (unit lp_unit) {
    int auto79405EB7_val;

    // Variable Declarations
    int lv_rand;

    // Variable Initialization
    lv_rand = 0;

    // Implementation
    lv_rand = RandomInt(0, 6);
    auto79405EB7_val = lv_rand;
    if (auto79405EB7_val == 0) {
        UnitBehaviorAddPlayer(lp_unit, "AttackBuff", 15, 1);
    }
    else if (auto79405EB7_val == 1) {
        UnitBehaviorAddPlayer(lp_unit, "HealthBuff", 15, 1);
    }
    else if (auto79405EB7_val == 2) {
        UnitBehaviorAddPlayer(lp_unit, "SpeedBuff", 15, 1);
    }
    else if (auto79405EB7_val == 3) {
        UnitBehaviorAddPlayer(lp_unit, "AttackBuff", 15, 1);
        UnitBehaviorAddPlayer(lp_unit, "HealthBuff", 15, 1);
    }
    else if (auto79405EB7_val == 4) {
        UnitBehaviorAddPlayer(lp_unit, "SpeedBuff", 15, 1);
        UnitBehaviorAddPlayer(lp_unit, "HealthBuff", 15, 1);
    }
    else if (auto79405EB7_val == 5) {
        UnitBehaviorAddPlayer(lp_unit, "AttackBuff", 15, 1);
        UnitBehaviorAddPlayer(lp_unit, "SpeedBuff", 15, 1);
    }
    else if (auto79405EB7_val == 6) {
        UnitBehaviorAddPlayer(lp_unit, "HealthBuff", 15, 1);
        UnitBehaviorAddPlayer(lp_unit, "AttackBuff", 15, 1);
        UnitBehaviorAddPlayer(lp_unit, "SpeedBuff", 15, 1);
    }
    else {
    }
}

void gf_EnableSpawnBuilding (unit lp_building, string lp_behaviour) {
    // Implementation
    UnitSetState(lp_building, c_unitStateInvulnerable, false);
    UnitBehaviorAddPlayer(lp_building, lp_behaviour, 15, 1);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Init
//--------------------------------------------------------------------------------------------------
bool gt_Init_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_PlayerSetup, true, true);
    // TriggerExecute(gt_SpawnUnits, true, false); // Disabled old spawn logic
    TriggerExecute(gt_EnemyTraits, true, false);
    // gf_EnableSpawnBuilding(UnitFromId(278), "CreateInfTerran"); // Will enable after hero selection
    CustomUI_Init(); // Initialize our new menus
    HelpPanelAddTip(PlayerGroupAll(), libNtve_gf_FormatTipTitle(StringExternal("Param/Value/20898EA6"), 0), StringExternal("Param/Value/38FE1685"), StringExternal("Param/Value/41CD7C17"), "Assets\\Textures\\ui_btn_generic_exclemation.dds");
    HelpPanelAddTip(PlayerGroupAll(), libNtve_gf_FormatTipTitle(StringExternal("Param/Value/C146C32D"), 0), StringExternal("Param/Value/05685C27"), StringExternal("Param/Value/FBA01ECF"), "Assets\\Textures\\ui_btn_generic_mousepointer.dds");
    Wait(15.0, c_timeGame);
    TipAlertPanelClear(PlayerGroupAll());
    return true;
}

