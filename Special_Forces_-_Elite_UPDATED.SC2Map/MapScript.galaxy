//--------------------------------------------------------------------------------------------------
// Trigger: Buff Spawns
//--------------------------------------------------------------------------------------------------
bool gt_BuffSpawns_Func (bool testConds, bool runActions) {
    // Conditions
    if (testConds) {
        if (!((((gv_inKerriDeaths > 5) && (UnitGetType(EventUnitCreatedUnit()) == "KerriganChar")) || ((UnitGetType(EventUnitCreatedUnit()) == "Corruptor") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(375))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "BroodLord") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(375))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "Omegalisk") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(378))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "Hydralisk") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(390))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "Roach") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(374))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "Zergling") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(373))) == true)) || ((UnitGetType(EventUnitCreatedUnit()) == "InfestedCivilian") && (libNtve_gf_UnitGroupIsDead(libNtve_gf_ConvertUnitToUnitGroup(UnitFromId(456))) == true))))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_GiveRandomBuff(EventUnitCreatedUnit());
    return true;
}

