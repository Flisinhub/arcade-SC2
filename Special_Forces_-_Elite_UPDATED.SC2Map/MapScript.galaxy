//--------------------------------------------------------------------------------------------------
// Trigger: Unit Created Select
//--------------------------------------------------------------------------------------------------
bool gt_UnitCreatedSelect_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    PlayerGroupLoopBegin(gv_pgEliteForces);
    while (!PlayerGroupLoopDone()) {
        if ((PlayerGroupHasPlayer(gv_pgAdded, PlayerGroupLoopCurrent()) == false) && (UnitGroupCount(UnitGroup(null, PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive) > 0)) {
            PlayerGroupAdd(gv_pgAdded, PlayerGroupLoopCurrent());
            UnitClearSelection(PlayerGroupLoopCurrent());
            UnitControlGroupAddUnit(PlayerGroupLoopCurrent(), 1, libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup(null, PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), 0), 0)));
            UnitSelect(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup(null, PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterStructure), 0), 0)), PlayerGroupLoopCurrent(), true);
            if ((UnitGroupCount(UnitGroup("HelsAngelFighter", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive) > 0)) {
                UnitIssueOrder(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup("HelsAngelFighter", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0)), Order(AbilityCommand("WreckingCrewAssaultMode", 0)), c_orderQueueReplace);
            }
            else {
            }
        }
        else {
            if ((PlayerGroupCount(gv_pgAdded) == PlayerGroupCount(gv_pgEliteForces))) {
                TriggerEnable(TriggerGetCurrent(), false);
            }
            else {
            }
        }
        PlayerGroupLoopStep();
    }
    PlayerGroupLoopEnd();
    return true;
}

