int gv_BtnBuffT1; // Optical Lens
int gv_BtnBuffT3; // Momentum
int gv_BtnStatStr; // Strength
int gv_BtnStatDex; // Dexterity
int gv_BtnStatInt; // Intelligence
int gv_BtnStatSta; // Stamina

trigger gt_ToggleConsole;
trigger gt_PurchaseBuff;

//--------------------------------------------------------------------------------------------------
// Player Console Triggers
//--------------------------------------------------------------------------------------------------
bool gt_ToggleConsole_Func(bool testConds, bool runActions) {
    int p = EventPlayer();
    if (!runActions) { return true; }
    
    // Toggle visibility
    if (DialogIsVisible(gv_PlayerConsoleDialog, p)) {
        DialogSetVisible(gv_PlayerConsoleDialog, PlayerGroupSingle(p), false);
    } else {
        DialogSetVisible(gv_PlayerConsoleDialog, PlayerGroupSingle(p), true);
    }
    return true;
}

bool gt_PurchaseBuff_Func(bool testConds, bool runActions) {
    int btn = EventDialogControl();
    int p = EventPlayer();
    string buffType = "";
    int cost = 0;
    unitgroup ug;
    
    if (!runActions) { return true; }
    
    // Determine what was clicked
    if (btn == gv_BtnBuffT1) { buffType = "BuffTier1_OpticalLens"; cost = 500; }
    else if (btn == gv_BtnBuffT3) { buffType = "BuffTier3_Momentum"; cost = 1000; }
    else if (btn == gv_BtnStatStr) { buffType = "Stat_Strength"; cost = 250; }
    else if (btn == gv_BtnStatDex) { buffType = "Stat_Dexterity"; cost = 250; }
    else if (btn == gv_BtnStatInt) { buffType = "Stat_Intelligence"; cost = 250; }
    else if (btn == gv_BtnStatSta) { buffType = "Stat_Stamina"; cost = 250; }
    else { return true; } // Not a purchase button
    
    // Iterate over selected units
    ug = UnitGroupSelected(p);
    UnitGroupLoopBegin(ug);
    while (!UnitGroupLoopDone()) {
        if (PlayerGetPropertyInt(p, c_playerPropMinerals) >= cost) {
            // Deduct minerals
            PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperSubtract, cost);
            // Apply buff (duration -1 means infinite/permanent)
            UnitBehaviorAddPlayer(UnitGroupLoopCurrent(), buffType, p, 1);
            // Play a sound or visual effect here optionally
        } else {
            // Not enough minerals, break or notify
            UIDisplayMessage(PlayerGroupSingle(p), c_messageAreaSubtitle, StringToText("Not enough minerals for " + buffType));
            break;
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
    
    return true;
}

void PlayerConsole_Init() {
    // 1. Gamebar
    gv_GamebarDialog = DialogCreate(150, 50, c_anchorTopRight, 20, 150, true);
    DialogSetVisible(gv_GamebarDialog, PlayerGroupAll(), true);
    
    gv_BtnOpenConsole = DialogControlCreate(gv_GamebarDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnOpenConsole, PlayerGroupAll(), c_anchorCenter, 0, 0);
    DialogControlSetSize(gv_BtnOpenConsole, PlayerGroupAll(), 150, 50);
    // Button text set later via GameStrings? For simplicity we can't easily do it without native wrapper, but SC2 native allows it:
    // We will use the text property if possible, but SC2 vanilla DialogControlCreate doesn't take text. We rely on standard tooltip/text.
    // Actually, setting text natively in Galaxy:
    // libNtve_gf_SetDialogItemText(gv_BtnOpenConsole, StringToText("Player Console (Alt+C)"), PlayerGroupAll());
    
    // 2. Console Dialog
    gv_PlayerConsoleDialog = DialogCreate(600, 400, c_anchorRight, 50, 0, true);
    DialogSetVisible(gv_PlayerConsoleDialog, PlayerGroupAll(), false);
    
    // Buffs
    gv_BtnBuffT1 = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnBuffT1, PlayerGroupAll(), c_anchorTopLeft, 50, 50);
    DialogControlSetSize(gv_BtnBuffT1, PlayerGroupAll(), 200, 50);
    
    gv_BtnBuffT3 = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnBuffT3, PlayerGroupAll(), c_anchorTopLeft, 50, 110);
    DialogControlSetSize(gv_BtnBuffT3, PlayerGroupAll(), 200, 50);
    
    // Stats
    gv_BtnStatStr = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnStatStr, PlayerGroupAll(), c_anchorTopRight, 50, 50);
    DialogControlSetSize(gv_BtnStatStr, PlayerGroupAll(), 200, 50);
    
    gv_BtnStatDex = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnStatDex, PlayerGroupAll(), c_anchorTopRight, 50, 110);
    DialogControlSetSize(gv_BtnStatDex, PlayerGroupAll(), 200, 50);
    
    gv_BtnStatInt = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnStatInt, PlayerGroupAll(), c_anchorTopRight, 50, 170);
    DialogControlSetSize(gv_BtnStatInt, PlayerGroupAll(), 200, 50);
    
    gv_BtnStatSta = DialogControlCreate(gv_PlayerConsoleDialog, c_triggerControlTypeButton);
    DialogControlSetPosition(gv_BtnStatSta, PlayerGroupAll(), c_anchorTopRight, 50, 230);
    DialogControlSetSize(gv_BtnStatSta, PlayerGroupAll(), 200, 50);
    
    // Triggers
    
    // Text bindings
    libNtve_gf_SetDialogItemText(gv_BtnOpenConsole, StringToText("Player Console (Alt+C)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnBuffT1, StringToText("Buff: Optical Lens (500)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnBuffT3, StringToText("Buff: Momentum (1000)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnStatStr, StringToText("Stat: Strength (250)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnStatDex, StringToText("Stat: Dexterity (250)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnStatInt, StringToText("Stat: Intelligence (250)"), PlayerGroupAll());
    libNtve_gf_SetDialogItemText(gv_BtnStatSta, StringToText("Stat: Stamina (250)"), PlayerGroupAll());

    gt_ToggleConsole = TriggerCreate("gt_ToggleConsole_Func");
    TriggerAddEventDialogControl(gt_ToggleConsole, c_playerAny, gv_BtnOpenConsole, c_triggerControlEventTypeClick);
    
    gt_PurchaseBuff = TriggerCreate("gt_PurchaseBuff_Func");
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnBuffT1, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnBuffT3, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnStatStr, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnStatDex, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnStatInt, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(gt_PurchaseBuff, c_playerAny, gv_BtnStatSta, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Wave System
//--------------------------------------------------------------------------------------------------
trigger gt_DropPods;
trigger gt_TimedWaves;
int gv_WaveCounter;

bool gt_DropPods_Func(bool testConds, bool runActions) {
    int p;
    unitgroup ug;
    unit targetHero = null;
    point dropPoint;
    
    if (!runActions) { return true; }
    
    // Pick a random player 1 to 14
    p = RandomInt(1, 14);
    ug = UnitGroup(null, p, RegionEntireMap(), UnitFilter((1 << c_targetFilterHeroic), 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(ug, c_unitCountAlive) > 0) {
        targetHero = UnitGroupUnit(ug, 1);
        dropPoint = UnitGetPosition(targetHero);
        
        // Ensure not inside base (Base is Point 259)
        if (DistanceBetweenPoints(dropPoint, PointFromId(259)) > 20.0) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Warning: Zerg Drop Pod incoming!"));
            
            UnitCreate(4, "Zergling", 0, 15, dropPoint, 270.0);
            UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(259)), c_orderQueueReplace);
            
            UnitCreate(1, "Roach", 0, 15, dropPoint, 270.0);
            UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(259)), c_orderQueueReplace);
        }
    }
    return true;
}

bool gt_TimedWaves_Func(bool testConds, bool runActions) {
    // Top right corner / Hive area usually has Point 1 or 2 or 3 in the map. Let's use a coordinate (150, 150) or just find the Hive.
    // I will use PointFromId(3) which is usually the far corner, or we can just spawn them near the Greater Spire.
    // For safety, I'll use a known location: PointFromId(1) is top left, 2 is top right, 3 is middle right usually in SFE.
    // Let's spawn at PointFromId(1) for now.
    point spawnPoint = UnitGetPosition(UnitFromId(278)); 
    point attackPoint = PointFromId(259);
    
    if (!runActions) { return true; }
    
    gv_WaveCounter = gv_WaveCounter + 1;
    
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("A massive Zerg wave is approaching!"));
    
    if (gv_WaveCounter % 2 == 0) {
        // Boss Wave
        if (gv_WaveCounter == 2) {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Boss: Green Viper!"));
            UnitCreate(1, "ViperGreen", 0, 15, spawnPoint, 270.0);
            UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), attackPoint), c_orderQueueReplace);
        } else {
            UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringToText("Boss: Gastly Overseer!"));
            UnitCreate(1, "GastlyOverseer", 0, 15, spawnPoint, 270.0);
            UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), attackPoint), c_orderQueueReplace);
        }
        
        UnitCreate(10, "Hydralisk", 0, 15, spawnPoint, 270.0);
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), attackPoint), c_orderQueueReplace);
    } else {
        // Normal Wave
        UnitCreate(15, "Zergling", 0, 15, spawnPoint, 270.0);
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), attackPoint), c_orderQueueReplace);
        
        UnitCreate(5, "Roach", 0, 15, spawnPoint, 270.0);
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), attackPoint), c_orderQueueReplace);
    }
    
    return true;
}

void Waves_Init() {
    gv_WaveCounter = 0;
    
    gt_DropPods = TriggerCreate("gt_DropPods_Func");
    TriggerAddEventTimePeriodic(gt_DropPods, 45.0, c_timeGame);
    
    gt_TimedWaves = TriggerCreate("gt_TimedWaves_Func");
    TriggerAddEventTimePeriodic(gt_TimedWaves, 180.0, c_timeGame);
}
