//--------------------------------------------------------------------------------------------------
// Trigger: Player Setup
//--------------------------------------------------------------------------------------------------
bool gt_PlayerSetup_Func (bool testConds, bool runActions) {
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_DisplayBossBar(1, "Assets\\Textures\\btn-building-terran-planetaryfortress.dds", StringExternal("Param/Value/08C28801"), 20000, PlayerGroupAll());
    libNtve_gf_MoveBossBar(1, c_anchorTopLeft, 0, 50);
    libNtve_gf_SetBossBarBoss(1, UnitFromId(3), true);
    TriggerExecute(gt_ReCalculatePlayers, true, true);
    libNtve_gf_SetPlayerGroupAlliance(gv_pgEliteForces, 2);
    libNtve_gf_SetAlliance(15, 14, 5);
    
    PlayerGroupLoopBegin(PlayerGroupAll());
    while (!PlayerGroupLoopDone()) {
        PlayerModifyPropertyInt(PlayerGroupLoopCurrent(), c_playerPropMinerals, c_playerPropOperSetTo, 1000);
        PlayerGroupLoopStep();
    }
    PlayerGroupLoopEnd();

    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeSupply, false);
    PlayerGroupLoopBegin(PlayerGroupAll());
    while (!PlayerGroupLoopDone()) {
        CameraPan(PlayerGroupLoopCurrent(), PointFromId(259), 0.0, -1, 10, false);
        PlayerGroupLoopStep();
    }
    PlayerGroupLoopEnd();
    return true;
}

