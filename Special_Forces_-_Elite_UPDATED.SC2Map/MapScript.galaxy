bool gt_SpawnUnits_Func (bool testConds, bool runActions) {
    string auto3B4AD34D_val;
    int autoBFF40A57_val;

    // Variable Declarations
    int lv_intRand;

    // Variable Initialization
    lv_intRand = 0;

    // Actions
    if (!runActions) {
        return true;
    }

    PlayerGroupLoopBegin(gv_pgEliteForces);
    while (!PlayerGroupLoopDone()) {
        PlayerModifyPropertyInt(PlayerGroupLoopCurrent(), c_playerPropMinerals, c_playerPropOperSetTo, 1000);
        auto3B4AD34D_val = GameAttributePlayerValue("1", PlayerGroupLoopCurrent());
        if (auto3B4AD34D_val == "0004") {
            lv_intRand = RandomInt(0, 2);
        }
        else if (auto3B4AD34D_val == "0001") {
            lv_intRand = 0;
        }
        else if (auto3B4AD34D_val == "0007") {
            lv_intRand = 1;
        }
        else if (auto3B4AD34D_val == "0003") {
            lv_intRand = 2;
        }
        else {
        }
        autoBFF40A57_val = lv_intRand;
        if (autoBFF40A57_val == 0) {
            UnitIssueOrder(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup("EliteRD", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, (1 << (c_targetFilterHidden - 32)), 0, 0), 0)), Order(AbilityCommand("EliteForcesSummon", 0)), c_orderQueueReplace);
        }
        else if (autoBFF40A57_val == 1) {
            UnitIssueOrder(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup("EliteRD", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, (1 << (c_targetFilterHidden - 32)), 0, 0), 0)), Order(AbilityCommand("EliteForcesSummon", 2)), c_orderQueueReplace);
        }
        else if (autoBFF40A57_val == 2) {
            UnitIssueOrder(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup("EliteRD", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, (1 << (c_targetFilterHidden - 32)), 0, 0), 0)), Order(AbilityCommand("EliteForcesSummon", 5)), c_orderQueueReplace);
        }
        else {
        }
        UnitRemove(libNtve_gf_ClosestUnitToPoint(PointFromId(259), UnitGroup("EliteRD", PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter(0, (1 << (c_targetFilterHidden - 32)), 0, 0), 0)));
        UnitGroupLoopBegin(UnitGroup(null, PlayerGroupLoopCurrent(), RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        while (!UnitGroupLoopDone()) {
            UnitSetPosition(UnitGroupLoopCurrent(), PointFromId(259), false);
            UnitGroupLoopStep();
        }
        UnitGroupLoopEnd();
        PlayerGroupLoopStep();
    }
    PlayerGroupLoopEnd();
    Wait(2.0, c_timeGame);
    return true;
}

