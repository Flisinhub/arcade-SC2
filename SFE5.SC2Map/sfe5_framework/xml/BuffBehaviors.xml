<?xml version="1.0" encoding="utf-8"?>
<Catalog>
    <!-- ========================================== -->
    <!-- Conditional Buffs: Momentum (Tier 3)       -->
    <!-- ========================================== -->
    <CValidatorUnitMoving id="IsMoving">
        <WhichUnit Value="Source"/>
    </CValidatorUnitMoving>
    
    <CBehaviorBuff id="MomentumBase">
        <InfoFlags index="Hidden" value="1"/>
        <Period value="0.5"/>
        <PeriodicEffect value="MomentumApplyStack"/>
    </CBehaviorBuff>
    
    <CEffectApplyBehavior id="MomentumApplyStack">
        <ValidatorArray value="IsMoving"/>
        <Behavior value="MomentumStack"/>
    </CEffectApplyBehavior>
    
    <CBehaviorBuff id="MomentumStack">
        <Alignment value="Positive"/>
        <MaxStackCount value="5"/>
        <Duration value="3"/>
        <Modification>
            <DamageDealtFractionMultiplier value="0.05"/>
        </Modification>
    </CBehaviorBuff>

    <!-- ========================================== -->
    <!-- Conditional Buffs: Bulwark / Braced (Tier 6) -->
    <!-- ========================================== -->
    <CValidatorUnitCompareSpeed id="IsStationary">
        <WhichUnit Value="Source"/>
        <Compare value="Eq"/>
        <Value value="0"/>
    </CValidatorUnitCompareSpeed>
    
    <CBehaviorBuff id="BulwarkBase">
        <InfoFlags index="Hidden" value="1"/>
        <Period value="0.5"/>
        <PeriodicEffect value="BulwarkApplyStack"/>
    </CBehaviorBuff>
    
    <CEffectApplyBehavior id="BulwarkApplyStack">
        <ValidatorArray value="IsStationary"/>
        <Behavior value="BulwarkStack"/>
    </CEffectApplyBehavior>
    
    <CBehaviorBuff id="BulwarkStack">
        <Alignment value="Positive"/>
        <MaxStackCount value="5"/>
        <Duration value="1.5"/> <!-- Drops 1s after moving (0.5s period + 1s = 1.5s) -->
        <Modification>
            <DamageDealtFractionMultiplier value="0.01"/>
        </Modification>
    </CBehaviorBuff>

    <!-- ========================================== -->
    <!-- Attributes System (STR, DEX, INT, STA)     -->
    <!-- ========================================== -->
    <CBehaviorAttribute id="AttrStrength">
        <Modification>
            <!-- Scaling values are placeholders based on SFE5 balance -->
            <LifeAdd value="10"/> 
            <LifeRegenAdd value="0.1"/>
        </Modification>
    </CBehaviorAttribute>

    <CBehaviorAttribute id="AttrDexterity">
        <Modification>
            <AttackSpeedMultiplier value="0.01"/>
            <MovementSpeedMultiplier value="0.01"/>
        </Modification>
    </CBehaviorAttribute>

    <CBehaviorAttribute id="AttrIntelligence">
        <Modification>
            <EnergyAdd value="10"/>
            <EnergyRegenAdd value="0.1"/>
        </Modification>
    </CBehaviorAttribute>

    <CBehaviorAttribute id="AttrStamina">
        <Modification>
            <DamageDealtFractionMultiplier value="0.01"/>
            <ArmorAdd value="0.5"/>
        </Modification>
    </CBehaviorAttribute>
</Catalog>
