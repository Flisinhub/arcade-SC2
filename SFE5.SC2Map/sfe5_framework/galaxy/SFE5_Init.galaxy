// ============================================================================
// SFE5_Init.galaxy
// Master Entry Point for the SFE5 Framework
// ============================================================================

include "sfe5_framework/galaxy/CoreFramework.galaxy"
include "sfe5_framework/galaxy/BankManager.galaxy"
include "sfe5_framework/galaxy/DifficultyManager.galaxy"
include "sfe5_framework/galaxy/EconomyEngine.galaxy"
include "sfe5_framework/galaxy/BuffEngine.galaxy"
include "sfe5_framework/galaxy/ObjectiveDirector.galaxy"
include "sfe5_framework/galaxy/BossMechanics.galaxy"
include "sfe5_framework/galaxy/MapGenerator.galaxy"
include "sfe5_framework/galaxy/ShopUI.galaxy"
include "sfe5_framework/galaxy/GameFlow.galaxy"

// This function should be called from the SC2 Editor GUI Trigger "Map Initialization"
void SFE5_MasterInitialization() {
    int i;
    
    // 1. Initialize Core Player State
    SFE5_InitCoreFramework();
    
    // 2. Set Difficulty Data Defaults
    SFE5_InitDifficultyData();
    
    // 3. Load Banks for all active players
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (g_PlayerIsActive[i]) {
            SFE5_LoadBanks(i);
        }
    }
    
    // 4. Procedural Map Generation (100% Code-Driven)
    SFE5_ConstructBaseTopology();
    SFE5_GenerateMap();
    
    // 5. Build Lobby & Start Flow
    SFE5_BuildLobby();
    SFE5_InitGameFlow();
    
    // 6. Build Shop & Economy & Buffs
    SFE5_BuildShopUI();
    SFE5_InitShopUI();
    SFE5_InitEconomyTriggers();
    SFE5_InitBuffEngine();
}
