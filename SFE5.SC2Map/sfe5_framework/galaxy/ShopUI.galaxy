// ============================================================================
// ShopUI.galaxy
// Provides the basic Upgrade Shop
// ============================================================================

int g_ShopDialog;
int g_BtnDmg;
int g_BtnArmor;
int g_BtnHeal;

void SFE5_BuildShopUI() {
    int dialog;
    
    // Anchor 0 = TopLeft
    // Increased size to 350x320 for accessibility
    dialog = DialogCreate(350, 320, 0, 50, 200, false);
    g_ShopDialog = dialog;
    
    DialogSetTitle(dialog, StringToText("TIENDA DE MEJORAS"));
    
    // Y-offsets increased to avoid title bar overlap, size increased to 300x60
    g_BtnDmg = DialogControlCreate(dialog, c_triggerControlTypeButton);
    DialogControlSetPosition(g_BtnDmg, PlayerGroupAll(), 1, 0, 70);
    DialogControlSetSize(g_BtnDmg, PlayerGroupAll(), 300, 60);
    DialogControlSetPropertyAsText(g_BtnDmg, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("+1 DAÑO (1000 Min)"));
    
    g_BtnArmor = DialogControlCreate(dialog, c_triggerControlTypeButton);
    DialogControlSetPosition(g_BtnArmor, PlayerGroupAll(), 1, 0, 140);
    DialogControlSetSize(g_BtnArmor, PlayerGroupAll(), 300, 60);
    DialogControlSetPropertyAsText(g_BtnArmor, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("+1 ARMADURA (1000 Min)"));
    
    g_BtnHeal = DialogControlCreate(dialog, c_triggerControlTypeButton);
    DialogControlSetPosition(g_BtnHeal, PlayerGroupAll(), 1, 0, 210);
    DialogControlSetSize(g_BtnHeal, PlayerGroupAll(), 300, 60);
    DialogControlSetPropertyAsText(g_BtnHeal, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("CURAR AL 100% (500 Min)"));
    
    // Dialog is initially invisible
    DialogSetVisible(dialog, PlayerGroupAll(), false);
}

void SFE5_ShowShopUI() {
    // Obsolete: The shop is now shown dynamically when selecting the Planetary Fortress.
}

bool SFE5_OnShopClicked(bool testConds, bool runActions) {
    int control;
    int player;
    int minerals;
    unitgroup heroes;
    unit hero;
    string heroType;
    string weaponID;
    string effectID;
    string dmgStr;
    int newDmg;
    string armorStr;
    int newArmor;
    
    control = EventDialogControl();
    player = EventPlayer();
    minerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
    
    // Assume the player's hero is the only unit they own alive right now
    heroes = UnitGroup(null, player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 1);
    hero = null;
    if (UnitGroupCount(heroes, c_unitCountAlive) > 0) {
        hero = UnitGroupUnit(heroes, 1);
        heroType = UnitGetType(hero);
    }
    
    if (control == g_BtnDmg) {
        if (minerals >= 1000 && hero != null) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, 1000);
            
            // Incrementar nuestro motor matemático infinito
            g_PlayerBonusDamage[player] += 1;
            
            // Actualizar la interfaz del botón para reflejar el daño real
            DialogControlSetPropertyAsText(g_BtnDmg, c_triggerControlPropertyText, PlayerGroupSingle(player), 
                StringToText("+1 DAÑO (Daño Extra Total: +" + IntToString(g_PlayerBonusDamage[player]) + ")"));
            
            // Mejoras estándar para el icono visual (se estanca en +3)
            TechTreeUpgradeAddLevel(player, "TerranInfantryWeaponsLevel1", 1);
            TechTreeUpgradeAddLevel(player, "TerranInfantryWeaponsLevel2", 1);
            TechTreeUpgradeAddLevel(player, "TerranInfantryWeaponsLevel3", 1);
        }
    } else if (control == g_BtnArmor) {
        if (minerals >= 1000 && hero != null) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, 1000);
            
            // Incrementar armadura infinita
            g_PlayerBonusArmor[player] += 1;
            
            // Actualizar la interfaz del botón
            DialogControlSetPropertyAsText(g_BtnArmor, c_triggerControlPropertyText, PlayerGroupSingle(player), 
                StringToText("+1 ARMADURA (Armadura Extra Total: +" + IntToString(g_PlayerBonusArmor[player]) + ")"));
                
            // Mejoras estándar para el icono
            TechTreeUpgradeAddLevel(player, "TerranInfantryArmorsLevel1", 1);
            TechTreeUpgradeAddLevel(player, "TerranInfantryArmorsLevel2", 1);
            TechTreeUpgradeAddLevel(player, "TerranInfantryArmorsLevel3", 1);
        }
    } else if (control == g_BtnHeal) {
        if (minerals >= 500 && hero != null) {
            PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, 500);
            UnitSetPropertyFixed(hero, c_unitPropLifePercent, 100.0);
        }
    }
    
    return true;
}

bool SFE5_ShopSelectionLoop(bool testConds, bool runActions) {
    int p;
    unitgroup selected;
    int count;
    int i;
    unit u;
    bool hasPF;
    
    for (p = 1; p <= MAX_PLAYERS; p += 1) {
        if (!g_PlayerIsActive[p]) { continue; }
        
        selected = UnitGroupSelected(p);
        count = UnitGroupCount(selected, c_unitCountAlive);
        hasPF = false;
        
        for (i = 1; i <= count; i += 1) {
            u = UnitGroupUnit(selected, i);
            if (UnitGetType(u) == "PlanetaryFortress") {
                hasPF = true;
                break;
            }
        }
        
        if (hasPF) {
            DialogSetVisible(g_ShopDialog, PlayerGroupSingle(p), true);
        } else {
            DialogSetVisible(g_ShopDialog, PlayerGroupSingle(p), false);
        }
    }
    return true;
}

void SFE5_InitShopUI() {
    trigger t;
    trigger tLoop;
    
    t = TriggerCreate("SFE5_OnShopClicked");
    TriggerAddEventDialogControl(t, c_playerAny, g_BtnDmg, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(t, c_playerAny, g_BtnArmor, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(t, c_playerAny, g_BtnHeal, c_triggerControlEventTypeClick);
    
    tLoop = TriggerCreate("SFE5_ShopSelectionLoop");
    TriggerAddEventTimePeriodic(tLoop, 0.2, c_timeGame);
}
