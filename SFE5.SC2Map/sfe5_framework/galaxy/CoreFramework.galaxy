// ============================================================================
// CoreFramework.galaxy
// Central constants, math helpers, and global state for SFE5
// ============================================================================

const int MAX_PLAYERS = 6;
const int MIN_SUPPLY_CAP = 30;
const int MAX_SUPPLY_SOLO = 80;

// Player state arrays (Modularized)
bool[MAX_PLAYERS + 1] g_PlayerIsActive;
int g_ActivePlayerCount;

// Initialization
void SFE5_InitCoreFramework() {
    int i;
    g_ActivePlayerCount = 0;
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (PlayerStatus(i) == c_playerStatusActive) {
            g_PlayerIsActive[i] = true;
            g_ActivePlayerCount += 1;
        } else {
            g_PlayerIsActive[i] = false;
        }
    }
    // Safeguard for debug
    if (g_ActivePlayerCount < 1) { g_ActivePlayerCount = 1; }
}

// Core math helper: recalculates dynamic supply based on active players
int SFE5_CalculateSupplyCap() {
    int supplyCap;
    if (g_ActivePlayerCount <= 1) {
        supplyCap = MAX_SUPPLY_SOLO;
    } else {
        supplyCap = MAX_SUPPLY_SOLO - (10 * (g_ActivePlayerCount - 1));
    }
    
    if (supplyCap < MIN_SUPPLY_CAP) {
        supplyCap = MIN_SUPPLY_CAP;
    }
    return supplyCap;
}

// Recalculates all player-dependent global variables when a player leaves
void SFE5_OnPlayerLeave(int player) {
    if (g_PlayerIsActive[player]) {
        g_PlayerIsActive[player] = false;
        g_ActivePlayerCount -= 1;
        if (g_ActivePlayerCount < 1) { g_ActivePlayerCount = 1; } // Prevent div by zero
        
        // Trigger recalculations (supply, income distributions)
        // int newSupply = SFE5_CalculateSupplyCap();
        // Update player supply catalogs here
    }
}

// Basic rounding helper since Galaxy lacks robust math libraries
fixed SFE5_Round(fixed val) {
    int intVal = FixedToInt(val);
    if (val - IntToFixed(intVal) >= 0.5) {
        return IntToFixed(intVal + 1);
    }
    return IntToFixed(intVal);
}

// Custom infinite upgrades
int[MAX_PLAYERS + 1] g_PlayerBonusDamage;
int[MAX_PLAYERS + 1] g_PlayerBonusArmor;
