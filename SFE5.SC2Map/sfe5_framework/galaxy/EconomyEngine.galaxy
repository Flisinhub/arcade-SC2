// ============================================================================
// EconomyEngine.galaxy
// Handles Kill Payouts, Shared/Split Income, Trading, and Starting Minerals
// ============================================================================

const int INCOME_MODE_SHARED = 0;
const int INCOME_MODE_SPLIT = 1;

int g_CurrentIncomeMode = INCOME_MODE_SHARED;

// Player minerals array
int[MAX_PLAYERS + 1] g_PlayerMinerals;
bool[MAX_PLAYERS + 1] g_PlayerPickedRandomHero;

// Initializes starting minerals for all active players
void SFE5_DistributeStartingMinerals() {
    int i;
    int baseAmount;
    int randomBonus;
    
    baseAmount = 12000 / g_ActivePlayerCount;
    randomBonus = 15000 / g_ActivePlayerCount;
    
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (g_PlayerIsActive[i]) {
            g_PlayerMinerals[i] = baseAmount;
            if (g_PlayerPickedRandomHero[i]) {
                g_PlayerMinerals[i] += randomBonus;
            }
            // Update actual SC2 player property
            PlayerModifyPropertyInt(i, c_playerPropMinerals, c_playerPropOperSetTo, g_PlayerMinerals[i]);
        }
    }
}

// Calculate the dynamic bounty for a kill
int SFE5_CalculateKillPayout(int baseBounty, fixed rate, int flatEventBonus) {
    fixed diffMult;
    fixed dynamicFactor;
    fixed rawPayout;
    
    diffMult = SFE5_GetIncomeMultiplier();
    // Formula: Base * DifficultyMultiplier * (rate * (12 - players))
    dynamicFactor = rate * IntToFixed(12 - g_ActivePlayerCount);
    rawPayout = IntToFixed(baseBounty) * diffMult * dynamicFactor;
    
    return FixedToInt(rawPayout) + flatEventBonus;
}

// Distributes income from a killed enemy
void SFE5_AwardKillIncome(int killerPlayer, int baseBounty, fixed rate, int flatEventBonus) {
    int finalPayout;
    int i;
    
    finalPayout = SFE5_CalculateKillPayout(baseBounty, rate, flatEventBonus);
    
    if (g_CurrentIncomeMode == INCOME_MODE_SHARED) {
        // Shared: Each active player receives the FULL calculated payout
        for (i = 1; i <= MAX_PLAYERS; i += 1) {
            if (g_PlayerIsActive[i]) {
                PlayerModifyPropertyInt(i, c_playerPropMinerals, c_playerPropOperAdd, finalPayout);
                g_PlayerMinerals[i] += finalPayout;
            }
        }
    } else if (g_CurrentIncomeMode == INCOME_MODE_SPLIT) {
        // Split: Only the killer receives the standard payout
        if (killerPlayer >= 1 && killerPlayer <= MAX_PLAYERS && g_PlayerIsActive[killerPlayer]) {
            PlayerModifyPropertyInt(killerPlayer, c_playerPropMinerals, c_playerPropOperAdd, finalPayout);
            g_PlayerMinerals[killerPlayer] += finalPayout;
        }
    }
}

// Trade command handling (-m <amount>)
void SFE5_ProcessTrade(int fromPlayer, int toPlayer, int amount) {
    int currentMinerals;
    
    if (!g_PlayerIsActive[fromPlayer] || !g_PlayerIsActive[toPlayer] || fromPlayer == toPlayer) {
        return;
    }
    
    currentMinerals = PlayerGetPropertyInt(fromPlayer, c_playerPropMinerals);
    if (amount > 0 && currentMinerals >= amount) {
        PlayerModifyPropertyInt(fromPlayer, c_playerPropMinerals, c_playerPropOperSubtract, amount);
        PlayerModifyPropertyInt(toPlayer, c_playerPropMinerals, c_playerPropOperAdd, amount);
        g_PlayerMinerals[fromPlayer] -= amount;
        g_PlayerMinerals[toPlayer] += amount;
    }
}

// Revive Penalty
void SFE5_ApplyDeathPenalty(int player) {
    fixed penaltyFraction;
    int currentMinerals;
    int lostMinerals;
    
    if (g_PlayerIsActive[player]) {
        penaltyFraction = SFE5_GetDeathPenaltyFraction();
        currentMinerals = PlayerGetPropertyInt(player, c_playerPropMinerals);
        lostMinerals = FixedToInt(IntToFixed(currentMinerals) * penaltyFraction);
        
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSubtract, lostMinerals);
        g_PlayerMinerals[player] -= lostMinerals;
    }
}


// ==========================================
// Kill Bounties
// ==========================================
bool SFE5_OnEnemyKilled(bool testConds, bool runActions) {
    int killer;
    int victim;
    string unitType;
    int bounty;
    int points;
    unit sourceUnit;
    
    sourceUnit = EventUnitDamageSourceUnit();
    if (sourceUnit == null) { return true; }
    
    killer = UnitGetOwner(sourceUnit);
    victim = UnitGetOwner(EventUnit());
    unitType = UnitGetType(EventUnit());
    
    // Player 15 is the enemy swarm
    if (victim == 15 && killer >= 1 && killer <= MAX_PLAYERS) {
        bounty = 10;
        points = 0;
        if (unitType == "Zergling") { bounty = 5; points = 1; }
        else if (unitType == "Roach") { bounty = 15; points = 2; }
        else if (unitType == "Hydralisk") { bounty = 20; points = 3; }
        else if (unitType == "Mutalisk") { bounty = 30; points = 4; }
        else if (unitType == "Bunker" || unitType == "RoachWarren" || unitType == "HydraliskDen" || unitType == "Spire") { bounty = 500; points = 50; }
        
        SFE5_AwardKillIncome(killer, bounty, 1.0, 0);
        g_PlayerClassicPoints[killer] += points;
    }
    return true;
}

void SFE5_InitEconomyTriggers() {
    trigger t;
    t = TriggerCreate("SFE5_OnEnemyKilled");
    TriggerAddEventUnitDied(t, null);
}
