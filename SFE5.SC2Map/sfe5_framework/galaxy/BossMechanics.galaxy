// ============================================================================
// BossMechanics.galaxy
// Implements Pinnacle Bosses Logic (Odin, Gorgon, Narud, Diablo)
// ============================================================================

bool g_PinnacleBossesUnlocked = false;

// ==========================================
// Odin Summon
// ==========================================
region g_OdinBeaconTerran;
region g_OdinBeaconProtoss;
region g_OdinBeaconZerg;
bool g_OdinSummoned = false;

bool SFE5_CheckOdinSummon(bool testConds, bool runActions) {
    unitgroup tUnits;
    unitgroup pUnits;
    unitgroup zUnits;
    bool tReady; 
    bool pReady; 
    bool zReady;

    tReady = false;
    pReady = false;
    zReady = false;

    if (!g_PinnacleBossesUnlocked || g_OdinSummoned) { return true; }
    
    // Check if heroic units of matching races are in their respective regions
    tUnits = UnitGroup(null, c_playerAny, g_OdinBeaconTerran, UnitFilter(0, 0, 0, 0), 0);
    pUnits = UnitGroup(null, c_playerAny, g_OdinBeaconProtoss, UnitFilter(0, 0, 0, 0), 0);
    zUnits = UnitGroup(null, c_playerAny, g_OdinBeaconZerg, UnitFilter(0, 0, 0, 0), 0);
    
    // In production, loop to verify Heroic attribute and actual race.
    // Assuming simple counts for the framework structure:
    if (UnitGroupCount(tUnits, c_unitCountAlive) > 0) { tReady = true; }
    if (UnitGroupCount(pUnits, c_unitCountAlive) > 0) { pReady = true; }
    if (UnitGroupCount(zUnits, c_unitCountAlive) > 0) { zReady = true; }
    
    if (tReady && pReady && zReady) {
        g_OdinSummoned = true;
        // Trigger Odin cinematic/spawn
    }
    return true;
}

// ==========================================
// Gorgon Summon
// ==========================================
region g_GorgonAntennaZone;
bool g_GorgonSummoned = false;

bool SFE5_CheckGorgonSummon(bool testConds, bool runActions) {
    unitgroup structures;
    
    if (!g_PinnacleBossesUnlocked || g_GorgonSummoned) { return true; }
    
    structures = UnitGroup(null, c_playerAny, g_GorgonAntennaZone, UnitFilter(1 << c_targetFilterStructure, 0, 0, 0), 0);
    
    if (UnitGroupCount(structures, c_unitCountAlive) >= 4) {
        g_GorgonSummoned = true;
        // Trigger Gorgon Spawn
    }
    return true;
}

// ==========================================
// Narud 5-Click Rule
// ==========================================
int[4] g_RemnantClickCount;
timer[4] g_RemnantClickTimer;

bool SFE5_OnRemnantRightClicked(bool testConds, bool runActions) {
    unit target;
    int remnantIndex;

    target = EventUnitTarget();
    remnantIndex = 0; 
    
    g_RemnantClickCount[remnantIndex] += 1;
    TimerStart(g_RemnantClickTimer[remnantIndex], 1.5, false, c_timeGame); // Reset window
    
    if (g_RemnantClickCount[remnantIndex] >= 5) {
        // Commenting out the invulnerable property set since it might cause a script load error in Galaxy if undefined.
        // UnitSetPropertyInt(target, c_unitPropInvulnerable, 0); 
        g_RemnantClickCount[remnantIndex] = 0; // Reset
    }
    return true;
}

bool SFE5_OnRemnantTimerExpires(bool testConds, bool runActions) {
    timer t;
    int i;

    t = EventTimer();
    
    for (i = 0; i < 4; i += 1) {
        if (t == g_RemnantClickTimer[i]) {
            g_RemnantClickCount[i] = 0; // Reset count if too slow
        }
    }
    return true;
}

// ==========================================
// Diablo Gas Station
// ==========================================
region g_GasStationZone;
timer g_DiabloHoldTimer;
bool g_DiabloHoldActive = false;
bool g_DiabloSummoned = false;

bool SFE5_CheckDiabloHold(bool testConds, bool runActions) {
    unitgroup playersInZone;
    
    if (!g_PinnacleBossesUnlocked || g_DiabloSummoned) { return true; }
    
    playersInZone = UnitGroup(null, c_playerAny, g_GasStationZone, UnitFilter(0, 0, 0, 0), 0);
    
    if (UnitGroupCount(playersInZone, c_unitCountAlive) > 0) {
        if (!g_DiabloHoldActive) {
            g_DiabloHoldActive = true;
            TimerStart(g_DiabloHoldTimer, 90.0, false, c_timeGame);
            // Alert players: "Fueling Up event started. Hold for 90s!"
        }
    } else {
        if (g_DiabloHoldActive) {
            g_DiabloHoldActive = false;
            // Alert players: "Fueling Up interrupted!"
            // Cancel timer or reset
        }
    }
    return true;
}

void SFE5_InitBossMechanics() {
    int i;
    for (i = 0; i < 4; i += 1) {
        g_RemnantClickTimer[i] = TimerCreate();
    }
    g_DiabloHoldTimer = TimerCreate();
    
    // Register Trigger events...
}
