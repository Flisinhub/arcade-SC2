// ============================================================================
// BuffEngine.galaxy
// Manages Custom Infinite Upgrades via Code (Damage & Armor)
// ============================================================================

bool SFE5_OnUnitDamaged(bool testConds, bool runActions) {
    unit victim;
    unit attacker;
    int victimPlayer;
    int attackerPlayer;
    fixed damageAmt;
    fixed armorBonus;
    fixed damageBonus;
    fixed currentLife;
    
    victim = EventUnit();
    attacker = EventUnitDamageSourceUnit();
    
    if (attacker == null) { return true; }
    
    victimPlayer = UnitGetOwner(victim);
    attackerPlayer = UnitGetOwner(attacker);
    damageAmt = EventUnitDamageAmount();
    
    // 1. Bonus Damage (Player -> Enemy)
    if (attackerPlayer >= 1 && attackerPlayer <= MAX_PLAYERS && victimPlayer == 15) {
        damageBonus = IntToFixed(g_PlayerBonusDamage[attackerPlayer]);
        if (damageBonus > 0.0) {
            currentLife = UnitGetPropertyFixed(victim, c_unitPropLife, c_unitPropCurrent);
            UnitSetPropertyFixed(victim, c_unitPropLife, currentLife - damageBonus);
        }
    }
    
    // 2. Bonus Armor (Enemy -> Player)
    if (victimPlayer >= 1 && victimPlayer <= MAX_PLAYERS && attackerPlayer == 15) {
        armorBonus = IntToFixed(g_PlayerBonusArmor[victimPlayer]);
        if (armorBonus > 0.0) {
            if (armorBonus > damageAmt) { armorBonus = damageAmt; }
            currentLife = UnitGetPropertyFixed(victim, c_unitPropLife, c_unitPropCurrent);
            UnitSetPropertyFixed(victim, c_unitPropLife, currentLife + armorBonus);
        }
    }
    
    return true;
}

void SFE5_InitBuffEngine() {
    trigger t = TriggerCreate("SFE5_OnUnitDamaged");
    // c_unitDamageTypeAny = 0, c_unitDamageEither = 0
    TriggerAddEventUnitDamaged(t, null, 0, 0, null);
}
