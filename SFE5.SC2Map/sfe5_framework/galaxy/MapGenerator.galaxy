// ============================================================================
// MapGenerator.galaxy
// Procedural Generation of the Base, Grid, Paths, and Enemy Structures
// ============================================================================

const int GRID_SIZE = 14;
const fixed MAP_MIN_X = 0.0;
const fixed MAP_MAX_X = 256.0;
const fixed MAP_MIN_Y = 0.0;
const fixed MAP_MAX_Y = 256.0;

// Base topology
void SFE5_ConstructBaseTopology() {
    point basePoint;
    int i;
    point startPoint;
    
    basePoint = Point(30.0, 30.0);
    
    // Create Planetary Fortress for Player 1
    // Native UnitCreate: count, type, flags, player, pos, angle
    UnitCreate(1, "PlanetaryFortress", 0, 1, basePoint, 270.0);
    
    // Define the Base Region (radius 30.0 around basePoint)
    g_BaseRegion = RegionCircle(basePoint, 30.0);
}

void SFE5_GenerateMap() {
    int x; 
    int y;
    fixed stepX;
    fixed stepY;
    int nydusCount;
    
    // Variables for loop
    fixed cellCenterX;
    fixed cellCenterY;
    point cellPoint;
    int familyRoll;
    string structureToSpawn;
    int t1Roll;
    int t2Roll;
    point spawnPoint;
    point rockPoint;

    stepX = (MAP_MAX_X - MAP_MIN_X) / IntToFixed(GRID_SIZE);
    stepY = (MAP_MAX_Y - MAP_MIN_Y) / IntToFixed(GRID_SIZE);
    nydusCount = 0;

    for (x = 0; x < GRID_SIZE; x += 1) {
        for (y = 0; y < GRID_SIZE; y += 1) {
            // Skip the bottom-left area where the base is (x < 3, y < 3)
            if (x < 3 && y < 3) { continue; }

            cellCenterX = MAP_MIN_X + (IntToFixed(x) * stepX) + (stepX / 2.0);
            cellCenterY = MAP_MIN_Y + (IntToFixed(y) * stepY) + (stepY / 2.0);
            cellPoint = Point(cellCenterX, cellCenterY);

            // 1. Assign Nydus Craters
            if (nydusCount < 12 && RandomInt(1, 100) <= 15) {
                g_NydusCraters[nydusCount] = RegionCircle(cellPoint, 5.0);
                UnitCreate(1, "NydusCanal", 0, 15, cellPoint, 270.0);
                nydusCount += 1;
                continue; // Skip spawning other structures here
            }

            // 2. Procedural Enemy Structures
            familyRoll = RandomInt(1, 100);
            structureToSpawn = "";
            
            if (familyRoll <= 20) {
                // Empty cell / Pathing area
                continue;
            } else if (familyRoll <= 50) {
                // 30% Infested
                if (RandomInt(1, 2) == 1) { structureToSpawn = "Bunker"; }
                else { structureToSpawn = "MissileTurret"; }
            } else if (familyRoll <= 80) {
                // 30% Tier 1 Zerg Defenses
                t1Roll = RandomInt(1, 3);
                if (t1Roll == 1) { structureToSpawn = "SpineCrawler"; }
                else if (t1Roll == 2) { structureToSpawn = "SporeCrawler"; }
                else { structureToSpawn = "CreepTumor"; }
            } else {
                // 20% Tier 2 Zerg Defenses (Using standard valid IDs instead of missiles/campaign IDs)
                t2Roll = RandomInt(1, 3);
                if (t2Roll == 1) { structureToSpawn = "RoachWarren"; } 
                else if (t2Roll == 2) { structureToSpawn = "HydraliskDen"; } 
                else { structureToSpawn = "Spire"; }
            }
            
            // Spawn the selected structure slightly offset to look natural
            if (structureToSpawn != "") {
                spawnPoint = Point(cellCenterX + IntToFixed(RandomInt(-3, 3)), cellCenterY + IntToFixed(RandomInt(-3, 3)));
                UnitCreate(1, structureToSpawn, 0, 15, spawnPoint, IntToFixed(RandomInt(0, 360)));
            }
            
            // 3. Create Pathing Blockers (Rocks) randomly to form mazes
            if (RandomInt(1, 100) <= 10) {
                rockPoint = Point(cellCenterX + 8.0, cellCenterY + 8.0);
                UnitCreate(1, "DestructibleRock2x4Vertical", 0, 0, rockPoint, 270.0);
            }
        }
    }
}
