// ============================================================================
// SFE5_Init.galaxy
// Master Entry Point for the SFE5 Framework
// ============================================================================

include "CoreFramework.galaxy"
include "DifficultyManager.galaxy"
include "EconomyEngine.galaxy"
include "BuffEngine.galaxy"
include "ObjectiveDirector.galaxy"
include "BossMechanics.galaxy"
include "BankManager.galaxy"
include "MapGenerator.galaxy"

// This function should be called from the SC2 Editor GUI Trigger "Map Initialization"
void SFE5_MasterInitialization() {
    // 1. Initialize Core Player State
    SFE5_InitCoreFramework();
    
    // 2. Set Difficulty Data Defaults
    SFE5_InitDifficultyData();
    
    // 3. Load Banks for all active players
    int i;
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (g_PlayerIsActive[i]) {
            SFE5_LoadBanks(i);
        }
    }
    
    // 4. Economy and Starting Minerals
    SFE5_DistributeStartingMinerals();
    
    // 5. Initialize AI and Objective Directors
    SFE5_InitObjectiveDirector();
    SFE5_InitBossMechanics();
    
    // 6. Procedural Map Generation (100% Code-Driven)
    SFE5_ConstructBaseTopology();
    SFE5_GenerateMap();
    
    // 7. Pan Camera to Base
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (g_PlayerIsActive[i]) {
            CameraPan(i, Point(30.0, 30.0), 0.0, -1, 10.0, false);
        }
    }
}
