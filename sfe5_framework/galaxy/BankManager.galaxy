// ============================================================================
// BankManager.galaxy
// Handles OrdoAbChao.bank (Signed Stats) and Settings.bank (UI Prefs)
// ============================================================================

bank[MAX_PLAYERS + 1] g_OrdoBank;
bank[MAX_PLAYERS + 1] g_SettingsBank;

int[MAX_PLAYERS + 1] g_PlayerClassicPoints;

// Bank Initialization & Loading
void SFE5_LoadBanks(int player) {
    if (!g_PlayerIsActive[player]) { return; }
    
    // Load Settings Bank (Unsigned)
    g_SettingsBank[player] = BankLoad("Settings", player);
    
    // Load Stats Bank (Signed)
    g_OrdoBank[player] = BankLoad("OrdoAbChao", player);
    
    // Verify Signature to prevent cheating
    if (BankVerify(g_OrdoBank[player])) {
        g_PlayerClassicPoints[player] = BankKeyGetInt(g_OrdoBank[player], "Stats", "ClassicPoints");
    } else {
        // Tampered or missing bank
        g_PlayerClassicPoints[player] = 0;
    }
}

// Bank Saving
void SFE5_SaveBanks(int player) {
    if (g_PlayerIsActive[player]) {
        // Save Settings (No Signature required)
        BankKeySetInt(g_SettingsBank[player], "Settings", "AutoOpenConsole", 1); // Example preference
        BankSave(g_SettingsBank[player]);

        // Save Stats (Requires Signature)
        BankOptionSet(g_OrdoBank[player], c_bankOptionSignature, true);
        BankKeySetInt(g_OrdoBank[player], "Stats", "ClassicPoints", g_PlayerClassicPoints[player]);
        BankSave(g_OrdoBank[player]);
    }
}

// ==========================================
// Rank Calculation (D-1 to S-1000)
// ==========================================
string SFE5_GetRankString(int points) {
    if (points < 0) {
        // SFE5 designates negative points as R-N
        int nVal = (points * -1) / 1000;
        if (nVal < 1) { nVal = 1; }
        return "R-" + IntToString(nVal); 
    }
    
    int currentLevel = 1;
    int pointsRequiredForNext = 10000;
    int remainingPoints = points;
    
    // Calculate level based on escalating cost (+250 per level)
    while (remainingPoints >= pointsRequiredForNext) {
        remainingPoints -= pointsRequiredForNext;
        currentLevel += 1;
        pointsRequiredForNext += 250;
    }
    
    // Map Level to Letter
    string letter = "";
    int sublevel = currentLevel;
    
    if (currentLevel <= 10) { 
        letter = "D"; 
    } else if (currentLevel <= 20) { 
        letter = "C"; 
        sublevel -= 10; 
    } else if (currentLevel <= 30) { 
        letter = "B"; 
        sublevel -= 20; 
    } else if (currentLevel <= 40) { 
        letter = "A"; 
        sublevel -= 30; 
    } else { 
        letter = "S"; 
        sublevel -= 40; // S-Rank scales infinitely beyond 40
    }
    
    return letter + "-" + IntToString(sublevel);
}
