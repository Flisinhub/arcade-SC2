// ==========================================
// Wave Pressure Systems: Drop Pods
// ==========================================
bool SFE5_DropPodLoop(bool testConds, bool runActions) {
    unitgroup outsideUnits = UnitGroupEmpty();
    int i;
    unit targetUnit;
    
    // Find player units outside the base
    for (i = 1; i <= MAX_PLAYERS; i += 1) {
        if (g_PlayerIsActive[i]) {
            unitgroup playerUnits = UnitGroup(null, i, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
            unitgroup unitsInBase = UnitGroup(null, i, g_BaseRegion, UnitFilter(0, 0, 0, 0), 0);
            
            // Subtract units in base
            UnitGroupRemoveUnitGroup(playerUnits, unitsInBase);
            UnitGroupAddUnitGroup(outsideUnits, playerUnits);
        }
    }
    
    if (UnitGroupCount(outsideUnits, c_unitCountAlive) > 0) {
        targetUnit = UnitGroupRandomUnit(outsideUnits, c_unitCountAlive);
        point spawnPoint = UnitGetPosition(targetUnit);
        
        // Create Drop Pod effect and spawn units scaled by g_CurrentPhase
        // SFE5_SpawnDropPod(spawnPoint, g_CurrentPhase);
    }
    
    // Switch to 45s periodic if this was the first 120s delay
    if (TimerGetDuration(g_DropPodTimer) > 50.0) {
        TimerStart(g_DropPodTimer, 45.0, true, c_timeGame);
    }
    
    return true;
}

// ==========================================
// Wave Pressure Systems: Nydus Worms
// ==========================================
bool SFE5_NydusWormLoop(bool testConds, bool runActions) {
    if (g_CurrentPhase < 3) { return true; } // Starts after Protoss Phase 1
    
    int wormsToSpawn = 1 + g_CurrentDifficulty; // e.g., Casual = 1, Normal = 2, Brutal = 4
    int i;
    int randCrater;
    
    for (i = 0; i < wormsToSpawn; i += 1) {
        randCrater = RandomInt(0, MAX_CRATERS - 1);
        // Note: g_NydusCraters needs to be initialized via trigger/map regions
        if (g_NydusCraters[randCrater] != null) {
            point spawnPos = RegionRandomPoint(g_NydusCraters[randCrater]);
            // Spawn Nydus Worm unit based on g_CurrentPhase (Minor -> Ultra)
            // Set duration timer to unburrow/despawn based on difficulty
        }
    }
    
    return true;
}

// ==========================================
// Wave Pressure Systems: Timed Hive Waves
// ==========================================
bool SFE5_TimedWaveLoop(bool testConds, bool runActions) {
    // Alternates between normal packs and bosses
    if (g_TimedWaveCount % 2 == 1) {
        // Odd wave: Boss Wave
        // 1: Infested General, 3: Rageling, 5: Hellbringer, 7: Brood Emperor, 
        // 9: Hybrid Viper, 11: Lenkus, 13: Ferocious Brutes
        // SFE5_SpawnTimedBoss(g_TimedWaveCount);
    } else {
        // Even wave: Standard enemy pack
        // SFE5_SpawnTimedPack(g_TimedWaveCount);
    }
    
    g_TimedWaveCount += 1;
    if (g_TimedWaveCount > 13) {
        // Reduce interval to 1/3 after wave 13
        TimerStart(g_TimedWaveTimer, 100.0, true, c_timeGame);
    }
    
    return true;
}

// ==========================================
// Initialization
// ==========================================
void SFE5_InitObjectiveDirector() {
    g_DropPodTimer = TimerCreate();
    g_NydusTimer = TimerCreate();
    g_TimedWaveTimer = TimerCreate();
    
    TriggerAddEventTimer(TriggerCreate("SFE5_DropPodLoop"), g_DropPodTimer);
    TriggerAddEventTimer(TriggerCreate("SFE5_NydusWormLoop"), g_NydusTimer);
    TriggerAddEventTimer(TriggerCreate("SFE5_TimedWaveLoop"), g_TimedWaveTimer);
    
    // Initial delays
    TimerStart(g_DropPodTimer, 120.0, false, c_timeGame); 
    
    // Nydus interval: 180s / enemy-upgrade factor. Assuming base is ~180s for normal.
    TimerStart(g_NydusTimer, 180.0, true, c_timeGame);
    
    // Timed wave interval: 300s
    TimerStart(g_TimedWaveTimer, 300.0, true, c_timeGame);
}
