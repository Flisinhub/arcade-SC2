const int TOTAL_SPAWN_PHASES = 12;
const int MAX_CRATERS = 12;

int g_CurrentPhase = 1;
timer g_DropPodTimer;
timer g_NydusTimer;
timer g_TimedWaveTimer;
int g_TimedWaveCount = 1;

region[MAX_CRATERS] g_NydusCraters;
region g_BaseRegion;

